# ==============================================================================
#            NEXUS TEST: COMPOUND ASSIGNMENT OPERATORS
# ==============================================================================

# 1. Integer compound assignment (with and without let)
let a = 10
let a += 5
print a          # expected: 15
a += 5
print a          # expected: 20

let b = 100
let b -= 25
print b          # expected: 75
b -= 15
print b          # expected: 60

let c = 7
let c *= 6
print c          # expected: 42
c *= 2
print c          # expected: 84

let d = 100
let d /= 4
print d          # expected: 25
d /= 5
print d          # expected: 5

let e = 47
let e %= 10
print e          # expected: 7
e %= 4
print e          # expected: 3

# 2. Floating-point compound assignment
let f = 10.0
let f +=. 5.5
print_float f    # expected: 15.500000
f -=. 3.0
print_float f    # expected: 12.500000
f *=. 2.0
print_float f    # expected: 25.000000
f /=. 5.0
print_float f    # expected: 5.000000

# 3. For loop with compound update
let sum_for = 0
for i = 1, i <= 4, i += 1 {
    sum_for += i
}
print sum_for    # expected: 10 (1+2+3+4)

let countdown = 10
for k = 10, k > 0, k -= 2 {
    countdown -= 1
}
print countdown  # expected: 5

# 4. Struct member compound assignment
struct Vec2 {
    x
    y
}
let v = alloc Vec2.size
v.x = 10
v.y = 20
v.x += 32
v.y -= 5
let vx = v.x
let vy = v.y
print vx         # expected: 42
print vy         # expected: 15

print "=== ALL COMPOUND OPERATOR TESTS PASSED ==="
