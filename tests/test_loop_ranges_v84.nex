# --- FEATURE #37: COMPILE-TIME CONSTANTS ---
const MAX_LIMIT = 100
const BASE_OFFSET = 25
const SCALE_FACTOR = 4 * 10
const HEX_CONST = 0xFF
const OCT_CONST = 0o755
const STR_CONST = "CONST_OK"

print "=== 1. Testing Feature #37: Compile-Time Constants ==="

let val_a = MAX_LIMIT
print val_a
if val_a == 100 {
    print "PASS: MAX_LIMIT constant equality"
}

let val_b = BASE_OFFSET + 15
print val_b
if val_b == 40 {
    print "PASS: BASE_OFFSET in arithmetic"
}

let val_c = SCALE_FACTOR
print val_c
if val_c == 40 {
    print "PASS: SCALE_FACTOR folded constant"
}

let val_hex = HEX_CONST
print val_hex
if val_hex == 255 {
    print "PASS: HEX_CONST hex literal constant"
}

let val_oct = OCT_CONST
print val_oct
if val_oct == 493 {
    print "PASS: OCT_CONST octal literal constant"
}

let s_val = STR_CONST
print_str s_val
print "PASS: STR_CONST string literal constant"

# --- FEATURE #50: RANGE EXPRESSIONS IN FOR LOOPS ---
print "=== 2. Testing Feature #50: Range Expressions in Loops ==="

# 2.1 Exclusive range 0..5 (0, 1, 2, 3, 4 -> sum = 10)
let sum1 = 0
for i in 0..5 {
    sum1 = sum1 + i
}
print sum1
if sum1 == 10 {
    print "PASS: Exclusive range 0..5"
}

# 2.2 Inclusive range 0..=5 (0, 1, 2, 3, 4, 5 -> sum = 15)
let sum2 = 0
for i in 0..=5 {
    sum2 = sum2 + i
}
print sum2
if sum2 == 15 {
    print "PASS: Inclusive range 0..=5"
}

# 2.3 Non-zero start 5..10 (5, 6, 7, 8, 9 -> sum = 35)
let sum3 = 0
for i in 5..10 {
    sum3 = sum3 + i
}
print sum3
if sum3 == 35 {
    print "PASS: Range with non-zero start 5..10"
}

# 2.4 Range with positive step (0, 2, 4, 6, 8 -> sum = 20)
let sum_step = 0
for i in 0..10 step 2 {
    sum_step = sum_step + i
}
print sum_step
if sum_step == 20 {
    print "PASS: Range with step 2 (0..10 step 2)"
}

# 2.5 Range with negative step (10, 8, 6, 4, 2 -> sum = 30)
let sum_down = 0
for i in 10..0 step -2 {
    sum_down = sum_down + i
}
print sum_down
if sum_down == 30 {
    print "PASS: Range with countdown step -2 (10..0 step -2)"
}

# 2.6 Range using constant bound (0..SCALE_FACTOR step 10 -> 0, 10, 20, 30 -> sum = 60)
let sum_const_bound = 0
for i in 0..SCALE_FACTOR step 10 {
    sum_const_bound = sum_const_bound + i
}
print sum_const_bound
if sum_const_bound == 60 {
    print "PASS: Range with constant bound (0..SCALE_FACTOR step 10)"
}

# 2.7 Scoped function with range loop
fn calc_range_sum(n: int) -> int {
    let total = 0
    for k in 1..=n {
        total = total + k
    }
    return total
}

let sum_fn = calc_range_sum(10)
print sum_fn
if sum_fn == 55 {
    print "PASS: Scoped function with inclusive range loop"
}

# --- FEATURE #59: NULL COALESCING OPERATOR (??) ---
print "=== 3. Testing Feature #59: Null Coalescing Operator ==="

let opt_zero = 0
let opt_some = 42

# 3.1 Fallback when LHS is zero
let res_fallback = opt_zero ?? 99
print res_fallback
if res_fallback == 99 {
    print "PASS: Null coalescing fallback to RHS when LHS is 0"
}

# 3.2 Value when LHS is non-zero
let res_value = opt_some ?? 99
print res_value
if res_value == 42 {
    print "PASS: Null coalescing returns LHS when non-zero"
}

# 3.3 Chained null coalescing: 0 ?? 0 ?? 77
let res_chained = 0 ?? 0 ?? 77
print res_chained
if res_chained == 77 {
    print "PASS: Chained null coalescing (0 ?? 0 ?? 77)"
}

# 3.4 Chained null coalescing with first non-zero: 15 ?? 0 ?? 99
let res_chained2 = 15 ?? 0 ?? 99
print res_chained2
if res_chained2 == 15 {
    print "PASS: Chained null coalescing with early non-zero (15 ?? 0 ?? 99)"
}

# 3.5 Null coalescing with constant: opt_zero ?? MAX_LIMIT
let res_with_const = opt_zero ?? MAX_LIMIT
print res_with_const
if res_with_const == 100 {
    print "PASS: Null coalescing with constant fallback (opt_zero ?? MAX_LIMIT)"
}

# 3.6 Function return with null coalescing
fn get_setting(cfg_val: int, default_val: int) -> int {
    return cfg_val ?? default_val
}

let set_a = get_setting(0, 500)
let set_b = get_setting(123, 500)
print set_a
print set_b
if set_a == 500 {
    if set_b == 123 {
        print "PASS: Function return with null coalescing"
    }
}

# 3.7 Short-circuit evaluation test
let effect_flag = 0
fn trigger_side_effect -> int {
    let effect_flag = 1
    return 999
}

let active_val = 50
let short_circuit_res = active_val ?? trigger_side_effect()
print short_circuit_res
print effect_flag
if short_circuit_res == 50 {
    if effect_flag == 0 {
        print "PASS: Null coalescing short-circuits RHS evaluation"
    }
}

print "=== ALL MODERN LOOP & RANGE TESTS PASSED SUCCESSFULLY! ==="
