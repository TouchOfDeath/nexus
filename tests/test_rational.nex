# ==============================================================================
#                  NEXUS TEST: EXACT RATIONAL ARITHMETIC
# ==============================================================================

include "stdlib/nstdlib.nex"
include "stdlib/rational.nex"

print "=== Testing Rational (Fraction) Arithmetic ==="

let rOut = alloc 16

# 1. 1/3 + 1/6 = 3/6 = 1/2
let nx_i0 = 1
let nx_i1 = 3
let nx_i2 = 1
let nx_i3 = 6
let nx_i4 = rOut
call nx_rat_add

let n_add = rOut[0]
let d_add = rOut[1]
assert_eq n_add, 1
assert_eq d_add, 2

# 2. 3/4 - 1/2 = 1/4
let nx_i0 = 3
let nx_i1 = 4
let nx_i2 = 1
let nx_i3 = 2
let nx_i4 = rOut
call nx_rat_sub

let n_sub = rOut[0]
let d_sub = rOut[1]
assert_eq n_sub, 1
assert_eq d_sub, 4

# 3. 2/3 * 3/4 = 6/12 = 1/2
let nx_i0 = 2
let nx_i1 = 3
let nx_i2 = 3
let nx_i3 = 4
let nx_i4 = rOut
call nx_rat_mul

let n_mul = rOut[0]
let d_mul = rOut[1]
assert_eq n_mul, 1
assert_eq d_mul, 2

# 4. 1/2 / 3/4 = 4/6 = 2/3
let nx_i0 = 1
let nx_i1 = 2
let nx_i2 = 3
let nx_i3 = 4
let nx_i4 = rOut
call nx_rat_div

let n_div = rOut[0]
let d_div = rOut[1]
assert_eq n_div, 2
assert_eq d_div, 3

# 5. Comparisons
# 1/3 vs 1/2 -> -1
let nx_i0 = 1
let nx_i1 = 3
let nx_i2 = 1
let nx_i3 = 2
call nx_rat_cmp
assert_eq nx_r0, -1

# 2/4 vs 1/2 -> 0
let nx_i0 = 2
let nx_i1 = 4
let nx_i2 = 1
let nx_i3 = 2
call nx_rat_cmp
assert_eq nx_r0, 0

# 3/4 vs 1/2 -> 1
let nx_i0 = 3
let nx_i1 = 4
let nx_i2 = 1
let nx_i3 = 2
call nx_rat_cmp
assert_eq nx_r0, 1

print "[SUCCESS] Rational Arithmetic Tests Passed!"
call nx_assert_summary
