# ==============================================================================
#   NEXUS TEST: Piece Table Text Buffer (Feature #67)
include "stdlib/piece_table.nex"
let nx_assert_passes = 0
let nx_assert_fails = 0

# --- 1. Empty Piece Table ---
let nx_i0 = 0
let nx_i1 = 0
call nx_pt_new
let pt0 = nx_r0

let nx_i0 = pt0
call nx_pt_len
assert_eq nx_r0, 0

let nx_i0 = pt0
call nx_pt_piece_count
assert_eq nx_r0, 0

let exp_buf = alloc 1024
let nx_i0 = pt0
let nx_i1 = exp_buf
let nx_i2 = 1024
call nx_pt_export_to_buf
assert_eq nx_r0, 0
let c0 = load [exp_buf + 0]
assert_eq c0, 0

# --- 2. Initialize with Non-Empty String ---
let init_str = "Hello, World!"
let nx_i0 = init_str
let nx_i1 = 13
call nx_pt_new
let pt = nx_r0

let nx_i0 = pt
call nx_pt_len
assert_eq nx_r0, 13

let nx_i0 = pt
call nx_pt_piece_count
assert_eq nx_r0, 1

let nx_i0 = pt
let nx_i1 = exp_buf
let nx_i2 = 1024
call nx_pt_export_to_buf
assert_eq nx_r0, 13

let ch_h = load [exp_buf + 0]
assert_eq ch_h, 72
let ch_w = load [exp_buf + 7]
assert_eq ch_w, 87
let ch_ex = load [exp_buf + 12]
assert_eq ch_ex, 33

# --- 3. Append to End ---
let append_str = " Welcome"
let nx_i0 = pt
let nx_i1 = 13
let nx_i2 = append_str
let nx_i3 = 8
call nx_pt_insert
assert_eq nx_r0, 21

let nx_i0 = pt
call nx_pt_len
assert_eq nx_r0, 21

let nx_i0 = pt
call nx_pt_piece_count
assert_eq nx_r0, 2

let nx_i0 = pt
let nx_i1 = exp_buf
let nx_i2 = 1024
call nx_pt_export_to_buf
assert_eq nx_r0, 21

# Verify string ends with "Welcome"
let ch_sp = load [exp_buf + 13]
assert_eq ch_sp, 32
let ch_vw = load [exp_buf + 14]
assert_eq ch_vw, 87
let ch_e = load [exp_buf + 20]
assert_eq ch_e, 101

# --- 4. Coalescing Consecutive Character Typing at End ---
# Typing '!' (33) then '?' (63)
let nx_i0 = pt
let nx_i1 = 21
let nx_i2 = 33
call nx_pt_insert_char
assert_eq nx_r0, 22

let nx_i0 = pt
let nx_i1 = 22
let nx_i2 = 63
call nx_pt_insert_char
assert_eq nx_r0, 23

# Because these are contiguous appends into add_buf, piece_count should NOT increase!
let nx_i0 = pt
call nx_pt_piece_count
assert_eq nx_r0, 2

let nx_i0 = pt
let nx_i1 = exp_buf
let nx_i2 = 1024
call nx_pt_export_to_buf
assert_eq nx_r0, 23
let ch_last1 = load [exp_buf + 21]
assert_eq ch_last1, 33
let ch_last2 = load [exp_buf + 22]
assert_eq ch_last2, 63

# --- 5. Insert at Beginning (pos 0) ---
let pfx = ">> "
let nx_i0 = pt
let nx_i1 = 0
let nx_i2 = pfx
let nx_i3 = 3
call nx_pt_insert
assert_eq nx_r0, 26

let nx_i0 = pt
call nx_pt_piece_count
assert_eq nx_r0, 3

let nx_i0 = pt
let nx_i1 = exp_buf
let nx_i2 = 1024
call nx_pt_export_to_buf
assert_eq nx_r0, 26
let c_p0 = load [exp_buf + 0]
assert_eq c_p0, 62
let c_p1 = load [exp_buf + 1]
assert_eq c_p1, 62
let c_p2 = load [exp_buf + 2]
assert_eq c_p2, 32
let c_p3 = load [exp_buf + 3]
assert_eq c_p3, 72

# --- 6. Character Indexing (nx_pt_get_char) ---
let nx_i0 = pt
let nx_i1 = 0
call nx_pt_get_char
assert_eq nx_r0, 62

let nx_i0 = pt
let nx_i1 = 3
call nx_pt_get_char
assert_eq nx_r0, 72

let nx_i0 = pt
let nx_i1 = 25
call nx_pt_get_char
assert_eq nx_r0, 63

# Out-of-bounds check returns -1
let nx_i0 = pt
let nx_i1 = 100
call nx_pt_get_char
let neg_one = 0 - 1
assert_eq nx_r0, neg_one

# --- 7. Insert in Middle (Splitting a Piece) ---
# Current text starts with ">> Hello, World!..."
# We will insert "Super " between "Hello, " and "World!"
# ">> Hello, " is 10 chars (indexes 0..9). Index 10 is 'W'.
let mid_str = "Super "
let nx_i0 = pt
let nx_i1 = 10
let nx_i2 = mid_str
let nx_i3 = 6
call nx_pt_insert
assert_eq nx_r0, 32

let nx_i0 = pt
let nx_i1 = exp_buf
let nx_i2 = 1024
call nx_pt_export_to_buf
assert_eq nx_r0, 32

# Verify "Super " is at index 10
let c_s = load [exp_buf + 10]
assert_eq c_s, 83
let c_u = load [exp_buf + 11]
assert_eq c_u, 117
# Verify "World!" follows at index 16
let c_w2 = load [exp_buf + 16]
assert_eq c_w2, 87

# --- 8. Export Slice ---
let slice_buf = alloc 64
let nx_i0 = pt
let nx_i1 = 10
let nx_i2 = 5
let nx_i3 = slice_buf
call nx_pt_export_slice
assert_eq nx_r0, 5
# slice should be "Super"
let c_sl0 = load [slice_buf + 0]
assert_eq c_sl0, 83
let c_sl4 = load [slice_buf + 4]
assert_eq c_sl4, 114
let c_sl5 = load [slice_buf + 5]
assert_eq c_sl5, 0

# --- 9. Single Character Delete (Backspace at end) ---
# Delete '?' at pos 31
let nx_i0 = pt
let nx_i1 = 31
call nx_pt_delete_char
assert_eq nx_r0, 31

let nx_i0 = pt
let nx_i1 = 30
call nx_pt_get_char
assert_eq nx_r0, 33

# --- 10. Delete Range in Middle ---
# Remove "Super " (6 chars starting at pos 10)
let nx_i0 = pt
let nx_i1 = 10
let nx_i2 = 6
call nx_pt_delete
assert_eq nx_r0, 25

let nx_i0 = pt
let nx_i1 = exp_buf
let nx_i2 = 1024
call nx_pt_export_to_buf
assert_eq nx_r0, 25
# Now index 10 should be 'W' again!
let c_after_del = load [exp_buf + 10]
assert_eq c_after_del, 87

# --- 11. Multi-Line Navigation & Line Offsets ---
let ml_pt_init = "Alpha\nBeta\nGamma\nDelta"
let nx_i0 = ml_pt_init
let nx_i1 = 22
call nx_pt_new
let ml_pt = nx_r0

let nx_i0 = ml_pt
call nx_pt_line_count
assert_eq nx_r0, 4

let nx_i0 = ml_pt
let nx_i1 = 1
call nx_pt_line_to_offset
assert_eq nx_r0, 0

let nx_i0 = ml_pt
let nx_i1 = 2
call nx_pt_line_to_offset
assert_eq nx_r0, 6

let nx_i0 = ml_pt
let nx_i1 = 3
call nx_pt_line_to_offset
assert_eq nx_r0, 11

let nx_i0 = ml_pt
let nx_i1 = 4
call nx_pt_line_to_offset
assert_eq nx_r0, 17

# --- 12. Snapshot & Undo / Redo ---
# Take snapshot of ml_pt
let nx_i0 = ml_pt
call nx_pt_snapshot
let snap1 = nx_r0

# Make drastic destructive edit: insert line in between and delete delta
let ins_line = "NEW_LINE\n"
let nx_i0 = ml_pt
let nx_i1 = 6
let nx_i2 = ins_line
let nx_i3 = 9
call nx_pt_insert

let nx_i0 = ml_pt
call nx_pt_line_count
assert_eq nx_r0, 5

# Now restore snapshot!
let nx_i0 = ml_pt
let nx_i1 = snap1
call nx_pt_restore
assert_eq nx_r0, 1

let nx_i0 = ml_pt
call nx_pt_len
assert_eq nx_r0, 22

let nx_i0 = ml_pt
call nx_pt_line_count
assert_eq nx_r0, 4

let nx_i0 = ml_pt
let nx_i1 = exp_buf
let nx_i2 = 1024
call nx_pt_export_to_buf
assert_eq nx_r0, 22

# Verify exact contents restored
let c_r0 = load [exp_buf + 0]
assert_eq c_r0, 65
let c_r6 = load [exp_buf + 6]
assert_eq c_r6, 66

print "PIECE_TABLE_TEST_PASS"
