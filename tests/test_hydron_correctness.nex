include "stdlib/nstdlib.nex"

; ==============================================================================
;   NEXUS HYDRON Engine Correctness & Boundary Verification Suite
;   Tests mathematical attractor convergence, guards, limits, and fallback paths.
; ==============================================================================

print "--- TEST: HYDRON Recurrence Boundary (lim < 64) ---"
let i1 = 0
let acc1 = 12345
while i1 < 50 {
    let acc1 = acc1 + i1
    let acc1 = acc1 * 2
    let acc1 = acc1 / 4
    let i1 = i1 + 1
}
; Expected: unoptimized loop at 50 iterations gives 48
print acc1
assert_eq acc1, 48

print "--- TEST: HYDRON Recurrence Exact Boundary (lim == 64) ---"
let i2 = 0
let acc2 = 12345
while i2 < 64 {
    let acc2 = acc2 + i2
    let acc2 = acc2 * 2
    let acc2 = acc2 / 4
    let i2 = i2 + 1
}
; Expected: 64 - 2 = 62
print acc2
assert_eq acc2, 62

print "--- TEST: HYDRON Recurrence (lim == 1000) ---"
let i3 = 0
let acc3 = 500
while i3 < 1000 {
    let acc3 = acc3 + i3
    let acc3 = acc3 * 2
    let acc3 = acc3 / 4
    let i3 = i3 + 1
}
; Expected: 1000 - 2 = 998
print acc3
assert_eq acc3, 998

print "--- TEST: HYDRON Induction Loop with Remainder (lim == 300) ---"
let j1 = 0
let sum1 = 0
while j1 < 300 {
    let sum1 = sum1 + 1
    let j1 = j1 + 1
}
print sum1
assert_eq sum1, 300

print "--- TEST: HYDRON Induction Loop Sub-128 (lim == 77) ---"
let j2 = 0
let sum2 = 0
while j2 < 77 {
    let sum2 = sum2 + 1
    let j2 = j2 + 1
}
print sum2
assert_eq sum2, 77

print "--- TEST: HYDRON Invariant Peeling (lim == 250, thr == 100) ---"
let k1 = 0
let hits1 = 0
while k1 < 250 {
    if k1 > 100 {
        let hits1 = hits1 + 2
    }
    let k1 = k1 + 1
}
; For k in 101..249: exactly 149 iterations * 2 = 298
print hits1
assert_eq hits1, 298

print "--- TEST: HYDRON Invariant Peeling Untriggered (lim == 50, thr == 100) ---"
let k2 = 0
let hits2 = 0
while k2 < 50 {
    if k2 > 100 {
        let hits2 = hits2 + 2
    }
    let k2 = k2 + 1
}
; Never exceeds 100, hits2 remains 0
print hits2
assert_eq hits2, 0

print "--- TEST: HYDRON Local-Scoped Loop Variables (scoping bug regression) ---"
local li = 0
local ls = 0
while li < 10000 {
    let ls = ls + 3
    let li = li + 1
}
print ls
assert_eq ls, 30000

print "--- TEST: HYDRON Variable-Threshold Invariant Peeling ---"
let vk = 0
let vh = 0
let vthr = 250
while vk < 1000 {
    if vk > vthr {
        let vh = vh + 4
    }
    let vk = vk + 1
}
; vk in 251..999 => 749 iterations * 4
print vh
assert_eq vh, 2996

print "--- TEST: HYDRON Multi-Accumulator Induction Scaling ---"
let ma = 0
let m1 = 0
let m2 = 0
while ma < 900 {
    let m1 = m1 + 5
    let m2 = m2 - 3
    let ma = ma + 1
}
print m1
assert_eq m1, 4500
print m2
assert_eq m2, 0 - 2700

print "--- TEST: HYDRON Variable-Limit Induction Scaling ---"
let vl = 0
let vs = 0
let vlim = 777
while vl < vlim {
    let vs = vs + 6
    let vl = vl + 1
}
print vs
assert_eq vs, 4662

print "--- TEST: HYDRON Fused Recurrence Attractor Shape ---"
let vi = 0
let vacc = 12345
while vi < 2000 {
    let vacc = vacc + vi * 2 / 4
    let vi = vi + 1
}
print vacc
assert_eq vacc, 1998

print "--- TEST: HYDRON >= Threshold Invariant Peeling ---"
let gk = 0
let gh = 0
while gk < 5000 {
    if gk >= 100 {
        let gh = gh + 3
    }
    let gk = gk + 1
}
print gh
assert_eq gh, 14700

print "=== ALL HYDRON CORRECTNESS TESTS PASSED ==="

call nx_assert_summary
