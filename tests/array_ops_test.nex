# ==============================================================================
#   NEXUS Array Ops Test: byte + qword array functions (incl. sort)
# ==============================================================================
include "stdlib/nstdlib.nex"

# --- byte array: sort [5,1,4,2,3] -> [1,2,3,4,5], avg = 3 ---
let buf = alloc 5
store [buf + 0] 5
store [buf + 1] 1
store [buf + 2] 4
store [buf + 3] 2
store [buf + 4] 3
let nx_i0 = buf
let nx_i1 = 5
call nx_arr_sort
let nx_i0 = load [buf + 0]
assert_eq nx_i0, 1
let nx_i0 = load [buf + 4]
assert_eq nx_i0, 5
let nx_i0 = buf
let nx_i1 = 5
call nx_arr_avg
assert_eq nx_r0, 3

# --- qword array: fill + sort negatives and positives ---
let q = alloc 48
let nx_i0 = q
let nx_i1 = 6
let nx_i2 = 0 - 1
call nx_qarr_fill
store64 [q + 0 * 8] 30
let neg7 = 0 - 7
store64 [q + 1 * 8] neg7
store64 [q + 2 * 8] 12
let neg100 = 0 - 100
store64 [q + 3 * 8] neg100
store64 [q + 4 * 8] 4
store64 [q + 5 * 8] 0
let nx_i0 = q
let nx_i1 = 6
call nx_qarr_sort
let nx_i0 = load64 [q + 0 * 8]
assert_eq nx_i0, 0 - 100
let nx_i0 = load64 [q + 5 * 8]
assert_eq nx_i0, 30
let nx_i0 = q
let nx_i1 = 6
call nx_qarr_sum
assert_eq nx_r0, 0 - 61
let nx_i0 = q
let nx_i1 = 6
call nx_qarr_min
assert_eq nx_r0, 0 - 100
let nx_i0 = q
let nx_i1 = 6
call nx_qarr_max
assert_eq nx_r0, 30
let nx_i0 = q
let nx_i1 = 6
let nx_i2 = 12
call nx_qarr_index_of
assert_eq nx_r0, 4
let nx_i0 = q
let nx_i1 = 6
let nx_i2 = 999
call nx_qarr_index_of
assert_eq nx_r0, 0 - 1
let nx_i0 = q
let nx_i1 = 6
call nx_qarr_reverse
let nx_i0 = load64 [q + 0 * 8]
assert_eq nx_i0, 30
let nx_i0 = q
let nx_i1 = 6
let nx_i2 = 0 - 100
call nx_qarr_count
assert_eq nx_r0, 1
let nx_i0 = q
let nx_i1 = 6
call nx_qarr_avg
assert_eq nx_r0, 0 - 10
call nx_assert_summary
