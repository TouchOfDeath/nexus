# ==============================================================================
#   NEXUS TEST: String Escape Sequences (Phase 1)
#   Tests: \n, \t, \r, \\, \", \0, \e, \xHH in literals, len, load, print
# ==============================================================================
include "stdlib/nstdlib.nex"

# 1. Newline escape: \n (ASCII 10)
let s_nl = "hello\nworld"
let c_nl = load [s_nl + 5]
assert_eq c_nl, 10
let c_w = load [s_nl + 6]
assert_eq c_w, 119
let l_nl = len "hello\nworld"
assert_eq l_nl, 11

# 2. Tab escape: \t (ASCII 9)
let s_tab = "col1\tcol2"
let c_tab = load [s_tab + 4]
assert_eq c_tab, 9
let l_tab = len "col1\tcol2"
assert_eq l_tab, 9

# 3. Carriage return escape: \r (ASCII 13)
let s_cr = "line1\rline2"
let c_cr = load [s_cr + 5]
assert_eq c_cr, 13
let l_cr = len "line1\rline2"
assert_eq l_cr, 11

# 4. Double quote escape: \" (ASCII 34)
let s_q = "say:\"yes\""
let c_q1 = load [s_q + 4]
assert_eq c_q1, 34
let c_q2 = load [s_q + 8]
assert_eq c_q2, 34
let l_q = len "say:\"yes\""
assert_eq l_q, 9

# 5. Backslash escape: \\ (ASCII 92)
let s_bs = "path\\to\\file"
let c_bs1 = load [s_bs + 4]
assert_eq c_bs1, 92
let c_bs2 = load [s_bs + 7]
assert_eq c_bs2, 92
let l_bs = len "path\\to\\file"
assert_eq l_bs, 12

# 6. Escape character: \e (ASCII 27)
let s_esc = "ansi\e[31m"
let c_esc = load [s_esc + 4]
assert_eq c_esc, 27
let l_esc = len "ansi\e[31m"
assert_eq l_esc, 9

# 7. Null character escape: \0 (ASCII 0)
let s_null = "abc\0def"
let c_null = load [s_null + 3]
assert_eq c_null, 0
let c_after_null = load [s_null + 4]
assert_eq c_after_null, 100

# 8. Hexadecimal escapes: \xHH
let s_hex = "hex:\x41\x42\x43"
let c_h1 = load [s_hex + 4]
assert_eq c_h1, 65
let c_h2 = load [s_hex + 5]
assert_eq c_h2, 66
let c_h3 = load [s_hex + 6]
assert_eq c_h3, 67
let l_hex = len "hex:\x41\x42\x43"
assert_eq l_hex, 7

# 9. Low and high hex escapes
let s_hex2 = "\x00\x0a\x0d\x1b\x20\x22\x5c\x7f"
let ch0 = load [s_hex2 + 0]
assert_eq ch0, 0
let ch1 = load [s_hex2 + 1]
assert_eq ch1, 10
let ch2 = load [s_hex2 + 2]
assert_eq ch2, 13
let ch3 = load [s_hex2 + 3]
assert_eq ch3, 27
let ch4 = load [s_hex2 + 4]
assert_eq ch4, 32
let ch5 = load [s_hex2 + 5]
assert_eq ch5, 34
let ch6 = load [s_hex2 + 6]
assert_eq ch6, 92
let ch7 = load [s_hex2 + 7]
assert_eq ch7, 127
let l_hex2 = len "\x00\x0a\x0d\x1b\x20\x22\x5c\x7f"
assert_eq l_hex2, 8

# 10. String literal in print
print "STRING_ESCAPES_TEST_PASS"
