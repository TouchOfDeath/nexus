let nx_i0 = 2
let nx_i1 = 0 - 1
call nx_pow
let nx_i0 = nx_r0
let nx_i1 = 0
call check_eq
let nx_i0 = 0 - 3
let nx_i1 = 3
call nx_pow
let nx_i0 = nx_r0
let nx_i1 = 0 - 27
call check_eq

