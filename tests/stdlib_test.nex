# ------------------------------ array setup ----------------------------------
let buf_a = alloc 80
let buf_b = alloc 80
let buf_c = alloc 32

# ------------------------------ nx_arr_fill / nx_arr_sum ---------------------
print "[arrays] nx_arr_fill + nx_arr_sum"
let nx_i0 = buf_a
let nx_i1 = 5
let nx_i2 = 7
call nx_arr_fill
let nx_i0 = buf_a
let nx_i1 = 5
call nx_arr_sum
let nx_i0 = nx_r0
let nx_i1 = 35
call check_eq

# ------------------------------ nx_arr_iota ----------------------------------
print "[arrays] nx_arr_iota"
let nx_i0 = buf_b
let nx_i1 = 6
call nx_arr_iota
let s = load [buf_b + 0]
let nx_i0 = s
let nx_i1 = 0
call check_eq
let s = load [buf_b + 5]
let nx_i0 = s
let nx_i1 = 5
call check_eq
let nx_i0 = buf_b
let nx_i1 = 6
call nx_arr_sum
let nx_i0 = nx_r0
let nx_i1 = 15
call check_eq

