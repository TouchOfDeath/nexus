# ------------------------------ string setup ---------------------------------
let s_hello = "hello"
let s_empty = ""
let s_abc = "abc"
let s_abd = "abd"
let s_foo = "foo"
let s_bar = "bar"
let s_num = "1234"
let s_neg = "-56"
let s_zero = "007"
let s_zero1 = "0"
let buf_s = alloc 64

# ------------------------------ nx_str_len -----------------------------------
print "[strings] nx_str_len"
let nx_i0 = s_hello
call nx_str_len
let nx_i0 = nx_r0
let nx_i1 = 5
call check_eq
let nx_i0 = s_empty
call nx_str_len
let nx_i0 = nx_r0
let nx_i1 = 0
call check_eq

# ------------------------------ nx_str_copy ----------------------------------
print "[strings] nx_str_copy"
let nx_i0 = s_hello
let nx_i1 = buf_s
call nx_str_copy
print_str buf_s
let nx_i0 = buf_s
let nx_i1 = s_hello
call nx_str_cmp
let nx_i0 = nx_r0
let nx_i1 = 0
call check_eq

