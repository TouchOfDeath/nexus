# ------------------------------ summary --------------------------------------
print "=============================================="
print "  ASSERTIONS PASSED:"
print passes
print "  ASSERTIONS FAILED:"
print fails
if fails == 0 {
    print "  [SUCCESS] ALL STDLIB TESTS PASSED!"
} else {
    print "  [FAILURE] SOME STDLIB TESTS FAILED!"
}
print "=============================================="
