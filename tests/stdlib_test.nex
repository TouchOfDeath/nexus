# ==============================================================================
#              NEXUS STANDARD LIBRARY - COMPREHENSIVE TEST SUITE
#       Exercises every stdlib function and asserts exact expected results.
#                 Run with:  ./nexus run tests/stdlib_test.nex
# ==============================================================================

include "stdlib/nstdlib.nex"

print "=============================================="
print "  NEXUS STDLIB TEST SUITE"
print "=============================================="

let passes = 0
let fails = 0

# check_eq: compares nx_i0 (actual) against nx_i1 (expected).
# Touches only nx_i0/nx_i1, so nx_r0 from the function under test survives.
fn check_eq {
    if nx_i0 == nx_i1 {
        let passes = passes + 1
    } else {
        let fails = fails + 1
        print "  FAIL got:"
        print nx_i0
        print "  FAIL expected:"
        print nx_i1
    }
}

# ------------------------------ nx_max ---------------------------------------
print "[math] nx_max"
let nx_i0 = 17
let nx_i1 = 42
call nx_max
let nx_i0 = nx_r0
let nx_i1 = 42
call check_eq
let nx_i0 = 0 - 5
let nx_i1 = 0 - 9
call nx_max
let nx_i0 = nx_r0
let nx_i1 = 0 - 5
call check_eq

# ------------------------------ nx_min ---------------------------------------
print "[math] nx_min"
let nx_i0 = 17
let nx_i1 = 42
call nx_min
let nx_i0 = nx_r0
let nx_i1 = 17
call check_eq
let nx_i0 = 0 - 5
let nx_i1 = 0 - 9
call nx_min
let nx_i0 = nx_r0
let nx_i1 = 0 - 9
call check_eq

# ------------------------------ nx_clamp -------------------------------------
print "[math] nx_clamp"
let nx_i0 = 15
let nx_i1 = 0
let nx_i2 = 10
call nx_clamp
