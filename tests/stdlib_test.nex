let nx_i1 = 0
call check_eq
let nx_i0 = 5
let nx_i1 = 0
let nx_i2 = 10
call nx_clamp
let nx_i0 = nx_r0
let nx_i1 = 5
call check_eq

# ------------------------------ nx_sign --------------------------------------
