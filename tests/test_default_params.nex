# ==============================================================================
#           NEXUS TEST: DEFAULT PARAMETER VALUES (FEATURE #5)
# ==============================================================================
include "stdlib/nstdlib.nex"

# 1. Single default parameter
fn add_default(a, b = 10) {
    return a + b
}

# 2. Multiple default parameters
fn greet(times = 1, greeting = 100) {
    return times + greeting
}

# 3. All default parameters (zero-argument call)
fn get_val(base = 100, bonus = 42) {
    return base + bonus
}

# 4. Default parameters with named argument overrides
fn make_box(width = 10, height = 20, depth = 30) {
    let w_part = width * 10000
    let h_part = height * 100
    let vol = w_part + h_part + depth
    return vol
}

# 5. Typed default parameters
fn calc(x: int = 5, y: int = 7) {
    return x * y
}

# 6. Multi-return with default parameter
fn divmod_def(a, b = 2) {
    return a / b, a % b
}

# --- TESTS ---

# Test 1: Single default parameter
let t1 = add_default(5)
assert_eq t1, 15

let t2 = add_default(5, 20)
assert_eq t2, 25

# Test 2: Multiple defaults
let g1 = greet()
assert_eq g1, 101

let g2 = greet(5)
assert_eq g2, 105

let g3 = greet(5, 200)
assert_eq g3, 205

# Test 3: Zero-arg call with defaults
let v1 = get_val()
assert_eq v1, 142

let v2 = get_val(200)
assert_eq v2, 242

let v3 = get_val(200, 50)
assert_eq v3, 250

# Test 4: Default parameters with named argument overrides
let b1 = make_box()
assert_eq b1, 102030

let b2 = make_box(height = 55)
assert_eq b2, 105530

let b3 = make_box(depth = 99, width = 4)
assert_eq b3, 42099

# Test 5: Typed default parameters
let c1 = calc()
assert_eq c1, 35

let c2 = calc(10)
assert_eq c2, 70

let c3 = calc(10, 10)
assert_eq c3, 100

# Test 6: Embedded expressions with default parameter calls
let combo = add_default(7) + calc()
assert_eq combo, 52

# Test 7: Multi-return with default parameter
let q, r = divmod_def(9)
assert_eq q, 4
assert_eq r, 1

let q2, r2 = divmod_def(19, 5)
assert_eq q2, 3
assert_eq r2, 4

print "[+] Default Parameter Values: ALL ASSERTIONS PASSED!"
