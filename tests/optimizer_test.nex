# ==============================================================================
#                     NEXUS OPTIMIZER TEST SUITE (v2)
#   Verifies that all compiler optimizations preserve exact language semantics:
#     - compile-time constant folding (wrapping + - *, truncating / %)
#     - strength reduction: *2^n -> shl, /2^n -> sar sequence
#     - folded conditions (if/while/for with constant predicates)
#     - truthiness conditions (if flag { / while 1 {)
#     - float literal folding + const-pool loads
#     - len/abs/itof/ftoi/fsqrt/fneg literal folds
#   Run with: ./nexus test     (or: ./nexus test --file tests/optimizer_test.nex)
# ==============================================================================

include "stdlib/nstdlib.nex"

print "=== NEXUS OPTIMIZER TEST SUITE ==="

# ------------------- 1. constant folding (12 assertions) -------------------
let t1 = 2 + 3 * 4
assert_eq t1, 20

let t2 = 100 - 30 - 5
assert_eq t2, 65

let t3 = 7 / 2
assert_eq t3, 3

let t4 = 100 % 9
assert_eq t4, 1

let t5 = 100000 * 100000
assert_eq t5, 10000000000

let t6 = 0 - 7 / 2
assert_eq t6, 0 - 3

let t7 = 6 * 8
assert_eq t7, 48

let t8 = 12 + 0 - 0 * 5
assert_eq t8, 60

let t9 = 0 - 7 % 3
assert_eq t9, 0 - 1

let t10 = 50 / 4 / 5
assert_eq t10, 2

let t11 = 2 * 3 + 4 * 5
assert_eq t11, 50

let t12 = 1 - 2 + 3 - 4 + 5
assert_eq t12, 3

# ------------- 2. runtime strength reductions (10 assertions) --------------
let v = 0 - 13

let d1 = v / 4
assert_eq d1, 0 - 3

let d2 = v / 2
assert_eq d2, 0 - 6

let d3 = v / 8
assert_eq d3, 0 - 1

let d4 = 40 / 8
assert_eq d4, 5

let m1 = 6 * 8
assert_eq m1, 48

let big = 300000
let m2 = big * 2
assert_eq m2, 600000

let m3 = big * 1024
assert_eq m3, 307200000

let n1 = v * 3
assert_eq n1, 0 - 39

let n2 = v * 1000000
assert_eq n2, 0 - 13000000

let n3 = 3 * 7 * 0
assert_eq n3, 0

# ------------- 3. wrap-around / trap semantics (3 assertions) --------------
let big2 = 9223372036854775807
let w1 = big2 + 1
assert_eq w1, 0 - 9223372036854775807 - 1

let w2 = big2 * 2
assert_eq w2, 0 - 2

let neg = 0 - 9223372036854775807 - 1
let w3 = neg / 2
assert_eq w3, 0 - 4611686018427387904

# ---------------- 4. folded conditions (6 assertions) ----------------------
let hit = 0

if 1 == 1 {
    let hit = hit + 1
}
if 2 < 1 {
    let hit = hit + 10
}
if 3 >= 3 {
    let hit = hit + 100
}
if 4 > 5 {
    let hit = hit + 1000
} else {
    let hit = hit + 10000
}
if 10 != 10 {
    let hit = hit + 100000
}
if 5 <= 4 {
    let hit = hit + 1000000
}
assert_eq hit, 10101

let ladder = 0
if 1 == 2 {
    let ladder = 1
} else if 2 == 2 {
    let ladder = 2
} else {
    let ladder = 3
}
assert_eq ladder, 2

# ---------------- 5. truthiness conditions (5 assertions) ------------------
let flag = 5
let th = 0

if flag {
    let th = th + 1
}
let z = 0
if z {
    let th = th + 10
}
assert_eq th, 1

let k = 0
while 1 {
    let k = k + 1
    if k == 5 {
        break
    }
}
assert_eq k, 5

let fk = 0
for i = 0, 1, i = i + 1 {
    let fk = fk + i
    if i == 4 {
        break
    }
}
assert_eq fk, 10

let negflag = 0 - 3
let th2 = 0
if negflag {
    let th2 = 1
}
assert_eq th2, 1

# ---------------- 6. float literal folds (7 assertions) --------------------
let f1 = fadd 2.0 3.5
let i1 = ftoi f1
assert_eq i1, 5

let f2 = fsqrt 144.0
let i2 = ftoi f2
assert_eq i2, 12

let f3 = fneg 7.5
let i3 = ftoi f3
assert_eq i3, 0 - 7

let i5 = ftoi 3.7
assert_eq i5, 3

let i6 = ftoi 3.2
assert_eq i6, 3

let f7 = fsub 0.0 3.7
let i7 = ftoi f7
assert_eq i7, 0 - 3

let f8 = fmul 1.5 4.0
let i8 = ftoi f8
assert_eq i8, 6

# runtime float ops through const-pool literals
let fv = 2.5
let fr = fadd fv 0.5
let i9 = ftoi fr
assert_eq i9, 3

# ---------------- 7. unary folds + addressing (6 assertions) ---------------
let a1 = abs -123
assert_eq a1, 123

let a2 = abs 55
assert_eq a2, 55

let l1 = len "optimizer"
assert_eq l1, 9

let s = "ABC"
let c0 = load [s + 0]
assert_eq c0, 65

let q = alloc 16
store64 [q + 0 * 8] 4096
let qv = load64 [q + 0 * 8]
assert_eq qv, 4096

store64 [q + 1 * 8] 7
let qv2 = load64 [q + 1 * 8] / 2
assert_eq qv2, 3

# ---------------- 8. mixed folding inside loops (6 assertions) -------------
let inc = 100 / 4
assert_eq inc, 25
let acc = 0
let j = 0
while j < 10 {
    let acc = acc + inc
    let j = j + 1
}
assert_eq acc, 250

let sq = 0
for i = 1, i <= 4, i = i + 1 {
    let term = i * i
    let sq = sq + term
}
assert_eq sq, 30

let scale = 3
let mixed = scale * 8 + 5
assert_eq mixed, 29

let half = mixed / 2
assert_eq half, 14

let step = 0
for i = 0, i < 100, i += 1 {
    let step = step + 2
}
assert_eq step, 200

let c1 = 2 + 3
let c2 = c1 * 4
let c3 = c2 - 6
let c4 = c3 / 4
assert_eq c4, 3

# ------------------------- summary -------------------------
if nx_assert_fails == 0 {
    print "[SUCCESS] ALL OPTIMIZER TESTS PASSED!"
} else {
    print "[FAILURE] OPTIMIZER TESTS FAILED"
}
call nx_assert_summary
