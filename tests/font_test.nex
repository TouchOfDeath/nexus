# ==============================================================================
#                 NEXUS 8x8 ARCADE FONT VERIFICATION TEST
# ==============================================================================

include "stdlib/x11.nex"
include "stdlib/font.nex"

# 1. Initialize Window
let x11_width = 360
let x11_height = 400
call x11_init

# Render for 30 frames to guarantee window manager exposure
let f_count = 0
while f_count < 30 {
    let f_count = f_count + 1

    # 2. Clear background to Dark Slate Navy (15, 23, 42)
    let x11_r = 15
    let x11_g = 23
    let x11_b = 42
    call x11_clear

    # 3. Draw Title at Scale 2 (Neon Cyan: 56, 189, 248)
    let draw_text_str = "NEXUS RETRO"
    let draw_text_x = 24
    let draw_text_y = 30
    let draw_text_scale = 2
    let draw_text_r = 56
    let draw_text_g = 189
    let draw_text_b = 248
    call draw_text

    # 4. Draw Subtitle at Scale 2 (Golden Yellow: 250, 204, 21)
    let draw_text_str = "FONT ENGINE"
    let draw_text_x = 24
    let draw_text_y = 52
    let draw_text_scale = 2
    let draw_text_r = 250
    let draw_text_g = 204
    let draw_text_b = 21
    call draw_text

    # 5. Draw Body Text at Scale 1 (Crisp White: 255, 255, 255)
    let draw_text_str = "Public domain IBM 8x8 bitmap"
    let draw_text_x = 24
    let draw_text_y = 90
    let draw_text_scale = 1
    let draw_text_r = 255
    let draw_text_g = 255
    let draw_text_b = 255
    call draw_text

    let draw_text_str = "100% pure native NEXUS code"
    let draw_text_x = 24
    let draw_text_y = 104
    let draw_text_scale = 1
    let draw_text_r = 148
    let draw_text_g = 163
    let draw_text_b = 184
    call draw_text

    # 6. Draw Score Label and Integer via draw_int (Lime Green: 74, 222, 128)
    let draw_text_str = "HIGH SCORE: "
    let draw_text_x = 24
    let draw_text_y = 140
    let draw_text_scale = 2
    let draw_text_r = 74
    let draw_text_g = 222
    let draw_text_b = 128
    call draw_text

    let draw_int_val = 98450
    let draw_text_x = 216
    let draw_text_y = 140
    let draw_text_scale = 2
    let draw_text_r = 74
    let draw_text_g = 222
    let draw_text_b = 128
    call draw_int

    # 7. Draw Large Big Text at Scale 3 (Hot Coral Red: 248, 113, 113)
    let draw_text_str = "PLAY NOW!"
    let draw_text_x = 48
    let draw_text_y = 200
    let draw_text_scale = 3
    let draw_text_r = 248
    let draw_text_g = 113
    let draw_text_b = 113
    call draw_text

    # 8. Present frame to screen & poll
    call x11_present
    call x11_poll_events
}

call x11_close
print "[PASS] Font test completed successfully!"
