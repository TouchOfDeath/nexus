# ==============================================================================
#  AETHER EXAMPLE 11: Audio Synthesizer & Spatial Mixer (examples/aether_11_audio_mixer.nex)
#  Demonstrates multi-voice PCM synthesis (Sine, Square, Triangle, Sweep),
#  3D spatial audio panning, real-time stereo mixing & visual peak meters.
# ==============================================================================

import aether

let win = ae_window_create("Aether 11 - Audio Synthesizer & 3D Spatial Mixer", 480, 280)
ae_set_max_frames(4)

let snd_lead = ae_sound_synth_tone(AE_WAVE_SINE, 523, 250, 800)
let snd_bass = ae_sound_synth_tone(AE_WAVE_TRIANGLE, 130, 300, 850)
let snd_laser = ae_sound_synth_sweep(AE_WAVE_SQUARE, 880, 220, 180, 750)

ae_audio_set_listener(0, 0, 0, 1000, 0, 0)
let v_music = ae_music_play(snd_bass, 750, 1)
let v_left = ae_sound_play_spatial(snd_lead, -3500, 0, -1000, 10000, 950)
let v_right = ae_sound_play_spatial(snd_laser, 4200, 0, -500, 10000, 950)

while ae_begin_frame() {
    ae_audio_update(25)
    let pk_l = ae_audio_peak_left()
    let pk_r = ae_audio_peak_right()
    let act_v = ae_audio_active_voices()

    ae_clear(AE_COLOR_NAVY)
    ae_draw_text("AETHER MULTI-VOICE STEREO MIXER", 20, 20, 2, AE_COLOR_CYAN)
    ae_draw_text("ACTIVE VOICES: " + str(act_v), 20, 55, 1, AE_COLOR_WHITE)

    # Left & Right VU Peak Meters
    let bar_l = (pk_l * 360) / 32768
    let bar_r = (pk_r * 360) / 32768
    ae_draw_text("LEFT  CH:", 20, 105, 1, AE_COLOR_LIGHT_GRAY)
    ae_fill_rounded_rect(100, 100, bar_l + 8, 22, 4, AE_COLOR_GREEN)
    ae_draw_text("RIGHT CH:", 20, 145, 1, AE_COLOR_LIGHT_GRAY)
    ae_fill_rounded_rect(100, 140, bar_r + 8, 22, 4, AE_COLOR_GOLD)

    ae_end_frame()
}

print "AETHER_11_AUDIO_MIXER_OK"
ae_shutdown()
