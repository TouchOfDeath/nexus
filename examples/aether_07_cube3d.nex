# ==============================================================================
#  AETHER EXAMPLE 07: Hello 3D Rotating Textured Cube (examples/aether_07_cube3d.nex)
#  Demonstrates perspective 3D camera, procedural cube mesh, checkerboard UV
#  texture mapping, 32-bit Z-buffer depth test, backface culling & Euler rotation.
# ==============================================================================

import aether

let win = ae_window_create("Aether 07 - Hello 3D Rotating Cube", 360, 240)
ae_set_max_frames(4)

let cam = ae_camera3d_perspective(60, 1500, 100, 40000)
ae_camera3d_orbit(cam, 0, 0, 0, 3200, 25, 20)

let cube = ae_mesh_create_cube(1300)
let tex = ae_texture_checkerboard(32, 32, 8, AE_COLOR_WHITE, AE_COLOR_SKY)
let mat = ae_material_create(AE_SHADER_LAMBERT, AE_COLOR_WHITE, tex)

let ry = 20
while ae_begin_frame() {
    ae_draw_skybox(AE_COLOR_NAVY, AE_COLOR_SLATE, AE_COLOR_DARK_GRAY)
    ae_camera3d_begin(cam)
    ae_draw_mesh_trs(cube, 0, 0, 0, 20, ry, 10, 1000, 1000, 1000, mat)
    ae_draw_text("AETHER 3D TEXTURED CUBE", 12, 12, 1, AE_COLOR_GOLD)
    let ry = ry + 18
    ae_end_frame()
}

print "AETHER_07_CUBE3D_OK"
ae_shutdown()
