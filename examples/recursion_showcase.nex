print "=================================================="
print "   NEXUS Pure Native Stack Frames & Recursion     "
print "=================================================="

print "[1] Computing Factorial of 7 (7! = 5040):"
let f7 = call factorial(7)
print f7

print "[2] Computing Fibonacci sequence (terms 0 to 10):"
for i = 0, i <= 10, i += 1 {
    let fib_val = call fibonacci(i)
    print fib_val
}

print "[3] Computing Euclidean GCD of (252, 105):"
let g = call gcd(252, 105)
print g

print "[4] Computing Ackermann A(2, 3) via deep recursion:"
let ack_val = call ackermann(2, 3)
print ack_val

print "[5] Running Supervisor & Worker with isolated local variables:"
let team_output = call supervisor(5)
print team_output

print "=================================================="
print "   All Recursive Functions Executed Successfully! "
print "=================================================="
