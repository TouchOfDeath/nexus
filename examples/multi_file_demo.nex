print "Square of 7 (expected 49):"
print sq_res

let in_val = 5
call calc_cube
print "Cube of 5 (expected 125):"
print cube_res

let leg_a = 3
let leg_b = 4
call calc_hypotenuse_sq
print "Hypotenuse squared for 3,4 (expected 25):"
print hyp_sq

# Display footer from display_utils module
call show_footer
