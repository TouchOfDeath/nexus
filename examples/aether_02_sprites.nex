# ==============================================================================
#  AETHER EXAMPLE 02: Sprites, Atlas & Animation (examples/aether_02_sprites.nex)
#  Demonstrates procedural textures, nearest vs bilinear filtering, sprites,
#  rotated/scaled blitting, spritesheet atlases, and frame-based AeAnimator.
# ==============================================================================

import aether

let win = ae_window_create("Aether 02 - Sprites, Atlas & Animator", 640, 360)
ae_set_max_frames(4)

let chk_tex = ae_texture_checkerboard(64, 64, 8, AE_COLOR_CYAN, AE_COLOR_NAVY)
let grad_tex = ae_texture_gradient(64, 64, AE_COLOR_RED, AE_COLOR_GOLD, AE_COLOR_BLUE, AE_COLOR_GREEN)
ae_texture_set_filter(grad_tex, AE_FILTER_BILINEAR)

let sp_hero = ae_sprite_new(chk_tex, 0, 0, 1000, 1000)
let sheet = ae_spritesheet_new(grad_tex, 16, 16)
let anim = ae_animator_new(sheet, 0, 16, 12, 1)

let angle = 0
while ae_begin_frame() {
    ae_clear(AE_COLOR_DARK_GRAY)

    # Draw standard, scaled, tinted, and rotated sprites
    ae_draw_sprite(sp_hero, 50, 80, 1000, 1000, 0, AE_COLOR_WHITE)
    ae_draw_sprite(sp_hero, 150, 65, 1500, 1500, 0, AE_COLOR_GOLD)
    ae_draw_sprite(sp_hero, 300, 80, 1200, 1200, angle, AE_COLOR_CORAL)

    # Step and render animated spritesheet frames
    ae_animator_update(anim, 85)
    ae_animator_draw(anim, 460, 70, 4000, 0, AE_COLOR_WHITE)

    ae_draw_text("SPRITES, ROTATION, FILTERING & ANIMATOR", 40, 20, 2, AE_COLOR_SKY)
    let angle = angle + 15
    ae_end_frame()
}

print "AETHER_02_SPRITES_OK"
ae_shutdown()
