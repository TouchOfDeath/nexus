# ==============================================================================
#  AETHER EXAMPLE 08: 3D Lighting, Shaders & Shadows (examples/aether_08_lighting3d.nex)
#  Demonstrates Blinn-Phong specular, Cel/Toon shading, Normal visualization,
#  directional + point lights, and planar shadow mapping.
# ==============================================================================

import aether

let win = ae_window_create("Aether 08 - 3D Lighting, Materials & Shadows", 360, 240)
ae_set_max_frames(3)

let cam = ae_camera3d_perspective(60, 1500, 100, 50000)
ae_camera3d_orbit(cam, 0, 0, 0, 4200, 15, 22)

ae_light_set_ambient(45, 50, 70, 1000)
ae_light_set_directional(-400, -850, -350, 255, 245, 225, 1000)
ae_light_add_point(1500, 1200, 1500, 255, 120, 40, 6000, 950)
ae_shadow_enable(-900, 450)

let sphere = ae_mesh_create_sphere(750, 6, 8)
let cube = ae_mesh_create_cube(1100)
let pyr = ae_mesh_create_pyramid(1000, 1300)

let mat_phong = ae_material_create(AE_SHADER_PHONG, AE_COLOR_CRIMSON, 0)
let mat_toon = ae_material_create(AE_SHADER_TOON, AE_COLOR_CYAN, 0)
let mat_norm = ae_material_create(AE_SHADER_NORMAL_VIS, AE_COLOR_WHITE, 0)

let angle = 0
while ae_begin_frame() {
    ae_draw_skybox(AE_COLOR_NAVY, AE_COLOR_SKY, AE_COLOR_SLATE)
    ae_camera3d_begin(cam)

    ae_draw_mesh_trs(cube, -1300, 0, 0, 15, angle, 0, 1000, 1000, 1000, mat_phong)
    ae_draw_mesh_trs(sphere, 0, 100, 0, 0, angle, 0, 1000, 1000, 1000, mat_toon)
    ae_draw_mesh_trs(pyr, 1300, 0, 0, 0, angle, 0, 1000, 1000, 1000, mat_norm)

    ae_draw_text("PHONG | TOON | NORMAL + SHADOWS", 12, 12, 1, AE_COLOR_WHITE)
    let angle = angle + 20
    ae_end_frame()
}

print "AETHER_08_LIGHTING3D_OK"
ae_shutdown()
