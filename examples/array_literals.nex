# ==============================================================================
#   NEXUS Feature Showcase: Array Literals & Bracket Indexing (v5.7)
# ==============================================================================
# Demonstrates:
#   1. Inline array literals: let arr = [10, 20, 30]
#   2. Multi-line formatted arrays with trailing comments
#   3. Direct indexed read: let x = arr[0] and let item = arr[i]
#   4. Direct indexed write: arr[1] = 99
#   5. In-place compound updates: arr[i] += 10
#   6. Array passing to parameterized functions
#   7. 64-bit IEEE-754 floating point arrays
# ==============================================================================

print "--- NEXUS Array Literals & Bracket Indexing Showcase ---"

# 1. Inline integer array creation
let primes = [2, 3, 5, 7, 11, 13]
print "First prime:"
print primes[0]
print "Sixth prime:"
print primes[5]

# 2. Multi-line array with comments
let palette = [
    255, # Red
    128, # Green
    64   # Blue
]
print "Palette green component:"
print palette[1]

# 3. In-place modification and compound updates
palette[1] = 200
print "Updated palette green:"
print palette[1]

palette[1] += 55
print "After compound addition (palette[1] += 55):"
print palette[1]

# 4. Iteration using bracket indexing
print "Iterating through primes:"
let sum = 0
for i = 0, i < 6, i += 1 {
    let p = primes[i]
    sum += p
}
print "Sum of first 6 primes:"
print sum

# 5. Parameterized function operating on an array
fn compute_dot_product(a, b, count) {
    let dot = 0
    for i = 0, i < count, i += 1 {
        let prod = a[i] * b[i]
        dot += prod
    }
    return dot
}

let vec1 = [1, 2, 3]
let vec2 = [4, 5, 6]
# Dot product = 1*4 + 2*5 + 3*6 = 4 + 10 + 18 = 32
let dot = call compute_dot_product(vec1, vec2, 3)
print "Dot product of [1, 2, 3] and [4, 5, 6] (expected 32):"
print dot

# 6. Floating point arrays
let floats = [2.5, 7.5, 10.0]
let f_sum = floats[0] +. floats[1] +. floats[2]
print "Float array sum (expected 20.000000):"
print_float f_sum

# Standard example return code
print 42
