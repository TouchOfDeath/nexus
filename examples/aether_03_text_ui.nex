# ==============================================================================
#  AETHER EXAMPLE 03: Text Rendering & UI Layout (examples/aether_03_text_ui.nex)
#  Demonstrates bitmap font rendering, text measurement, alignment, drop shadows,
#  scissor-clipped panels, and interactive UI button hit-testing.
# ==============================================================================

import aether

let win = ae_window_create("Aether 03 - Text & UI Layout", 640, 360)
ae_set_max_frames(3)

let frame_idx = 0
while ae_begin_frame() {
    ae_clear(AE_COLOR_NAVY)

    # Simulate mouse hovering over button 1 on frame 1
    if frame_idx == 1 {
        ae_input_inject_mouse_move(140, 165)
        ae_input_inject_mouse_button(AE_MOUSE_LEFT, 1)
    }

    # Header card with shadowed centered title
    ae_fill_rounded_rect(20, 20, 600, 60, 8, AE_COLOR_SLATE)
    ae_draw_text_shadow("AETHER UI & TYPOGRAPHY", 130, 42, 2, AE_COLOR_GOLD, AE_COLOR_BLACK)

    # Interactive Button with hover/press feedback
    let mx = ae_mouse_x()
    let my = ae_mouse_y()
    let hovered = ae_collide_point_rect(mx, my, 40, 140, 220, 50)
    let btn_col = AE_COLOR_BLUE
    if hovered == 1 {
        let btn_col = AE_COLOR_CYAN
    }
    ae_fill_rounded_rect(40, 140, 220, 50, 8, btn_col)
    ae_stroke_rect(40, 140, 220, 50, 2, AE_COLOR_WHITE)
    ae_draw_text_aligned("LAUNCH MISSION", 150, 158, 2, AE_COLOR_WHITE, AE_ALIGN_CENTER)

    # Scissor-clipped scrolling log panel
    ae_fill_rect(310, 110, 300, 210, AE_COLOR_DARK_GRAY)
    ae_stroke_rect(310, 110, 300, 210, 2, AE_COLOR_CYAN)
    ae_scissor_begin(314, 114, 292, 202)
    ae_draw_text("SYSTEM TELEMETRY LOG\n[OK] Window Initialized\n[OK] Font Atlas Ready\n[OK] Scissor Active\n[OK] Input Polled", 324, 126, 1, AE_COLOR_GREEN)
    ae_scissor_end()

    let frame_idx = frame_idx + 1
    ae_end_frame()
}

print "AETHER_03_TEXT_UI_OK"
ae_shutdown()
