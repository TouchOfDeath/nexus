# ==============================================================================
#  AETHER EXAMPLE 09: 3D Camera Controller & Raycasting (examples/aether_09_camera3d.nex)
#  Demonstrates orbital and free-look 3D camera movement, perspective vs
#  orthographic projection, and 3D ray-sphere / ray-AABB intersection picking.
# ==============================================================================

import aether

let win = ae_window_create("Aether 09 - 3D Camera & Raycast Picking", 360, 240)
ae_set_max_frames(4)

let cam = ae_camera3d_perspective(60, 1500, 100, 50000)
let cube = ae_mesh_create_cube(1000)
let mat_idle = ae_material_create(AE_SHADER_PHONG, AE_COLOR_BLUE, 0)
let mat_hit = ae_material_create(AE_SHADER_PHONG, AE_COLOR_GOLD, 0)

let yaw = 0
while ae_begin_frame() {
    ae_draw_skybox(AE_COLOR_NAVY, AE_COLOR_DARK_GRAY, AE_COLOR_BLACK)
    ae_camera3d_orbit(cam, 0, 0, 0, 3600, yaw, 18)
    ae_camera3d_begin(cam)

    # Cast a 3D picking ray from camera position toward origin (0, 0, 0)
    let cx = load64 [cam + 0]
    let cy = load64 [cam + 8]
    let cz = load64 [cam + 16]
    let dir_v = ae_vec3(0 - cx, 0 - cy, 0 - cz)
    let dir_n = ae_vec3_normalize(dir_v)
    let ray = ae_ray_new(cx, cy, cz, load64 [dir_n + 0], load64 [dir_n + 8], load64 [dir_n + 16])
    let hit_dist = ae_ray_intersect_sphere(ray, 0, 0, 0, 800)

    let active_mat = mat_idle
    if hit_dist > 0 { let active_mat = mat_hit }
    ae_draw_mesh_trs(cube, 0, 0, 0, 15, yaw, 0, 1000, 1000, 1000, active_mat)

    ae_draw_text("3D ORBIT CAMERA | RAY HIT DIST: " + str(hit_dist), 12, 12, 1, AE_COLOR_CYAN)
    let yaw = yaw + 25
    ae_end_frame()
}

print "AETHER_09_CAMERA3D_OK"
ae_shutdown()
