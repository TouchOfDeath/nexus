# ==============================================================================
#           NEXUS MATHEMATICAL ECOSYSTEM SHOWCASE (v5.8)
#   Demonstrating native exponentiation, combinatorics, set theory,
#   number theory, hyperoperations, linear algebra, complex numbers,
#   exact fractions (rationals), and statistics.
# ==============================================================================

include "stdlib/nstdlib.nex"
include "stdlib/combinatorics.nex"
include "stdlib/sets.nex"
include "stdlib/number_theory.nex"
include "stdlib/linalg.nex"
include "stdlib/complex.nex"
include "stdlib/rational.nex"
include "stdlib/statistics.nex"

print "=================================================="
print "    NEXUS ADVANCED MATHEMATICS SHOWCASE"
print "=================================================="

# 1. Native Exponentiation Operator (**)
print "--- 1. Exponentiation Operator (**) ---"
let base_val = 2
let exp_val = 16
let pow_res = base_val ** exp_val
print "2 ** 16 ="
print pow_res

let cube_val = 5
cube_val **= 3
print "5 **= 3 ="
print cube_val

# 2. Combinatorics & Permutations
print "--- 2. Combinatorics (n!, P, C, Catalan) ---"
let nx_i0 = 10
call nx_fact
print "10! ="
print nx_r0

let nx_i0 = 10
let nx_i1 = 4
call nx_comb_count
print "C(10, 4) choose ="
print nx_r0

let nx_i0 = 5
call nx_catalan
print "5th Catalan Number ="
print nx_r0

# 3. Set Theory (Two-pointer O(n + m) sets)
print "--- 3. Set Theory ---"
let set1 = [1, 2, 4, 8, 16]
let set2 = [2, 4, 6, 8, 10]
let set_res = alloc 64

let nx_i0 = set1
let nx_i1 = 5
let nx_i2 = set2
let nx_i3 = 5
let nx_i4 = set_res
call nx_set_intersect
print "Count of Set1 INTERSECT Set2 ="
print nx_r0

call nx_set_sym_diff
print "Count of Set1 SYMMETRIC_DIFF Set2 ="
print nx_r0

# 4. Number Theory & Hyperoperations (Tetration / Pentation)
print "--- 4. Hyperoperations & Number Theory ---"
let nx_i0 = 2
let nx_i1 = 4
call nx_tetrate
print "Tetration: 2 ^^ 4 (power tower) ="
print nx_r0

let nx_i0 = 2
let nx_i1 = 3
call nx_pentate
print "Pentation: 2 ^^^ 3 ="
print nx_r0

let nx_i0 = 3
let nx_i1 = 10
call nx_mod_inv
print "Modular Inverse of 3 mod 10 ="
print nx_r0

# 5. Linear Algebra (Matrix Multiplication & 3D Cross Product)
print "--- 5. Linear Algebra (AI & Simulation) ---"
let mA = [1, 2, 3, 4]
let mB = [5, 6, 7, 8]
let mC = alloc 32
let nx_i0 = mA
let nx_i1 = mB
let nx_i2 = mC
let nx_i3 = 2
let nx_i4 = 2
let nx_i5 = 2
call nx_mat_mul
let c00 = mC[0]
let c11 = mC[3]
print "Matrix A * B top-left [0,0] and bottom-right [1,1]:"
print c00
print c11

let x_vec = [1, 0, 0]
let y_vec = [0, 1, 0]
let z_vec = alloc 24
let nx_i0 = x_vec
let nx_i1 = y_vec
let nx_i2 = z_vec
call nx_vec3_cross
let z_axis = z_vec[2]
print "3D Cross Product [1,0,0] x [0,1,0] z-component ="
print z_axis

# 6. Exact Rational Arithmetic (Fractions)
print "--- 6. Exact Fraction Arithmetic (0 float drift) ---"
let rat_res = alloc 16
let nx_i0 = 1
let nx_i1 = 3
let nx_i2 = 1
let nx_i3 = 6
let nx_i4 = rat_res
call nx_rat_add
let r_num = rat_res[0]
let r_den = rat_res[1]
print "1/3 + 1/6 (numerator, denominator) ="
print r_num
print r_den

# 7. Descriptive Statistics
print "--- 7. Statistics ---"
let dataset = [10, 20, 30, 40, 50]
let nx_i0 = dataset
let nx_i1 = 5
call nx_stat_mean
print "Mean of [10, 20, 30, 40, 50] ="
print nx_r0

call nx_stat_stdev
print "Standard Deviation ="
print nx_r0

print "=================================================="
print "[SUCCESS] MATHEMATICS SHOWCASE COMPLETED!"
print "=================================================="
