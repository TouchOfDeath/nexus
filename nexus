        echo "    Run now:  cd $proj && ./build.sh && ./app.elf"
        ;;
    fmt)
        NEXFMT="$BIN_DIR/nexfmt"
        if [ ! -f "$NEXFMT" ] || [ "$TOOLS_DIR/nexfmt.c" -nt "$NEXFMT" ]; then
            mkdir -p "$BIN_DIR"
            gcc -O2 "$TOOLS_DIR/nexfmt.c" -o "$NEXFMT"
        fi
        [ -z "${2:-}" ] && usage
        "$NEXFMT" "${@:2}"
        ;;
    sprite)
        python3 "$TOOLS_DIR/nexsprite.py" "${@:2}"
        ;;
    ide|edit|studio|idle)
        if [ "${2:-}" = "--native" ] || [ "${2:-}" = "-n" ]; then
            "$0" build "$SCRIPT_DIR/examples/nexus_ide.nex"
            echo "[+] Launching Pure Native NEXUS IDE (0% Python / 0% C / 0% libc / 0% Xlib)..."
            "$SCRIPT_DIR/examples/nexus_ide.elf"
        else
            shift || true
            python3 "$TOOLS_DIR/nexstudio.py" "$@"
        fi
        ;;
    *)
        usage
        ;;
esac
