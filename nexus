    sys.exit(1)
shutil.move(os.path.join(compiler_dir, 'app.exe'), out_exe)
shutil.move(os.path.join(compiler_dir, 'app.elf'), out_elf)
os.chmod(out_elf, 0o755)
print(f'[+] Built {out_exe} ({os.path.getsize(out_exe)} bytes)')
print(f'[+] Built {out_elf} ({os.path.getsize(out_elf)} bytes) in {(time.time()-t0)*1000:.0f} ms')
print(f'[+] Run: {out_elf}')
cache[key] = fp
open(cache_file, 'w').write('\n'.join(f'{k}={v}' for k, v in cache.items()) + '\n')
PYBUILD
        else
            "$SCRIPT_DIR/build_all.sh"
        fi
        ;;
    prep)
        [ -z "${2:-}" ] && usage
        src="$(realpath "$2")"
        out="${3:-}"
        if [ -n "$out" ]; then
            "$NEXPREP" "$src" "$out"
        else
            "$NEXPREP" "$src"
        fi
        ;;
    run)
        [ -z "${2:-}" ] && usage
        src="$(realpath "$2")"
        "$NEXPREP" "$src" "$COMPILER_DIR/code.nex"
        rm -f "$COMPILER_DIR/app.exe" "$COMPILER_DIR/app.elf"
        if [ -f "$COMPILER_DIR/nexc.elf" ]; then
            comp_out=$(cd "$COMPILER_DIR" && ./nexc.elf)
        else
            comp_out=$(cd "$COMPILER_DIR" && "$NEXLOAD" "$COMPILER_DIR/nexc.exe")
        fi
        if [ ! -f "$COMPILER_DIR/app.exe" ]; then
            echo "$comp_out"
            echo "[-] Execution halted due to compilation error."
            exit 1
        fi
        [ ! -f "$COMPILER_DIR/app.elf" ] && "$NEXELF" "$COMPILER_DIR/app.exe" "$COMPILER_DIR/app.elf" > /dev/null
        # Direct execution on bare-metal Linux kernel (0% loader, 0% C runtime):
        "$COMPILER_DIR/app.elf"
        ;;
    compile)
        shift
        target=""
        src=""
        out=""
        while [ $# -gt 0 ]; do
            case "$1" in
                --target)
                    shift
                    target="$1"
                    ;;
                --target=*)
                    target="${1#*=}"
                    ;;
                *)
                    if [ -z "$src" ]; then
                        src="$1"
                    elif [ -z "$out" ]; then
                        out="$1"
                    fi
                    ;;
            esac
            shift
        done
        [ -z "$src" ] && usage
        src="$(realpath "$src")"
        "$NEXPREP" "$src" "$COMPILER_DIR/code.nex"

        case "$target" in
            arm64-macos|macos-arm64|macos)
                out_bin="${out:-$COMPILER_DIR/app.macho}"
                "$NEXARM64" --target macos "$COMPILER_DIR/code.nex" "$out_bin"
                echo -e "[+] Pure Native Apple Silicon ARM64 Mach-O: $out_bin"
                echo -e "    Mach-O size: $(wc -c < "$out_bin") bytes (0% libc - 0% runtime)"
                echo -e "    Inspect ARM64 assembly: llvm-objdump-18 -d $out_bin"
                ;;
            linux-aarch64|aarch64-linux|arm64-linux|linux)
                out_bin="${out:-$COMPILER_DIR/app.elf}"
                "$NEXARM64" --target linux "$COMPILER_DIR/code.nex" "$out_bin"
                echo -e "[+] Pure Native Linux AArch64 ELF64: $out_bin"
                echo -e "    ELF64 size: $(wc -c < "$out_bin") bytes (0% libc - 0% runtime)"
                echo -e "    Inspect ARM64 assembly: llvm-objdump-18 -d $out_bin"
                ;;
            ""|tri|all)
                rm -f "$COMPILER_DIR/app.exe" "$COMPILER_DIR/app.elf"
                if [ -f "$COMPILER_DIR/nexc.elf" ]; then
                    (cd "$COMPILER_DIR" && ./nexc.elf)
                else
                    (cd "$COMPILER_DIR" && "$NEXLOAD" "$COMPILER_DIR/nexc.exe")
                fi
                if [ -f "$COMPILER_DIR/app.exe" ]; then
                    [ ! -f "$COMPILER_DIR/app.elf" ] && "$NEXELF" "$COMPILER_DIR/app.exe" "$COMPILER_DIR/app.elf" > /dev/null
                    "$NEXARM64" --target macos "$COMPILER_DIR/code.nex" "$COMPILER_DIR/app.macho" > /dev/null 2>&1 || "$NEXMACHO" "$COMPILER_DIR/app.exe" "$COMPILER_DIR/app.macho" > /dev/null
                    if [ -n "$out" ]; then
                        cp "$COMPILER_DIR/app.elf" "$out"
                    fi
                    echo -e "[+] Tri-Platform Native Binaries Generated:"
                    echo -e "    Windows PE32+: $COMPILER_DIR/app.exe (49,152 bytes)"
                    echo -e "    Linux ELF64:   $COMPILER_DIR/app.elf ($(wc -c < "$COMPILER_DIR/app.elf") bytes - Direct Kernel Execution)"
                    echo -e "    macOS Mach-O:  $COMPILER_DIR/app.macho ($(wc -c < "$COMPILER_DIR/app.macho") bytes - Pure Native ARM64 Apple Silicon)"
                else
                    echo "[-] Compilation failed."
                    exit 1
                fi
                ;;
            *)
                echo "[-] Error: Unsupported target '$target' (use 'arm64-macos' or 'linux-aarch64')"
                exit 1
                ;;
        esac
        ;;
    play)
        src="${2:-examples/gui_flappy.nex}"
        "$0" build "$src"
        bin_elf="${src%.nex}.elf"
        [ ! -f "$bin_elf" ] && bin_elf="$COMPILER_DIR/app.elf"
        echo "[+] Launching pure native NEXUS graphical game: $bin_elf"
        echo "    (0% C - 0% libc - 0% Xlib - Direct Kernel & X11 Execution)"
        "$bin_elf"
        ;;
    arm64)
        shift
        target="macos"
        src=""
        out=""
        while [ $# -gt 0 ]; do
            case "$1" in
                --target)
                    shift
                    target="$1"
                    ;;
                --target=*)
                    target="${1#*=}"
                    ;;
                *)
                    if [ -z "$src" ]; then
                        src="$1"
                    elif [ -z "$out" ]; then
                        out="$1"
                    fi
                    ;;
            esac
            shift
        done
        [ -z "$src" ] && usage
        src="$(realpath "$src")"
        "$NEXPREP" "$src" "$COMPILER_DIR/code.nex"
        case "$target" in
            macos|arm64-macos|macos-arm64)
                out_bin="${out:-$COMPILER_DIR/app.macho}"
                "$NEXARM64" --target macos "$COMPILER_DIR/code.nex" "$out_bin"
                echo -e "[+] Pure Native Apple Silicon ARM64 Mach-O: $out_bin"
                echo -e "    Mach-O size: $(wc -c < "$out_bin") bytes (0% libc - 0% runtime)"
                echo -e "    Inspect ARM64 assembly: llvm-objdump-18 -d $out_bin"
                ;;
            linux|linux-aarch64|aarch64-linux|arm64-linux)
                out_bin="${out:-$COMPILER_DIR/app.elf}"
                "$NEXARM64" --target linux "$COMPILER_DIR/code.nex" "$out_bin"
                echo -e "[+] Pure Native Linux AArch64 ELF64: $out_bin"
                echo -e "    ELF64 size: $(wc -c < "$out_bin") bytes (0% libc - 0% runtime)"
                echo -e "    Inspect ARM64 assembly: llvm-objdump-18 -d $out_bin"
                ;;
            *)
                echo "[-] Error: Unsupported target '$target' (use 'macos' or 'linux')"
                exit 1
                ;;
        esac
        ;;
    elf)
        in_bin="${2:-$COMPILER_DIR/app.exe}"
        out_bin="${3:-$COMPILER_DIR/app.elf}"
        "$NEXELF" "$in_bin" "$out_bin"
        ;;
    macho)
        in_bin="${2:-$COMPILER_DIR/app.exe}"
        out_bin="${3:-$COMPILER_DIR/app.macho}"
        "$NEXMACHO" "$in_bin" "$out_bin"
        echo "[+] macOS Mach-O: $out_bin"
        echo "    Transfer to macOS and run with: chmod +x app.macho && ./app.macho"
        ;;
    test)
        if [ "${2:-}" = "--file" ] || [ "${2:-}" = "-f" ]; then
            [ -z "${3:-}" ] && usage
            NEXTEST="$BIN_DIR/nextest"
            if [ ! -f "$NEXTEST" ] || [ "$TOOLS_DIR/nextest.c" -nt "$NEXTEST" ]; then
                gcc -O2 "$TOOLS_DIR/nextest.c" -o "$NEXTEST"
            fi
            shift 2
            exec "$NEXTEST" "$@"
        fi
        echo "Running NEXUS test suite on Linux (Direct Native ELF64 Execution)..."
        python3 -c '
import subprocess, os, glob

base_dir = "'"$SCRIPT_DIR"'"
