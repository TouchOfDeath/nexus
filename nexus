#!/usr/bin/env bash
# ==============================================================================
#                       NEXUS CLI TOOLCHAIN DRIVER (LINUX)
#           0% C#  -  0% .NET Runtime  -  100% Native x86-64 Machine Code
# ==============================================================================
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMPILER_DIR="$SCRIPT_DIR/compiler"
BIN_DIR="$SCRIPT_DIR/bin"
TOOLS_DIR="$SCRIPT_DIR/tools"
NEXLOAD="$BIN_DIR/nexload"
NEXELF="$BIN_DIR/nexelf"
NEXPREP="$BIN_DIR/nexprep"
NEXMACHO="$BIN_DIR/nexmacho"
NEXARM64="$BIN_DIR/nexarm64"

# Compile nexload, nexelf, nexprep, nexmacho, nexarm64 if missing or stale
if [ ! -f "$NEXLOAD" ] || [ "$TOOLS_DIR/nexload.c" -nt "$NEXLOAD" ]; then
    mkdir -p "$BIN_DIR"
    gcc -O2 "$TOOLS_DIR/nexload.c" -o "$NEXLOAD"
fi
if [ ! -f "$NEXELF" ] || [ "$TOOLS_DIR/nexelf.c" -nt "$NEXELF" ]; then
    mkdir -p "$BIN_DIR"
    gcc -O2 "$TOOLS_DIR/nexelf.c" -o "$NEXELF"
fi
if [ ! -f "$NEXPREP" ] || [ "$TOOLS_DIR/nexprep.c" -nt "$NEXPREP" ]; then
    mkdir -p "$BIN_DIR"
    gcc -O2 "$TOOLS_DIR/nexprep.c" -o "$NEXPREP"
fi
if [ ! -f "$NEXMACHO" ] || [ "$TOOLS_DIR/nexmacho.c" -nt "$NEXMACHO" ]; then
    mkdir -p "$BIN_DIR"
    gcc -O2 "$TOOLS_DIR/nexmacho.c" -o "$NEXMACHO"
fi
if [ ! -f "$NEXARM64" ] || [ "$TOOLS_DIR/nexarm64.c" -nt "$NEXARM64" ]; then
    mkdir -p "$BIN_DIR"
    gcc -O2 "$TOOLS_DIR/nexarm64.c" -o "$NEXARM64"
fi

usage() {
    cat << EOF
NEXUS Native Toolchain Driver (Linux & Cross-Platform)
Usage:
  ./nexus build                   Run master multi-step build and verification pipeline
  ./nexus play [game.nex]         Launch native graphical desktop window for a GUI game
  ./nexus run <source.nex>        Compile and run a .nex program (direct Linux kernel execution)
  ./nexus compile [flags] <src>   Compile program (flags: --target arm64-macos | linux-aarch64; default tri-platform)
  ./nexus arm64 [flags] <src> [dst] Compile directly to native ARM64 (--target macos | linux)
  ./nexus elf [src.exe] [dst.elf] Convert PE32+ executable to standalone native Linux ELF64
  ./nexus macho [src.exe] [dst]   Convert PE32+ executable to standalone macOS ARM64 Mach-O
  ./nexus test                    Run full regression test suite across native ELF binaries
  ./nexus bench                   Run the arithmetic benchmark (best of 3, M-iters/sec)
  ./nexus hydron                  Display HYDRON Engine acceleration metrics & telemetry
  ./nexus self-host               Verify Stage 5 self-hosting bit-for-bit parity
  ./nexus dump [binary]           Dump binary headers, sections, and import tables
  ./nexus disasm [binary]         Disassemble native x86-64 machine code
  ./nexus diff <bin1> <bin2>      Perform byte-for-byte binary diff across sections

Developer tooling:
  ./nexus ide [file.nex]         Launch NEXUS Studio IDE (F5 Run, F6 Build, diagnostics, click-to-jump)
                                 (pass --native for experimental bare-metal X11 editor)
  ./nexus edit [file.nex]        Alias for nexus ide
  ./nexus studio [file.nex]      Alias for nexus ide
  ./nexus new <project-name>      Scaffold a new NEXUS project in the current directory
  ./nexus fmt [--check] <file>    Format a .nex source file (stable, idempotent)
  ./nexus build <file.nex>        Incremental project build with dependency caching
                                  (.nexuscache; skips rebuild when nothing changed)
  ./nexus build                   Full master build + verification pipeline
  ./nexus sprite <in.sprite|png>  Compile pixel art/PNG into a standalone NEXUS sprite asset
  ./nexus test --file <test.nex>  Run one test file through bin/nextest
                                  (assert_eq/assert_ne macros, counting, fail-fast)

Examples:
  ./nexus run examples/multi_file_demo.nex
  ./nexus run examples/rocket_physics.nex
  ./nexus prep examples/multi_file_demo.nex
  ./nexus elf compiler/app.exe compiler/app.elf
  ./nexus disasm compiler/app.exe
EOF
    exit 1
}

cmd="${1:-}"
case "$cmd" in
    build)
        if [ -n "${2:-}" ]; then
            python3 - "$SCRIPT_DIR" "$(realpath "$2")" "${3:-}" << 'PYBUILD'
import hashlib, os, shutil, subprocess, sys

root, src, flag = sys.argv[1], os.path.realpath(sys.argv[2]), sys.argv[3]
src_dir = os.path.dirname(src)
base = os.path.splitext(os.path.basename(src))[0]
cache_file = os.path.join(src_dir, '.nexuscache')
out_exe = os.path.join(src_dir, base + '.exe')
out_elf = os.path.join(src_dir, base + '.elf')
compiler_dir = os.path.join(root, 'compiler')

if flag == '--clean':
    for p in (out_exe, out_elf, cache_file):
        if os.path.exists(p):
            os.remove(p)
            print(f'[+] removed {p}')
    print('[+] clean done')
    sys.exit(0)

# dependency fingerprint: source + every resolved include + toolchain binaries
deps = [src]
r = subprocess.run([os.path.join(root, 'bin', 'nexprep'), '--list-deps', src],
                   capture_output=True, text=True)
if r.returncode != 0:
    sys.stderr.write(r.stderr)
    sys.exit(1)
for line in r.stdout.splitlines():
    line = line.strip()
    if line and line not in deps:
        deps.append(line)
for extra in ('compiler/template.bin', 'compiler/elf_parts.bin',
              'compiler/nexc.elf', 'compiler/nexc.exe'):
    p = os.path.join(root, extra)
    if os.path.exists(p):
        deps.append(p)

def fingerprint():
    h = hashlib.sha256()
    for d in deps:
        st = os.stat(d)
        h.update(d.encode())
        h.update(str(st.st_mtime_ns).encode())
        h.update(str(st.st_size).encode())
    return h.hexdigest()

cache = {}
if os.path.exists(cache_file):
    for line in open(cache_file):
        k, _, v = line.strip().partition('=')
        if k and v:
            cache[k] = v
key = base + ':' + hashlib.sha256(src.encode()).hexdigest()[:12]
fp = fingerprint()

cached = cache.get(key)
if cached == fp and os.path.exists(out_exe) and os.path.exists(out_elf):
    print(f'[up-to-date] {out_elf} (dependencies unchanged)')
    print(f'[+] Run: {out_elf}')
    sys.exit(0)

import time
t0 = time.time()
subprocess.run([os.path.join(root, 'bin', 'nexprep'), src,
                os.path.join(compiler_dir, 'code.nex')], check=True)
for f in ('app.exe', 'app.elf'):
    p = os.path.join(compiler_dir, f)
    if os.path.exists(p):
        os.remove(p)
nexc = os.path.join(compiler_dir, 'nexc.elf')
r = subprocess.run([nexc], cwd=compiler_dir, capture_output=True, text=True)
if not os.path.exists(os.path.join(compiler_dir, 'app.elf')):
    print(r.stdout.replace('\r', ''))
