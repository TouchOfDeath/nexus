# ------------------------------------------------------------------------------
# trig_sin: returns sin(trig_angle) * 1024 in trig_val
# ------------------------------------------------------------------------------
fn trig_sin {
    let t_ang = trig_angle % 360
    if t_ang < 0 {
        let t_ang = t_ang + 360
    }

    if t_ang <= 90 {
        let t_off = t_ang * 2
        let trig_val = load16 [trig_quarter + t_off]
        return
    }

    if t_ang <= 180 {
        let t_sub = 180 - t_ang
        let t_off = t_sub * 2
        let trig_val = load16 [trig_quarter + t_off]
        return
    }

    if t_ang <= 270 {
        let t_sub = t_ang - 180
        let t_off = t_sub * 2
        let t_raw = load16 [trig_quarter + t_off]
        let trig_val = 0 - t_raw
        return
    }

    let t_sub = 360 - t_ang
    let t_off = t_sub * 2
    let t_raw = load16 [trig_quarter + t_off]
    let trig_val = 0 - t_raw
}

# ------------------------------------------------------------------------------
# trig_cos: returns cos(trig_angle) * 1024 in trig_val
# ------------------------------------------------------------------------------
fn trig_cos {
    let orig_ang = trig_angle
    let trig_angle = orig_ang + 90
    call trig_sin
    let trig_angle = orig_ang
}
