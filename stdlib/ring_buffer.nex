# ==============================================================================
#                 NEXUS STANDARD LIBRARY - MODULE: ring_buffer.nex
#              Circular Ring Buffer / Deque (Feature #75 & #74)
# ==============================================================================
#
# A RingBuffer is a heap-allocated, double-ended circular buffer (Deque) storing
# 64-bit integer elements (values, pointers, object handles, character codes).
#
# It supports two operating modes:
#   1. Dynamic Auto-Grow Deque (flags = 0, default via nx_rb_new):
#      Automatically doubles its allocated capacity when full, providing
#      amortized O(1) push and pop at BOTH the head and tail.
#   2. Fixed-Capacity Circular Buffer (flags = 1, via nx_rb_new_fixed):
#      Maintains a bounded window of elements. When full, new insertions
#      overwrite the oldest elements, making it ideal for streaming logs,
#      terminal console scrollback, packet buffers, and audio sample mixing.
#
# Memory Layout (stored in a 48-byte descriptor struct on the heap):
#   offset 0:  buf_ptr       - pointer to raw element array (qword elements)
#   offset 8:  capacity      - total slots in buf_ptr (int64 >= 1)
#   offset 16: head          - physical index of front element (0 <= head < cap)
#   offset 24: len           - current number of live elements (0 <= len <= cap)
#   offset 32: flags         - 0 = auto-grow deque, 1 = fixed overwrite mode
#   offset 40: dropped_count - total items overwritten in fixed mode
#
# Element Indexing:
#   Logical index i (0-based) maps to physical slot: (head + i) % capacity
#   Logical index 0 is the FRONT element.
#   Logical index len - 1 is the BACK element.
#
# CALLING CONVENTION (all functions):
#   nx_i0 = ring buffer handle (descriptor pointer)
#   nx_i1 = argument 1 (value, capacity, or logical index)
#   nx_i2 = argument 2 (value for set)
#   nx_r0 = primary result (value, length, capacity, status)
#
# All internal variables use the `_rb_` prefix to guarantee zero collision
# with caller or library scope. Subroutines that call other ring buffer helpers
# (e.g. nx_rb_grow, nx_rb_rotate) use dedicated prefixes (_rb_grow_*, _rb_rot_*)
# to prevent cross-frame variable shadowing.
# ==============================================================================

# ------------------------------------------------------------------------------
# fn nx_rb_new : nx_r0 = new dynamic auto-grow RingBuffer with initial capacity nx_i0
# ------------------------------------------------------------------------------
fn nx_rb_new {
    let _rb_init_cap = nx_i0
    if _rb_init_cap < 4 {
        let _rb_init_cap = 4
    }
    let _rb_raw_bytes = _rb_init_cap * 8
    let _rb_raw = alloc _rb_raw_bytes
    let _rb_desc = alloc 48
    store64 [_rb_desc + 0] _rb_raw
    store64 [_rb_desc + 8] _rb_init_cap
    store64 [_rb_desc + 16] 0
    store64 [_rb_desc + 24] 0
    store64 [_rb_desc + 32] 0
    store64 [_rb_desc + 40] 0
    let nx_r0 = _rb_desc
}

# ------------------------------------------------------------------------------
# fn nx_rb_new_fixed : nx_r0 = new fixed-capacity RingBuffer with capacity nx_i0 (overwrite mode)
# ------------------------------------------------------------------------------
