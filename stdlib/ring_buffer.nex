# fn nx_rb_push_back : appends value nx_i1 to the BACK of RingBuffer nx_i0
# Returns: nx_r0 = 1 (inserted), 2 (inserted with overwrite in fixed mode)
# ------------------------------------------------------------------------------
fn nx_rb_push_back {
    let _rb_h = nx_i0
    let _rb_val = nx_i1
