# ------------------------------------------------------------------------------
# fn nx_rb_grow : internal growth helper, expands capacity to >= nx_i1
# ------------------------------------------------------------------------------
fn nx_rb_grow {
    let _rb_grow_h = nx_i0
    let _rb_grow_min_cap = nx_i1
    let _rb_grow_cur_cap = load64 [_rb_grow_h + 8]
    if _rb_grow_cur_cap < _rb_grow_min_cap {
        let _rb_grow_new_cap = _rb_grow_cur_cap * 2
        while _rb_grow_new_cap < _rb_grow_min_cap {
            let _rb_grow_new_cap = _rb_grow_new_cap * 2
        }
        let _rb_grow_bytes = _rb_grow_new_cap * 8
        let _rb_grow_new_buf = alloc _rb_grow_bytes
        let _rb_grow_old_buf = load64 [_rb_grow_h + 0]
        let _rb_grow_head = load64 [_rb_grow_h + 16]
        let _rb_grow_len = load64 [_rb_grow_h + 24]

        let _rb_grow_gi = 0
        while _rb_grow_gi < _rb_grow_len {
            let _rb_grow_phys = _rb_grow_head + _rb_grow_gi
            let _rb_grow_phys = _rb_grow_phys % _rb_grow_cur_cap
            let _rb_grow_v = load64 [_rb_grow_old_buf + _rb_grow_phys * 8]
            store64 [_rb_grow_new_buf + _rb_grow_gi * 8] _rb_grow_v
            let _rb_grow_gi = _rb_grow_gi + 1
