                call nx_rb_pop_back
                let _rb_rot_popped = nx_r0
                let nx_i0 = _rb_rot_h
                let nx_i1 = _rb_rot_popped
                call nx_rb_push_front
                let _rb_rot_steps = _rb_rot_steps - 1
            }
        } else if _rb_rot_k < 0 {
            let _rb_neg_k = 0 - _rb_rot_k
            let _rb_rot_steps = _rb_neg_k % _rb_rot_len
            while _rb_rot_steps > 0 {
                let nx_i0 = _rb_rot_h
                call nx_rb_pop_front
                let _rb_rot_popped = nx_r0
                let nx_i0 = _rb_rot_h
                let nx_i1 = _rb_rot_popped
                call nx_rb_push_back
                let _rb_rot_steps = _rb_rot_steps - 1
            }
        }
    }
    let nx_r0 = 1
}

# ------------------------------------------------------------------------------
# fn nx_rb_shrink_to_fit : reduces allocated buffer capacity to exact element count (min 4)
# ------------------------------------------------------------------------------
fn nx_rb_shrink_to_fit {
    let _rb_h = nx_i0
    let _rb_len = load64 [_rb_h + 24]
    let _rb_cap = load64 [_rb_h + 8]
    let _rb_target = _rb_len
    if _rb_target < 4 {
        let _rb_target = 4
    }
    if _rb_target < _rb_cap {
        let _rb_shrink_bytes = _rb_target * 8
        let _rb_new_buf = alloc _rb_shrink_bytes
        let _rb_old_buf = load64 [_rb_h + 0]
        let _rb_head = load64 [_rb_h + 16]

        let _rb_si = 0
        while _rb_si < _rb_len {
            let _rb_phys = _rb_head + _rb_si
            let _rb_phys = _rb_phys % _rb_cap
            let _rb_v = load64 [_rb_old_buf + _rb_phys * 8]
            store64 [_rb_new_buf + _rb_si * 8] _rb_v
            let _rb_si = _rb_si + 1
        }

        store64 [_rb_h + 0] _rb_new_buf
        store64 [_rb_h + 8] _rb_target
        store64 [_rb_h + 16] 0
    }
    let nx_r0 = 1
}
