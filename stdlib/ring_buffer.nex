            let _rb_buf = load64 [_rb_h + 0]
            let _rb_head = load64 [_rb_h + 16]
            store64 [_rb_buf + _rb_head * 8] _rb_val
            let _rb_new_head = _rb_head + 1
            let _rb_new_head = _rb_new_head % _rb_cap
            store64 [_rb_h + 16] _rb_new_head
            let _rb_drop = load64 [_rb_h + 40]
            let _rb_new_drop = _rb_drop + 1
            store64 [_rb_h + 40] _rb_new_drop
            let _rb_res = 2
        }
    } else {
        let _rb_buf = load64 [_rb_h + 0]
        let _rb_head = load64 [_rb_h + 16]
        let _rb_slot = _rb_head + _rb_len
        let _rb_slot = _rb_slot % _rb_cap
        store64 [_rb_buf + _rb_slot * 8] _rb_val
        let _rb_new_len = _rb_len + 1
        store64 [_rb_h + 24] _rb_new_len
    }
    let nx_r0 = _rb_res
