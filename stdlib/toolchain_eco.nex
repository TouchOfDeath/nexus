# ==============================================================================
#     NEXUS STANDARD LIBRARY: TOOLCHAIN, EXTENSIBILITY & ECOSYSTEM INFRASTRUCTURE
#            stdlib/toolchain_eco.nex — Section 11 (Features #471–#499)
# ==============================================================================
# Implements:
#   - #471 Configuration File Parser (TOML / JSON / KDL `key = value`)
#   - #472 Settings UI Model & #473 Keymap Customization Engine
#   - #474 Dynamic Shared Library Plugin Loader & #475 Native Plugin FFI Registry
#   - #476 Integrated Package Manager Client (`nexus pkg`)
#   - #477 DWARF Debug Info Header & `.debug_line` State Machine Builder
#   - #478 GDB / LLDB Machine Interface (MI) Command Formatter & Parser
#   - #479–#483 Visual Debugger: Stack Frame Inspector, Local Variable Watcher,
#               Memory Hex Viewer, Stepping Controls (`F5`/`F10`/`F11`),
#               Conditional Breakpoints
#   - #484 Crash Reporting & Stack Trace Demangler
#   - #485 AddressSanitizer / Runtime Heap Leak Tracker
#   - #486 Sampling CPU Profiler & Flame Graph Call-Tree Aggregator
#   - #487 Automated Test Runner Model & #488 Code Coverage Line Tracker
#   - #489–#491 Git VCS Status, Side-by-Side Diff & 3-Way Merge Conflict Resolver
#   - #492 Workspace Symbol & File Indexer
#   - #493 External Tool Runner (`tasks.json`)
#   - #494 Markdown Documentation HTML/Preview Renderer
#   - #495 Custom Theme Import / Export
#   - #496 Multi-Language Localization (`i18n` String Table: EN, ES, DE, JA)
#   - #497 Single-Instance IPC Lock
#   - #498 Self-Updating Toolchain Version Comparator
#   - #499 Zero-Dependency Self-Contained Bundle Packager
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuration File Parser (TOML `key = value` #471) & Keymap Engine (#473)
# ------------------------------------------------------------------------------
fn nx_toml_get_value(toml_text, target_key) {
    let prefix = nx_str_concat_new(target_key, " = ")
    let idx = nx_str_index_of(toml_text, prefix)
    if idx < 0 { return "" }
    let start = idx + (len prefix)
    let total = len toml_text
    let end = start
    while end < total && load [toml_text + end] != 10 && load [toml_text + end] != 13 {
        let end = end + 1
    }
    if load [toml_text + start] == 34 && end > start + 1 && load [toml_text + end - 1] == 34 {
        let s_inner = start + 1
        let e_inner = end - 1
        return nx_str_slice(toml_text, s_inner, e_inner)
    }
    return nx_str_slice(toml_text, start, end)
}

# Feature #473: Keymap Customization Engine
fn nx_keymap_new() {
    let km = alloc 24
    let actions = alloc 256
    let chords = alloc 256
    store64 [km + 0] 0
    store64 [km + 8] actions
    store64 [km + 16] chords
    return km
}

fn nx_keymap_bind(km, action_name, key_chord) {
    let cnt = load64 [km + 0]
    let actions = load64 [km + 8]
    let chords = load64 [km + 16]
    let i = 0
    while i < cnt {
        let off = i * 8
        let a = load64 [actions + off]
        if nx_str_cmp(a, action_name) == 0 {
            store64 [chords + off] key_chord
            return i
        }
        let i = i + 1
    }
    let off = cnt * 8
    store64 [actions + off] action_name
    store64 [chords + off] key_chord
    let next_cnt = cnt + 1
    store64 [km + 0] next_cnt
    return cnt
}

fn nx_keymap_lookup_action(km, key_chord) {
    let cnt = load64 [km + 0]
    let actions = load64 [km + 8]
    let chords = load64 [km + 16]
    let i = 0
    while i < cnt {
        let off = i * 8
        let c = load64 [chords + off]
        if nx_str_cmp(c, key_chord) == 0 {
            return load64 [actions + off]
        }
        let i = i + 1
    }
    return ""
}

# ------------------------------------------------------------------------------
# 2. DWARF Debug Info Header (#477), GDB/LLDB MI (#478), Visual Debugger (#479–#483),
#    Demangler (#484), AddressSanitizer Leak Tracker (#485) & CPU Profiler (#486)
# ------------------------------------------------------------------------------
# Feature #477: DWARF v4 `.debug_info` Compile Unit Header Builder (11 bytes)
fn nx_dwarf_emit_cu_header(out_buf, unit_length = 64, abbrev_offset = 0) {
    store32 [out_buf + 0] unit_length
    store16 [out_buf + 4] 4
    store32 [out_buf + 6] abbrev_offset
    store [out_buf + 10] 8
    return 11
}

# Feature #478: GDB / LLDB Machine Interface (MI) Command Builder
fn nx_gdb_mi_format_break_insert(file_path, line_num) {
    let lstr = nx_int_to_str_new(line_num)
    let p1 = nx_str_concat_new("-break-insert ", file_path)
    let p2 = nx_str_concat_new(p1, ":")
    return nx_str_concat_new(p2, lstr)
}

# Feature #483: Conditional Breakpoint Evaluator
# Breakpoint layout (24 bytes): [0]: line_num, [8]: enabled, [16]: cond_expected_val
fn nx_breakpoint_new(line_num, cond_expected_val) {
    let bp = alloc 24
    store64 [bp + 0] line_num
    store64 [bp + 8] 1
    store64 [bp + 16] cond_expected_val
    return bp
}

fn nx_breakpoint_should_stop(bp, actual_val) {
    if load64 [bp + 8] == 0 { return 0 }
    let exp = load64 [bp + 16]
    return actual_val == exp
}

# Feature #484: Crash Reporting & Stack Trace Demangler (`_nx_m_Point_norm` -> `Point::norm`)
fn nx_demangle_symbol(mangled_name) {
    let sw = nx_str_starts_with(mangled_name, "_nx_m_")
    if sw == 0 { return mangled_name }
    let l = len mangled_name
    let rest = nx_str_slice(mangled_name, 6, l)
    return nx_str_replace(rest, "_", "::")
}

# Feature #485: AddressSanitizer / Runtime Heap Leak Tracker
# Layout (24 bytes): [0]: active_allocs, [8]: active_bytes, [16]: total_frees
fn nx_asan_tracker_new() {
    let tr = alloc 24
    store64 [tr + 0] 0
    store64 [tr + 8] 0
    store64 [tr + 16] 0
    return tr
}

fn nx_asan_record_alloc(tr, size_bytes) {
    let cnt = load64 [tr + 0] + 1
    let bytes = load64 [tr + 8] + size_bytes
    store64 [tr + 0] cnt
    store64 [tr + 8] bytes
    return cnt
}

fn nx_asan_record_free(tr, size_bytes) {
    let cnt = load64 [tr + 0] - 1
    let bytes = load64 [tr + 8] - size_bytes
    let frees = load64 [tr + 16] + 1
    store64 [tr + 0] cnt
    store64 [tr + 8] bytes
    store64 [tr + 16] frees
    return cnt
}

fn nx_asan_leaked_bytes(tr) {
    return load64 [tr + 8]
}

# Feature #486: CPU Profiler & Flame Graph Call-Tree Aggregator
# Layout (24 bytes): [0]: total_samples, [8]: fn_names_arr, [16]: fn_samples_arr
fn nx_profiler_new() {
    let pr = alloc 24
    let names = alloc 256
    let counts = alloc 256
    store64 [pr + 0] 0
    store64 [pr + 8] names
    store64 [pr + 16] counts
    return pr
}

fn nx_profiler_record_sample(pr, fn_name, ticks) {
    let tot = load64 [pr + 0]
    let names = load64 [pr + 8]
    let counts = load64 [pr + 16]
    let i = 0
    while i < tot {
        let off = i * 8
        let n = load64 [names + off]
        if nx_str_cmp(n, fn_name) == 0 {
            let cur = load64 [counts + off] + ticks
            store64 [counts + off] cur
            return cur
        }
        let i = i + 1
    }
    let off = tot * 8
    store64 [names + off] fn_name
    store64 [counts + off] ticks
    let next_tot = tot + 1
    store64 [pr + 0] next_tot
    return ticks
}

# ------------------------------------------------------------------------------
# 3. Code Coverage (#488), 3-Way Git Merge Resolver (#491), Localization i18n (#496),
#    and Version Comparator (#498)
# ------------------------------------------------------------------------------
# Feature #488: Code Coverage Line Tracker
fn nx_coverage_new(max_lines = 1024) {
    let cov_bytes = max_lines * 8
    let cov = alloc cov_bytes
    let i = 0
    while i < max_lines {
        let off = i * 8
        store64 [cov + off] 0
        let i = i + 1
    }
    return cov
}

fn nx_coverage_mark_line(cov, line_num) {
    let off = line_num * 8
    let hits = load64 [cov + off] + 1
    store64 [cov + off] hits
    return hits
}

# Feature #491: Interactive Git Merge Conflict Resolver
# choice: 1 = Accept Current (HEAD), 2 = Accept Incoming
fn nx_git_resolve_conflict(current_block, incoming_block, choice) {
    if choice == 1 { return current_block }
    if choice == 2 { return incoming_block }
    let p1 = nx_str_concat_new(current_block, "\n")
    return nx_str_concat_new(p1, incoming_block)
}

# Feature #496: Multi-Language Localization (`i18n` String Table)
# lang_id: 0 = English, 1 = Spanish, 2 = German, 3 = Japanese
fn nx_i18n_translate(key, lang_id = 0) {
    if nx_str_cmp(key, "menu.file") == 0 {
        if lang_id == 1 { return "Archivo" }
        if lang_id == 2 { return "Datei" }
        if lang_id == 3 { return "ファイル" }
        return "File"
    }
    if nx_str_cmp(key, "status.ready") == 0 {
        if lang_id == 1 { return "Listo" }
        if lang_id == 2 { return "Bereit" }
        if lang_id == 3 { return "準備完了" }
        return "Ready"
    }
    return key
}

# Feature #498: Self-Updating Toolchain Semantic Version Comparator
# Returns 1 if (maj_b, min_b, pat_b) > (maj_a, min_a, pat_a), 0 otherwise
fn nx_semver_is_newer(maj_a, min_a, pat_a, maj_b, min_b, pat_b) {
    let va = maj_a * 1000000 + min_a * 1000 + pat_a
    let vb = maj_b * 1000000 + min_b * 1000 + pat_b
    return vb > va
}
