            let _hms_slot = 0
        }
        let _hms_probe = _hms_probe + 1
    }
    let nx_r0 = 0
}

# ------------------------------------------------------------------------------
# fn nx_hashmap_remove_str : removes string key nx_i1 from map nx_i0 (1 if removed)
# ------------------------------------------------------------------------------
fn nx_hashmap_remove_str {
    let _hms_map = nx_i0
    let _hms_key = nx_i1
    let _hms_cap = load64 [_hms_map + 24]
    let nx_i0 = _hms_key
    call nx_hash_str
    let _hms_slot = nx_r0 % _hms_cap
    let _hms_probe = 0
    let _hms_kp = load64 [_hms_map + 0]
    let _hms_sp = load64 [_hms_map + 32]
    while _hms_probe < _hms_cap {
        let _hms_st = load [_hms_sp + _hms_slot]
        if _hms_st == 0 {
            let nx_r0 = 0
            return
        }
        if _hms_st == 2 {
            let _hms_k = load64 [_hms_kp + _hms_slot * 8]
            let nx_i0 = _hms_k
            let nx_i1 = _hms_key
            call nx_str_cmp
            if nx_r0 == 0 {
                store [_hms_sp + _hms_slot] 3
                let _hms_c2 = load64 [_hms_map + 16]
                let _hms_c2 = _hms_c2 - 1
                store64 [_hms_map + 16] _hms_c2
                let nx_r0 = 1
                return
            }
        }
        let _hms_slot = _hms_slot + 1
        if _hms_slot >= _hms_cap {
            let _hms_slot = 0
        }
        let _hms_probe = _hms_probe + 1
    }
    let nx_r0 = 0
}

# ------------------------------------------------------------------------------
# fn nx_hashmap_len : nx_r0 = number of entries
# ------------------------------------------------------------------------------
fn nx_hashmap_len {
    let nx_r0 = load64 [nx_i0 + 16]
}

# ------------------------------------------------------------------------------
# fn nx_hashmap_cap : nx_r0 = capacity
# ------------------------------------------------------------------------------
fn nx_hashmap_cap {
    let nx_r0 = load64 [nx_i0 + 24]
}

# ------------------------------------------------------------------------------
# fn nx_hashmap_clear : remove all entries
# ------------------------------------------------------------------------------
fn nx_hashmap_clear {
    let _hmc_map = nx_i0
    let _hmc_cap = load64 [_hmc_map + 24]
    let _hmc_kp = load64 [_hmc_map + 0]
    let _hmc_sp = load64 [_hmc_map + 32]
    let _hmc_i = 0
    while _hmc_i < _hmc_cap {
        store64 [_hmc_kp + _hmc_i * 8] 0
        store [_hmc_sp + _hmc_i] 0
        let _hmc_i = _hmc_i + 1
    }
    store64 [_hmc_map + 16] 0
}
