# ==============================================================================
#                       NEXUS STANDARD LIBRARY: 8x8 ARCADE FONT
#                 stdlib/font.nex - Retro Bitmap Font & Text Engine
#      0% C - 0% libc - 0% Xlib - 100% Pure Machine Code Rendering
# ==============================================================================

# Font memory and state
let font_data = alloc 1024
let font_initialized = 0
let font_int_buf = alloc 32

# Input parameter registers
let draw_text_str = 0
let draw_text_x = 0
let draw_text_y = 0
let draw_text_scale = 1
let draw_text_r = 255
let draw_text_g = 255
let draw_text_b = 255

# Single character registers
let draw_char_code = 0
let draw_char_x = 0
let draw_char_y = 0

# Integer printing register
let draw_int_val = 0

# ------------------------------------------------------------------------------
# font_init: Decodes the embedded 8x8 font table (ASCII 32 to 127, 96 glyphs)
# ------------------------------------------------------------------------------
fn font_init {
    let hex_font = ""

    let f_hi = 0
    let f_out = 0
    while f_hi < 1536 {
        # High nibble
        let c1 = load [hex_font + f_hi]
        let n1 = 0
        if c1 >= 97 {
            let n1 = c1 - 87
        } else {
            let n1 = c1 - 48
        }

        # Low nibble
        let f_lo = f_hi + 1
        let c2 = load [hex_font + f_lo]
        let n2 = 0
        if c2 >= 97 {
            let n2 = c2 - 87
        } else {
            let n2 = c2 - 48
        }

        let f_byte = n1 * 16 + n2
        store [font_data + f_out] f_byte

        let f_hi = f_hi + 2
        let f_out = f_out + 1
    }
    let font_initialized = 1
}

# ------------------------------------------------------------------------------
# draw_char: Renders an 8x8 glyph scaled by draw_text_scale
# Inputs: draw_char_code, draw_char_x, draw_char_y, draw_text_scale,
#         draw_text_r, draw_text_g, draw_text_b
# ------------------------------------------------------------------------------
fn draw_char {
    if font_initialized == 0 {
        call font_init
    }

    # Space or non-printable ASCII: skip rendering
    if draw_char_code < 33 {
        return
    }
    if draw_char_code > 126 {
        return
    }

    let glyph_idx = draw_char_code - 32
    let glyph_off = glyph_idx * 8
    let glyph_ptr = font_data + glyph_off

    let f_row = 0
    while f_row < 8 {
        let row_byte = load [glyph_ptr + f_row]
        if row_byte > 0 {
            let bit_val = 1
            let f_col = 0
            while f_col < 8 {
                let bit_on = row_byte / bit_val
                let bit_on = bit_on % 2
                if bit_on == 1 {
                    let col_px = f_col * draw_text_scale
                    let row_px = f_row * draw_text_scale
                    let x11_rx = draw_char_x + col_px
                    let x11_ry = draw_char_y + row_px
                    let x11_rw = draw_text_scale
                    let x11_rh = draw_text_scale
                    let x11_r = draw_text_r
                    let x11_g = draw_text_g
                    let x11_b = draw_text_b
                    call x11_fill_rect
                }
                let bit_val = bit_val * 2
                let f_col = f_col + 1
            }
        }
        let f_row = f_row + 1
    }
}

# ------------------------------------------------------------------------------
# draw_text: Renders a null-terminated ASCII string
# Inputs: draw_text_str, draw_text_x, draw_text_y, draw_text_scale,
#         draw_text_r, draw_text_g, draw_text_b
# ------------------------------------------------------------------------------
fn draw_text {
    if font_initialized == 0 {
        call font_init
    }

    let cur_tx = draw_text_x
    let cur_ty = draw_text_y
    let char_adv = 8 * draw_text_scale
    let line_adv = 10 * draw_text_scale

    let s_idx = 0
    let parsing_text = 1
    while parsing_text == 1 {
        let ch = load [draw_text_str + s_idx]
        if ch == 0 {
            let parsing_text = 0
        } else if ch == 10 {
            let cur_tx = draw_text_x
            let cur_ty = cur_ty + line_adv
            let s_idx = s_idx + 1
        } else {
            let draw_char_code = ch
            let draw_char_x = cur_tx
            let draw_char_y = cur_ty
            call draw_char
            let cur_tx = cur_tx + char_adv
            let s_idx = s_idx + 1
        }
    }
}

# ------------------------------------------------------------------------------
# draw_int: Formats a 64-bit integer into ASCII and renders it on screen
# Inputs: draw_int_val, draw_text_x, draw_text_y, draw_text_scale,
#         draw_text_r, draw_text_g, draw_text_b
# ------------------------------------------------------------------------------
fn draw_int {
    let iv = draw_int_val
    let is_neg = 0
    if iv < 0 {
        let is_neg = 1
        let iv = 0 - iv
    }

    let temp_v = iv
    let num_digits = 0
    if temp_v == 0 {
        let num_digits = 1
    }
    while temp_v > 0 {
        let num_digits = num_digits + 1
        let temp_v = temp_v / 10
    }

    let total_len = num_digits
    if is_neg == 1 {
        let total_len = total_len + 1
    }

    store [font_int_buf + total_len] 0

    let pos = total_len - 1
    if iv == 0 {
        store [font_int_buf + pos] 48
    }
    while iv > 0 {
        let rem = iv % 10
        let dig_char = rem + 48
        store [font_int_buf + pos] dig_char
        let pos = pos - 1
        let iv = iv / 10
    }
    if is_neg == 1 {
        store [font_int_buf + 0] 45
    }

    let draw_text_str = font_int_buf
    call draw_text
}
