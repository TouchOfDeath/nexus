# ==============================================================================
#                 NEXUS STANDARD LIBRARY - MODULE: strings.nex
#    Null-terminated string + number conversion utilities for NEXUS programs
# ==============================================================================
#
# Strings in NEXUS are pointers to null-terminated bytes. A string variable
# obtained from a literal ('let s = "abc"') or from a heap buffer both work.
#
# CALLING CONVENTION: see math.nex header.
#   nx_i0/nx_i1/nx_i2 = string pointers, char codes, or buffer pointers
#   Char codes are ASCII: 'A' = 65, 'a' = 97, '0' = 48, '-' = 45

# ------------------------------------------------------------------------------
# fn nx_str_len : nx_r0 = byte length of string nx_i0 (excluding terminator)
# ------------------------------------------------------------------------------
fn nx_str_len {
    let s0 = nx_i0
    let nx_r0 = 0
    let s1 = load [s0 + 0]
    while s1 != 0 {
        let nx_r0 = nx_r0 + 1
        let s1 = load [s0 + nx_r0]
    }
}

# ------------------------------------------------------------------------------
# fn nx_str_copy : copy string nx_i0 into buffer nx_i1 (including terminator)
#                  The destination buffer must be large enough.
# ------------------------------------------------------------------------------
fn nx_str_copy {
    let s0 = nx_i0
    let s1 = nx_i1
    let s2 = 0
    let s3 = load [s0 + 0]
    while s3 != 0 {
        store [s1 + s2] s3
        let s2 = s2 + 1
        let s3 = load [s0 + s2]
    }
    store [s1 + s2] 0
}

# ------------------------------------------------------------------------------
# fn nx_str_cmp : compare strings nx_i0 and nx_i1 byte-wise
#                 nx_r0 = -1 if nx_i0 < nx_i1, 0 if equal, 1 if nx_i0 > nx_i1
# ------------------------------------------------------------------------------
fn nx_str_cmp {
    let s0 = nx_i0
    let s1 = nx_i1
    let nx_r0 = 0
    let s5 = 1
    let s2 = 0
    while s5 == 1 {
        let s3 = load [s0 + s2]
        let s4 = load [s1 + s2]
        if s3 < s4 {
            let nx_r0 = 0 - 1
            let s5 = 0
        }
        if s3 > s4 {
            let nx_r0 = 1
            let s5 = 0
        }
        if s3 == 0 {
            if s4 == 0 {
                let nx_r0 = 0
                let s5 = 0
            }
        }
        let s2 = s2 + 1
    }
}

# ------------------------------------------------------------------------------
# fn nx_str_concat : dst(nx_i2) = string nx_i0 + string nx_i1
#                    Destination buffer must hold len(a)+len(b)+1 bytes.
# ------------------------------------------------------------------------------
fn nx_str_concat {
    let s0 = nx_i0
    let s1 = nx_i1
    let s6 = nx_i2
    let s2 = 0
    let s3 = load [s0 + 0]
    while s3 != 0 {
        store [s6 + s2] s3
        let s2 = s2 + 1
        let s3 = load [s0 + s2]
    }
    let s4 = 0
    let s3 = load [s1 + 0]
    while s3 != 0 {
        store [s6 + s2] s3
        let s2 = s2 + 1
        let s4 = s4 + 1
        let s3 = load [s1 + s4]
    }
    store [s6 + s2] 0
}

# ------------------------------------------------------------------------------
# fn nx_str_chr : nx_r0 = first index of char nx_i1 in string nx_i0, else -1
# ------------------------------------------------------------------------------
fn nx_str_chr {
    let s0 = nx_i0
    let s1 = nx_i1
    let nx_r0 = 0 - 1
    let s2 = 0
    let s3 = load [s0 + 0]
    while s3 != 0 {
        if nx_r0 < 0 {
            if s3 == s1 {
                let nx_r0 = s2
            }
        }
        let s2 = s2 + 1
        let s3 = load [s0 + s2]
    }
}

# ------------------------------------------------------------------------------
# fn nx_str_starts_with : nx_r0 = 1 if string nx_i0 begins with prefix nx_i1
#                         (an empty prefix always matches)
# ------------------------------------------------------------------------------
fn nx_str_starts_with {
    let s0 = nx_i0
    let s1 = nx_i1
    let nx_r0 = 1
    let s2 = 0
    let s5 = 1
    while s5 == 1 {
        let s3 = load [s1 + s2]
        if s3 == 0 {
            let s5 = 0
        } else {
            let s4 = load [s0 + s2]
            if s4 == 0 {
                let nx_r0 = 0
                let s5 = 0
            } else {
                if s4 != s3 {
                    let nx_r0 = 0
                    let s5 = 0
                } else {
                    let s2 = s2 + 1
                }
            }
        }
    }
}

# ------------------------------------------------------------------------------
# fn nx_str_ends_with : nx_r0 = 1 if string nx_i0 ends with suffix nx_i1
#                       (an empty suffix always matches)
# ------------------------------------------------------------------------------
fn nx_str_ends_with {
    let s0 = nx_i0
    let s1 = nx_i1
    let s2 = 0
    let s3 = load [s0 + 0]
    while s3 != 0 {
        let s2 = s2 + 1
        let s3 = load [s0 + s2]
    }
    let s4 = 0
    let s5 = load [s1 + 0]
    while s5 != 0 {
        let s4 = s4 + 1
        let s5 = load [s1 + s4]
    }
    let nx_r0 = 1
    if s4 > s2 {
        let nx_r0 = 0
    } else {
        let s6 = s2 - s4
        let s7 = 0
        while s7 < s4 {
            let s8 = s6 + s7
            let s9 = s0 + s8
            let s10 = load [s9]
            let s11 = load [s1 + s7]
            if s10 != s11 {
                let nx_r0 = 0
            }
            let s7 = s7 + 1
        }
    }
}

# ------------------------------------------------------------------------------
# fn nx_str_trim : copy nx_i0 to nx_i1 without leading/trailing ASCII whitespace
#                  Returns trimmed byte length in nx_r0. Supports space and
#                  ASCII control whitespace TAB through CR (9..13).
#                  Destination must hold the source length plus one byte.
# ------------------------------------------------------------------------------
fn nx_str_trim {
    let s0 = nx_i0
    let s1 = nx_i1
    let s2 = 0
    let s3 = load [s0 + 0]
    while s3 != 0 {
        let s2 = s2 + 1
        let s3 = load [s0 + s2]
    }

    let s4 = 0
    let s9 = 1
    while s9 == 1 {
        if s4 < s2 {
            let s6 = load [s0 + s4]
            let s7 = 0
            if s6 == 32 {
                let s7 = 1
            }
            if s6 == 9 {
                let s7 = 1
            }
            if s6 == 10 {
                let s7 = 1
            }
            if s6 == 11 {
                let s7 = 1
            }
            if s6 == 12 {
                let s7 = 1
            }
            if s6 == 13 {
                let s7 = 1
            }
            if s7 == 1 {
                let s4 = s4 + 1
            } else {
                let s9 = 0
            }
        } else {
            let s9 = 0
        }
    }

    let s9 = 1
    while s9 == 1 {
        if s2 > s4 {
            let s8 = s2 - 1
            let s6 = load [s0 + s8]
            let s7 = 0
            if s6 == 32 {
                let s7 = 1
            }
            if s6 == 9 {
                let s7 = 1
            }
            if s6 == 10 {
                let s7 = 1
            }
            if s6 == 11 {
                let s7 = 1
            }
            if s6 == 12 {
                let s7 = 1
            }
            if s6 == 13 {
                let s7 = 1
            }
            if s7 == 1 {
                let s2 = s2 - 1
            } else {
                let s9 = 0
            }
        } else {
            let s9 = 0
        }
    }

    let s5 = 0
    while s4 < s2 {
        let s6 = load [s0 + s4]
        store [s1 + s5] s6
        let s4 = s4 + 1
        let s5 = s5 + 1
    }
    store [s1 + s5] 0
    let nx_r0 = s5
}

# ------------------------------------------------------------------------------
# fn nx_str_normalize_newlines : copy nx_i0 to nx_i1 with CRLF/CR changed to LF
#                                Existing LF bytes are preserved. Returns the
#                                normalized byte length in nx_r0. Source and
#                                destination may be the same mutable buffer.
#                                Destination must hold source length plus 1.
# ------------------------------------------------------------------------------
fn nx_str_normalize_newlines {
    let s0 = nx_i0
    let s1 = nx_i1
    let s2 = 0
    let s3 = 0
    let s4 = load [s0 + s2]
    while s4 != 0 {
        if s4 == 13 {
            store [s1 + s3] 10
            let s3 = s3 + 1
            let s2 = s2 + 1
            let s4 = load [s0 + s2]
            if s4 == 10 {
                let s2 = s2 + 1
                let s4 = load [s0 + s2]
            }
        } else {
            store [s1 + s3] s4
            let s3 = s3 + 1
            let s2 = s2 + 1
            let s4 = load [s0 + s2]
        }
    }
    store [s1 + s3] 0
    let nx_r0 = s3
}

# ------------------------------------------------------------------------------
# fn nx_str_escape_literal : write a quoted, escaped NEXUS string literal from
#                            nx_i0 into nx_i1. Returns output byte length,
#                            excluding the terminator. Destination needs at
#                            least 4 * input length + 3 bytes. NUL terminates
#                            input, so embedded NUL bytes are not representable.
# ------------------------------------------------------------------------------
fn nx_str_escape_literal {
    let s0 = nx_i0
    let s1 = nx_i1
    let s2 = 0
    let s3 = 0
    store [s1 + s3] 34
    let s3 = s3 + 1
    let s4 = load [s0 + s2]
    while s4 != 0 {
        if s4 == 10 {
            store [s1 + s3] 92
            let s3 = s3 + 1
            store [s1 + s3] 110
            let s3 = s3 + 1
        } else if s4 == 13 {
            store [s1 + s3] 92
            let s3 = s3 + 1
            store [s1 + s3] 114
            let s3 = s3 + 1
        } else if s4 == 9 {
            store [s1 + s3] 92
            let s3 = s3 + 1
            store [s1 + s3] 116
            let s3 = s3 + 1
        } else if s4 == 92 {
            store [s1 + s3] 92
            let s3 = s3 + 1
            store [s1 + s3] 92
            let s3 = s3 + 1
        } else if s4 == 34 {
            store [s1 + s3] 92
            let s3 = s3 + 1
            store [s1 + s3] 34
            let s3 = s3 + 1
        } else {
            let s5 = 0
            if s4 < 32 {
                let s5 = 1
            }
            if s4 > 126 {
                let s5 = 1
            }
            if s5 == 1 {
                store [s1 + s3] 92
                let s3 = s3 + 1
                store [s1 + s3] 120
                let s3 = s3 + 1
                let s6 = s4 / 16
                let s7 = s4 % 16
                if s6 < 10 {
                    let s6 = s6 + 48
                } else {
                    let s6 = s6 + 55
                }
                if s7 < 10 {
                    let s7 = s7 + 48
                } else {
                    let s7 = s7 + 55
                }
                store [s1 + s3] s6
                let s3 = s3 + 1
                store [s1 + s3] s7
                let s3 = s3 + 1
            } else {
                store [s1 + s3] s4
                let s3 = s3 + 1
            }
        }
        let s2 = s2 + 1
        let s4 = load [s0 + s2]
    }
    store [s1 + s3] 34
    let s3 = s3 + 1
    store [s1 + s3] 0
    let nx_r0 = s3
}

# ------------------------------------------------------------------------------
# fn nx_str_to_int : nx_r0 = decimal integer parsed from string nx_i0
#                    Accepts an optional leading '-'. Non-digit characters
#                    are ignored. Stops at the null terminator.
# ------------------------------------------------------------------------------
fn nx_str_to_int {
    let s0 = nx_i0
    let nx_r0 = 0
    let s1 = 0
    let s2 = 0
    let s3 = load [s0 + 0]
    while s3 != 0 {
        if s3 >= 48 {
            if s3 <= 57 {
                let s4 = s3 - 48
                let nx_r0 = nx_r0 * 10
                let nx_r0 = nx_r0 + s4
            }
        }
        if s3 == 45 {
            let s2 = 1
        }
        let s1 = s1 + 1
        let s3 = load [s0 + s1]
    }
    if s2 == 1 {
        let nx_r0 = 0 - nx_r0
    }
}

# ------------------------------------------------------------------------------
# fn nx_int_to_str : write decimal nx_i0 into buffer nx_i1, null-terminated
#                    Buffer must hold at least 12 bytes (sign + 10 digits + 0).
# ------------------------------------------------------------------------------
fn nx_int_to_str {
    let s0 = nx_i0
    let s1 = nx_i1
    let s2 = 0
    let s3 = 0
    if s0 < 0 {
        let s3 = 1
        let s0 = 0 - s0
    }
    if s0 == 0 {
        store [s1 + 0] 48
        let s2 = 1
    }
    while s0 > 0 {
        let s4 = s0 % 10
        let s4 = s4 + 48
        store [s1 + s2] s4
        let s2 = s2 + 1
        let s0 = s0 / 10
    }
    if s3 == 1 {
        store [s1 + s2] 45
        let s2 = s2 + 1
    }
    let s5 = 0
    let s6 = s2 - 1
    while s5 < s6 {
        let s7 = load [s1 + s5]
        let s4 = load [s1 + s6]
        store [s1 + s5] s4
        store [s1 + s6] s7
        let s5 = s5 + 1
        let s6 = s6 - 1
    }
    store [s1 + s2] 0
}

# ==============================================================================
#                       SPLIT / JOIN (Features #133 & #134)
# ==============================================================================

# ------------------------------------------------------------------------------
# fn nx_str_split : splits string nx_i0 at every occurrence of delimiter byte
#                   nx_i1. Returns a freshly allocated qword array A where
#                   A[0] = token count N and A[1..N] = pointers to
#                   null-terminated token copies inside one freshly allocated
#                   buffer. The empty string yields one empty token.
#                   Consecutive delimiters produce empty tokens; leading and
#                   trailing delimiters are honored ("a,b," -> 3 tokens).
# ------------------------------------------------------------------------------
fn nx_str_split {
    let _spl_str = nx_i0
    let _spl_delim = nx_i1

    # source length
    let _spl_len = 0
    let _spl_c = load [_spl_str + 0]
    while _spl_c != 0 {
        let _spl_len = _spl_len + 1
        let _spl_c = load [_spl_str + _spl_len]
    }

    # pass 1: count tokens = delimiters + 1
    let _spl_n = 1
    let _spl_i = 0
    while _spl_i < _spl_len {
        let _spl_c = load [_spl_str + _spl_i]
        if _spl_c == _spl_delim {
            let _spl_n = _spl_n + 1
        }
        let _spl_i = _spl_i + 1
    }

    # allocate token copy buffer and result array
    let _spl_buf_bytes = _spl_len + _spl_n + 1
    let _spl_buf = alloc _spl_buf_bytes
    let _spl_arr_bytes = _spl_n + 1
    let _spl_arr_bytes = _spl_arr_bytes * 8
    let _spl_arr = alloc _spl_arr_bytes
    store64 [_spl_arr + 0] _spl_n

    # pass 2: copy tokens, recording start pointers
    # token 1 starts at the buffer base
    let _spl_w = 0
    let _spl_tok = 1
    let _spl_tok_idx = _spl_tok * 8
    store64 [_spl_arr + _spl_tok_idx] _spl_buf
    let _spl_i = 0
    while _spl_i < _spl_len {
        let _spl_c = load [_spl_str + _spl_i]
        if _spl_c == _spl_delim {
            store [_spl_buf + _spl_w] 0
            let _spl_w = _spl_w + 1
            let _spl_tok = _spl_tok + 1
            let _spl_tok_idx = _spl_tok * 8
            let _spl_start = _spl_buf + _spl_w
            store64 [_spl_arr + _spl_tok_idx] _spl_start
        } else {
            store [_spl_buf + _spl_w] _spl_c
            let _spl_w = _spl_w + 1
        }
        let _spl_i = _spl_i + 1
    }
    store [_spl_buf + _spl_w] 0
    let nx_r0 = _spl_arr
}

# ------------------------------------------------------------------------------
# fn nx_str_join : concatenates the nx_i2 strings stored in qword array nx_i0
#                  (element k at [arr + k * 8]) with separator string nx_i1
#                  between adjacent elements. Returns a freshly allocated
#                  null-terminated string. count <= 0 yields an empty string.
# ------------------------------------------------------------------------------
fn nx_str_join {
    let _jn_arr = nx_i0
    let _jn_sep = nx_i1
    let _jn_count = nx_i2

    # separator length
    let _jn_sep_len = 0
    let _jn_sc = load [_jn_sep + 0]
    while _jn_sc != 0 {
        let _jn_sep_len = _jn_sep_len + 1
        let _jn_sc = load [_jn_sep + _jn_sep_len]
    }

    # total length = sum of element lengths + separators between
    let _jn_total = 0
    let _jn_k = 0
    while _jn_k < _jn_count {
        let _jn_k8 = _jn_k * 8
        let _jn_elem = load64 [_jn_arr + _jn_k8]
        let _jn_ei = 0
        let _jn_ec = load [_jn_elem + _jn_ei]
        while _jn_ec != 0 {
            let _jn_total = _jn_total + 1
            let _jn_ei = _jn_ei + 1
            let _jn_ec = load [_jn_elem + _jn_ei]
        }
        let _jn_k = _jn_k + 1
    }
    if _jn_count > 1 {
        let _jn_seps = _jn_count - 1
        let _jn_seps = _jn_seps * _jn_sep_len
        let _jn_total = _jn_total + _jn_seps
    }

    # allocate total bytes plus the NUL terminator (alloc 0 is invalid)
    let _jn_alloc_sz = _jn_total + 1
    let _jn_out = alloc _jn_alloc_sz

    # second pass: copy elements and separators
    let _jn_w = 0
    let _jn_k = 0
    while _jn_k < _jn_count {
        if _jn_k > 0 {
            let _jn_s = 0
            while _jn_s < _jn_sep_len {
                let _jn_c = load [_jn_sep + _jn_s]
                store [_jn_out + _jn_w] _jn_c
                let _jn_w = _jn_w + 1
                let _jn_s = _jn_s + 1
            }
        }
        let _jn_k8 = _jn_k * 8
        let _jn_elem = load64 [_jn_arr + _jn_k8]
        let _jn_ei = 0
        let _jn_ec = load [_jn_elem + 0]
        while _jn_ec != 0 {
            store [_jn_out + _jn_w] _jn_ec
            let _jn_w = _jn_w + 1
            let _jn_ei = _jn_ei + 1
            let _jn_ec = load [_jn_elem + _jn_ei]
        }
        let _jn_k = _jn_k + 1
    }
    store [_jn_out + _jn_w] 0
    let nx_r0 = _jn_out
}
# ==============================================================================
#            CASE CONVERSION, PADDING, REPLACE & LEVENSHTEIN (#135-#139)
# ==============================================================================

# ------------------------------------------------------------------------------
# fn nx_str_to_upper : copy string nx_i0 to buffer nx_i1 converting ASCII 'a'..'z'
#                      (97..122) to 'A'..'Z' (65..90). May operate in-place
#                      (nx_i0 == nx_i1). Returns byte length in nx_r0.
# ------------------------------------------------------------------------------
fn nx_str_to_upper {
    let _up_src = nx_i0
    let _up_dst = nx_i1
    let _up_i = 0
    let _up_c = load [_up_src + 0]
    while _up_c != 0 {
        if _up_c >= 97 {
            if _up_c <= 122 {
                let _up_c = _up_c - 32
            }
        }
        store [_up_dst + _up_i] _up_c
        let _up_i = _up_i + 1
        let _up_c = load [_up_src + _up_i]
    }
    store [_up_dst + _up_i] 0
    let nx_r0 = _up_i
}

# ------------------------------------------------------------------------------
# fn nx_str_to_lower : copy string nx_i0 to buffer nx_i1 converting ASCII 'A'..'Z'
#                      (65..90) to 'a'..'z' (97..122). May operate in-place
#                      (nx_i0 == nx_i1). Returns byte length in nx_r0.
# ------------------------------------------------------------------------------
fn nx_str_to_lower {
    let _lo_src = nx_i0
    let _lo_dst = nx_i1
    let _lo_i = 0
    let _lo_c = load [_lo_src + 0]
    while _lo_c != 0 {
        if _lo_c >= 65 {
            if _lo_c <= 90 {
                let _lo_c = _lo_c + 32
            }
        }
        store [_lo_dst + _lo_i] _lo_c
        let _lo_i = _lo_i + 1
        let _lo_c = load [_lo_src + _lo_i]
    }
    store [_lo_dst + _lo_i] 0
    let nx_r0 = _lo_i
}

# ------------------------------------------------------------------------------
# fn nx_str_pad_left : return a freshly allocated string containing nx_i0
#                      left-padded to width nx_i1 with fill byte nx_i2.
#                      If len(src) >= width, returns a fresh copy of src.
# ------------------------------------------------------------------------------
fn nx_str_pad_left {
    let _pl_src = nx_i0
    let _pl_width = nx_i1
    let _pl_fill = nx_i2
    if _pl_fill == 0 {
        let _pl_fill = 32
    }
    let _pl_len = 0
    let _pl_c = load [_pl_src + 0]
    while _pl_c != 0 {
        let _pl_len = _pl_len + 1
        let _pl_c = load [_pl_src + _pl_len]
    }
    let _pl_out_len = _pl_len
    if _pl_width > _pl_len {
        let _pl_out_len = _pl_width
    }
    let _pl_alloc = _pl_out_len + 1
    let _pl_out = alloc _pl_alloc
    let _pl_pad = _pl_out_len - _pl_len
    let _pl_i = 0
    while _pl_i < _pl_pad {
        store [_pl_out + _pl_i] _pl_fill
        let _pl_i = _pl_i + 1
    }
    let _pl_j = 0
    while _pl_j < _pl_len {
        let _pl_c = load [_pl_src + _pl_j]
        let _pl_dst_idx = _pl_pad + _pl_j
        store [_pl_out + _pl_dst_idx] _pl_c
        let _pl_j = _pl_j + 1
    }
    store [_pl_out + _pl_out_len] 0
    let nx_r0 = _pl_out
}

# ------------------------------------------------------------------------------
# fn nx_str_pad_right : return a freshly allocated string containing nx_i0
#                       right-padded to width nx_i1 with fill byte nx_i2.
#                       If len(src) >= width, returns a fresh copy of src.
# ------------------------------------------------------------------------------
fn nx_str_pad_right {
    let _pr_src = nx_i0
    let _pr_width = nx_i1
    let _pr_fill = nx_i2
    if _pr_fill == 0 {
        let _pr_fill = 32
    }
    let _pr_len = 0
    let _pr_c = load [_pr_src + 0]
    while _pr_c != 0 {
        let _pr_len = _pr_len + 1
        let _pr_c = load [_pr_src + _pr_len]
    }
    let _pr_out_len = _pr_len
    if _pr_width > _pr_len {
        let _pr_out_len = _pr_width
    }
    let _pr_alloc = _pr_out_len + 1
    let _pr_out = alloc _pr_alloc
    let _pr_i = 0
    while _pr_i < _pr_len {
        let _pr_c = load [_pr_src + _pr_i]
        store [_pr_out + _pr_i] _pr_c
        let _pr_i = _pr_i + 1
    }
    while _pr_i < _pr_out_len {
        store [_pr_out + _pr_i] _pr_fill
        let _pr_i = _pr_i + 1
    }
    store [_pr_out + _pr_out_len] 0
    let nx_r0 = _pr_out
}

# ------------------------------------------------------------------------------
# fn nx_str_index_of : nx_r0 = first byte index of substring nx_i1 in nx_i0,
#                      or -1 if not found. Empty needle returns 0.
# ------------------------------------------------------------------------------
fn nx_str_index_of {
    let _io_hay = nx_i0
    let _io_ndl = nx_i1
    let _io_n = 0
    let _io_c = load [_io_hay + 0]
    while _io_c != 0 {
        let _io_n = _io_n + 1
        let _io_c = load [_io_hay + _io_n]
    }
    let _io_m = 0
    let _io_c = load [_io_ndl + 0]
    while _io_c != 0 {
        let _io_m = _io_m + 1
        let _io_c = load [_io_ndl + _io_m]
    }
    if _io_m == 0 {
        let nx_r0 = 0
    } else if _io_m > _io_n {
        let nx_r0 = 0 - 1
    } else {
        let nx_r0 = 0 - 1
        let _io_lim = _io_n - _io_m
        let _io_i = 0
        while _io_i <= _io_lim {
            if nx_r0 < 0 {
                let _io_ok = 1
                let _io_j = 0
                while _io_j < _io_m {
                    let _io_hi = _io_i + _io_j
                    let _io_hc = load [_io_hay + _io_hi]
                    let _io_nc = load [_io_ndl + _io_j]
                    if _io_hc != _io_nc {
                        let _io_ok = 0
                        let _io_j = _io_m
                    } else {
                        let _io_j = _io_j + 1
                    }
                }
                if _io_ok == 1 {
                    let nx_r0 = _io_i
                }
            }
            let _io_i = _io_i + 1
        }
    }
}

# ------------------------------------------------------------------------------
# fn nx_str_contains : nx_r0 = 1 if substring nx_i1 occurs in nx_i0, else 0
# ------------------------------------------------------------------------------
fn nx_str_contains {
    call nx_str_index_of
    if nx_r0 >= 0 {
        let nx_r0 = 1
    } else {
        let nx_r0 = 0
    }
}

# ------------------------------------------------------------------------------
# fn nx_str_replace : return a freshly allocated string with all non-overlapping
#                     occurrences of substring nx_i1 in nx_i0 replaced by nx_i2.
#                     If old_sub (nx_i1) is empty, returns a copy of src.
# ------------------------------------------------------------------------------
fn nx_str_replace {
    let _rp_src = nx_i0
    let _rp_old = nx_i1
    let _rp_new = nx_i2

    let _rp_slen = 0
    let _rp_c = load [_rp_src + 0]
    while _rp_c != 0 {
        let _rp_slen = _rp_slen + 1
        let _rp_c = load [_rp_src + _rp_slen]
    }
    let _rp_olen = 0
    let _rp_c = load [_rp_old + 0]
    while _rp_c != 0 {
        let _rp_olen = _rp_olen + 1
        let _rp_c = load [_rp_old + _rp_olen]
    }
    let _rp_nlen = 0
    let _rp_c = load [_rp_new + 0]
    while _rp_c != 0 {
        let _rp_nlen = _rp_nlen + 1
        let _rp_c = load [_rp_new + _rp_nlen]
    }

    if _rp_olen == 0 {
        let _rp_alloc = _rp_slen + 1
        let _rp_out = alloc _rp_alloc
        let _rp_i = 0
        while _rp_i < _rp_slen {
            let _rp_c = load [_rp_src + _rp_i]
            store [_rp_out + _rp_i] _rp_c
            let _rp_i = _rp_i + 1
        }
        store [_rp_out + _rp_slen] 0
        let nx_r0 = _rp_out
    } else {
        # pass 1: count non-overlapping occurrences
        let _rp_cnt = 0
        let _rp_i = 0
        while _rp_i < _rp_slen {
            let _rp_rem = _rp_slen - _rp_i
            if _rp_rem >= _rp_olen {
                let _rp_match = 1
                let _rp_j = 0
                while _rp_j < _rp_olen {
                    let _rp_si = _rp_i + _rp_j
                    let _rp_sc = load [_rp_src + _rp_si]
                    let _rp_oc = load [_rp_old + _rp_j]
                    if _rp_sc != _rp_oc {
                        let _rp_match = 0
                        let _rp_j = _rp_olen
                    } else {
                        let _rp_j = _rp_j + 1
                    }
                }
                if _rp_match == 1 {
                    let _rp_cnt = _rp_cnt + 1
                    let _rp_i = _rp_i + _rp_olen
                } else {
                    let _rp_i = _rp_i + 1
                }
            } else {
                let _rp_i = _rp_i + 1
            }
        }

        let _rp_diff = _rp_nlen - _rp_olen
        let _rp_delta = _rp_cnt * _rp_diff
        let _rp_out_len = _rp_slen + _rp_delta
        let _rp_alloc = _rp_out_len + 1
        let _rp_out = alloc _rp_alloc

        # pass 2: emit replaced output
        let _rp_i = 0
        let _rp_w = 0
        while _rp_i < _rp_slen {
            let _rp_rem = _rp_slen - _rp_i
            let _rp_match = 0
            if _rp_rem >= _rp_olen {
                let _rp_match = 1
                let _rp_j = 0
                while _rp_j < _rp_olen {
                    let _rp_si = _rp_i + _rp_j
                    let _rp_sc = load [_rp_src + _rp_si]
                    let _rp_oc = load [_rp_old + _rp_j]
                    if _rp_sc != _rp_oc {
                        let _rp_match = 0
                        let _rp_j = _rp_olen
                    } else {
                        let _rp_j = _rp_j + 1
                    }
                }
            }
            if _rp_match == 1 {
                let _rp_k = 0
                while _rp_k < _rp_nlen {
                    let _rp_nc = load [_rp_new + _rp_k]
                    store [_rp_out + _rp_w] _rp_nc
                    let _rp_w = _rp_w + 1
                    let _rp_k = _rp_k + 1
                }
                let _rp_i = _rp_i + _rp_olen
            } else {
                let _rp_sc = load [_rp_src + _rp_i]
                store [_rp_out + _rp_w] _rp_sc
                let _rp_w = _rp_w + 1
                let _rp_i = _rp_i + 1
            }
        }
        store [_rp_out + _rp_w] 0
        let nx_r0 = _rp_out
    }
}

# ------------------------------------------------------------------------------
# fn nx_str_levenshtein : compute Wagner-Fischer Levenshtein edit distance
#                         between strings nx_i0 and nx_i1 in O(min(N,M)) space
#                         (two rolling rows). Returns edit distance in nx_r0.
# ------------------------------------------------------------------------------
fn nx_str_levenshtein {
    let _lv_s1 = nx_i0
    let _lv_s2 = nx_i1
    let _lv_n = 0
    let _lv_c = load [_lv_s1 + 0]
    while _lv_c != 0 {
        let _lv_n = _lv_n + 1
        let _lv_c = load [_lv_s1 + _lv_n]
    }
    let _lv_m = 0
    let _lv_c = load [_lv_s2 + 0]
    while _lv_c != 0 {
        let _lv_m = _lv_m + 1
        let _lv_c = load [_lv_s2 + _lv_m]
    }
    if _lv_n == 0 {
        let nx_r0 = _lv_m
    } else if _lv_m == 0 {
        let nx_r0 = _lv_n
    } else {
        let _lv_cols = _lv_m + 1
        let _lv_row_bytes = _lv_cols * 8
        let _lv_prev = alloc _lv_row_bytes
        let _lv_curr = alloc _lv_row_bytes
        let _lv_j = 0
        while _lv_j <= _lv_m {
            let _lv_j8 = _lv_j * 8
            store64 [_lv_prev + _lv_j8] _lv_j
            let _lv_j = _lv_j + 1
        }
        let _lv_i = 1
        while _lv_i <= _lv_n {
            let _lv_i_m1 = _lv_i - 1
            let _lv_c1 = load [_lv_s1 + _lv_i_m1]
            store64 [_lv_curr + 0] _lv_i
            let _lv_j = 1
            while _lv_j <= _lv_m {
                let _lv_j_m1 = _lv_j - 1
                let _lv_c2 = load [_lv_s2 + _lv_j_m1]
                let _lv_cost = 1
                if _lv_c1 == _lv_c2 {
                    let _lv_cost = 0
                }
                let _lv_j8 = _lv_j * 8
                let _lv_jm1_8 = _lv_j_m1 * 8
                let _lv_del = load64 [_lv_prev + _lv_j8]
                let _lv_del = _lv_del + 1
                let _lv_ins = load64 [_lv_curr + _lv_jm1_8]
                let _lv_ins = _lv_ins + 1
                let _lv_sub = load64 [_lv_prev + _lv_jm1_8]
                let _lv_sub = _lv_sub + _lv_cost
                let _lv_best = _lv_del
                if _lv_ins < _lv_best {
                    let _lv_best = _lv_ins
                }
                if _lv_sub < _lv_best {
                    let _lv_best = _lv_sub
                }
                store64 [_lv_curr + _lv_j8] _lv_best
                let _lv_j = _lv_j + 1
            }
            let _lv_j = 0
            while _lv_j <= _lv_m {
                let _lv_j8 = _lv_j * 8
                let _lv_v = load64 [_lv_curr + _lv_j8]
                store64 [_lv_prev + _lv_j8] _lv_v
                let _lv_j = _lv_j + 1
            }
            let _lv_i = _lv_i + 1
        }
        let _lv_m8 = _lv_m * 8
        let nx_r0 = load64 [_lv_prev + _lv_m8]
    }
}

# ------------------------------------------------------------------------------
# fn nx_str_slice : allocates a new null-terminated substring of nx_i0
#                   from byte index nx_i1 (inclusive) to nx_i2 (exclusive).
#                   Returns pointer in nx_r0.
# ------------------------------------------------------------------------------
fn nx_str_slice {
    let _sl_src = nx_i0
    let _sl_start = nx_i1
    let _sl_end = nx_i2
    if _sl_src == 0 {
        let _sl_empty = alloc 8
        store [_sl_empty + 0] 0
        let nx_r0 = _sl_empty
        return
    }
    let _sl_len = len _sl_src
    if _sl_start < 0 {
        let _sl_start = 0
    }
    if _sl_end > _sl_len {
        let _sl_end = _sl_len
    }
    if _sl_end <= _sl_start {
        let _sl_empty = alloc 8
        store [_sl_empty + 0] 0
        let nx_r0 = _sl_empty
        return
    }
    let _sl_out_len = _sl_end - _sl_start
    let _sl_cap = _sl_out_len + 1
    let _sl_buf = alloc _sl_cap
    let _sl_i = 0
    while _sl_i < _sl_out_len {
        let _sl_pos = _sl_start + _sl_i
        let _sl_ch = load [_sl_src + _sl_pos]
        store [_sl_buf + _sl_i] _sl_ch
        let _sl_i = _sl_i + 1
    }
    store [_sl_buf + _sl_out_len] 0
    let nx_r0 = _sl_buf
}

# ------------------------------------------------------------------------------
# fn nx_str_concat_new : allocates a new null-terminated string = nx_i0 + nx_i1
#                        Returns pointer in nx_r0.
# ------------------------------------------------------------------------------
fn nx_str_concat_new {
    let _scn_a = nx_i0
    let _scn_b = nx_i1
    let _scn_la = len _scn_a
    let _scn_lb = len _scn_b
    let _scn_tot = _scn_la + _scn_lb
    let _scn_cap = _scn_tot + 1
    let _scn_buf = alloc _scn_cap
    let nx_i0 = _scn_a
    let nx_i1 = _scn_b
    let nx_i2 = _scn_buf
    call nx_str_concat
    let nx_r0 = _scn_buf
}

# ------------------------------------------------------------------------------
# fn nx_str_trim_new : allocates a new null-terminated trimmed copy of nx_i0
#                      Returns pointer in nx_r0.
# ------------------------------------------------------------------------------
fn nx_str_trim_new {
    let _stn_src = nx_i0
    let _stn_len = len _stn_src
    let _stn_cap = _stn_len + 1
    let _stn_buf = alloc _stn_cap
    let nx_i0 = _stn_src
    let nx_i1 = _stn_buf
    call nx_str_trim
    let nx_r0 = _stn_buf
}

# ------------------------------------------------------------------------------
# fn nx_int_to_str_new : allocates a new decimal string for integer nx_i0
#                        Returns pointer in nx_r0.
# ------------------------------------------------------------------------------
fn nx_int_to_str_new {
    let _its_val = nx_i0
    let _its_buf = alloc 32
    let nx_i0 = _its_val
    let nx_i1 = _its_buf
    call nx_int_to_str
    let nx_r0 = _its_buf
}

# ------------------------------------------------------------------------------
# fn nx_str_from_char : allocates a 1-character null-terminated string for byte nx_i0
#                       Returns pointer in nx_r0.
# ------------------------------------------------------------------------------
fn nx_str_from_char {
    let _sfc_c = nx_i0
    let _sfc_buf = alloc 8
    store [_sfc_buf + 0] _sfc_c
    store [_sfc_buf + 1] 0
    let nx_r0 = _sfc_buf
}
