    let data = load64 [arr + 8]
    let off = load64 [arr + 144]
    let st0 = load64 [arr + 104]
    let st1 = load64 [arr + 112]
    let pos = off + i0 * st0 + i1 * st1
    store64 [data + pos * 8] cval
    return 1
}

