}

# --- Deep Copy, Contiguous Materialization & Type Casting ---

fn np_copy(arr) {
    if np_is_valid(arr) == 0 {
        _np_err(NP_ERR_NULL)
        return 0
    }
    let nd = load64 [arr + 24]
    let dt = load64 [arr + 16]
    let s0 = load64 [arr + 72]
    let s1 = load64 [arr + 80]
    let s2 = load64 [arr + 88]
    let s3 = load64 [arr + 96]
    let sz = load64 [arr + 32]
    let out = _np_alloc_ndarray_header(nd, s0, s1, s2, s3, dt, 0)
    if out == 0 { return 0 }
    let dst_data = load64 [out + 8]
    let i = 0
    while i < sz {
        let v = np_flat_get(arr, i)
        store64 [dst_data + i * 8] v
        i = i + 1
    }
    return out
}

fn np_ascontiguousarray(arr) {
    if np_is_valid(arr) == 0 {
        _np_err(NP_ERR_NULL)
        return 0
    }
    let off = load64 [arr + 144]
    if np_is_contiguous(arr) == 1 {
        if off == 0 {
            return arr
        }
    }
    return np_copy(arr)
}

fn np_astype(arr, new_dtype) {
    if np_is_valid(arr) == 0 {
        _np_err(NP_ERR_NULL)
        return 0
    }
    if new_dtype < 1 {
        _np_err(NP_ERR_DTYPE)
        return 0
    }
    if new_dtype > 4 {
        _np_err(NP_ERR_DTYPE)
        return 0
    }
    let nd = load64 [arr + 24]
    let s0 = load64 [arr + 72]
    let s1 = load64 [arr + 80]
    let s2 = load64 [arr + 88]
    let s3 = load64 [arr + 96]
    let sz = load64 [arr + 32]
    let out = _np_alloc_ndarray_header(nd, s0, s1, s2, s3, new_dtype, 0)
    if out == 0 { return 0 }
    let dst_data = load64 [out + 8]
    let i = 0
    while i < sz {
        let v = np_flat_get(arr, i)
        let cv = np_coerce_scalar_for_dtype(v, new_dtype)
        store64 [dst_data + i * 8] cv
        i = i + 1
    }
    return out
}

# --- Zero-Copy Views (Slices, Row/Col Views, Transpose Views) ---

fn _np_make_view(base_arr, ndim, s0, s1, s2, s3, st0, st1, st2, st3, new_offset, is_contig) {
    np_ensure_init()
    let v = alloc 160
    let dt = load64 [base_arr + 16]
    let it_sz = load64 [base_arr + 40]
    let total = s0
    if ndim >= 2 { total = total * s1 }
    if ndim >= 3 { total = total * s2 }
    if ndim >= 4 { total = total * s3 }
    let flags = NP_FLAG_WRITEABLE + NP_FLAG_VIEW
    if is_contig == 1 {
        flags = flags + NP_FLAG_CONTIGUOUS
    }
    let root_base = load64 [base_arr + 136]
    if root_base == 0 { root_base = base_arr }

    store64 [v + 0] 987654321
    store64 [v + 8] (load64 [base_arr + 8])
    store64 [v + 16] dt
    store64 [v + 24] ndim
    store64 [v + 32] total
    store64 [v + 40] it_sz
    store64 [v + 48] (total * it_sz)
    store64 [v + 56] flags
    store64 [v + 72] s0
    store64 [v + 80] s1
    store64 [v + 88] s2
    store64 [v + 96] s3
    store64 [v + 104] st0
    store64 [v + 112] st1
    store64 [v + 120] st2
    store64 [v + 128] st3
    store64 [v + 136] root_base
    store64 [v + 144] new_offset
    store64 [v + 152] 1
    let base_rc = load64 [root_base + 152]
    store64 [root_base + 152] (base_rc + 1)
    _np_update_shape_str(v)

    let prev_mem = load64 [_np_ctx + 72]
    store64 [_np_ctx + 72] (prev_mem + 152)
    let cnt = load64 [_np_ctx + 80]
    store64 [_np_ctx + 80] (cnt + 1)
    return v
}

fn np_slice_step(arr, start, stop, step) {
    if np_is_valid(arr) == 0 {
        _np_err(NP_ERR_NULL)
        return 0
    }
    if step == 0 {
        _np_err(NP_ERR_INVALID_SHAPE)
        return 0
    }
    let s0 = load64 [arr + 72]
    let st_idx = start
    let sp_idx = stop
    if st_idx < 0 { st_idx = st_idx + s0 }
    if sp_idx < 0 { sp_idx = sp_idx + s0 }
    if step > 0 {
        if st_idx < 0 { st_idx = 0 }
        if st_idx > s0 { st_idx = s0 }
        if sp_idx < 0 { sp_idx = 0 }
        if sp_idx > s0 { sp_idx = s0 }
    } else {
        if st_idx < -1 { st_idx = -1 }
        if st_idx >= s0 { st_idx = s0 - 1 }
        if sp_idx < -1 { sp_idx = -1 }
        if sp_idx >= s0 { sp_idx = s0 - 1 }
    }

    let count = 0
    if step > 0 {
        if sp_idx > st_idx {
            count = (sp_idx - st_idx + step - 1) / step
        }
    } else {
        let neg_step = 0 - step
        if st_idx > sp_idx {
            count = (st_idx - sp_idx + neg_step - 1) / neg_step
        }
    }

    let nd = load64 [arr + 24]
    let base_off = load64 [arr + 144]
    let base_st0 = load64 [arr + 104]
    let base_st1 = load64 [arr + 112]
    let base_st2 = load64 [arr + 120]
    let base_st3 = load64 [arr + 128]
    let new_off = base_off + st_idx * base_st0
    let new_st0 = base_st0 * step
    let is_c = 0
    if nd == 1 {
        if new_st0 == 1 {
            if new_off == 0 { is_c = 1 }
        }
    }
    return _np_make_view(arr, nd, count, load64 [arr + 80], load64 [arr + 88], load64 [arr + 96], new_st0, base_st1, base_st2, base_st3, new_off, is_c)
}

fn np_slice(arr, start, stop) {
    return np_slice_step(arr, start, stop, 1)
}

fn np_slice_2d(arr, r_start, r_stop, c_start, c_stop) {
    if np_is_valid(arr) == 0 {
        _np_err(NP_ERR_NULL)
        return 0
    }
    let nd = load64 [arr + 24]
    if nd != 2 {
        _np_err(NP_ERR_INVALID_DIM)
        return 0
    }
    let rows = load64 [arr + 72]
    let cols = load64 [arr + 80]
    let r0 = r_start
    let r1 = r_stop
    let c0 = c_start
    let c1 = c_stop
    if r0 < 0 { r0 = r0 + rows }
    if r1 < 0 { r1 = r1 + rows }
    if c0 < 0 { c0 = c0 + cols }
    if c1 < 0 { c1 = c1 + cols }
    if r0 < 0 { r0 = 0 }
    if r0 > rows { r0 = rows }
    if r1 < r0 { r1 = r0 }
    if r1 > rows { r1 = rows }
    if c0 < 0 { c0 = 0 }
    if c0 > cols { c0 = cols }
    if c1 < c0 { c1 = c0 }
    if c1 > cols { c1 = cols }

    let nr = r1 - r0
    let nc = c1 - c0
    let base_off = load64 [arr + 144]
    let st0 = load64 [arr + 104]
    let st1 = load64 [arr + 112]
    let new_off = base_off + r0 * st0 + c0 * st1
    return _np_make_view(arr, 2, nr, nc, 0, 0, st0, st1, 0, 0, new_off, 0)
}

fn np_row_view(arr, r) {
    if np_is_valid(arr) == 0 {
        _np_err(NP_ERR_NULL)
        return 0
    }
    let nd = load64 [arr + 24]
    if nd != 2 {
        _np_err(NP_ERR_INVALID_DIM)
        return 0
    }
    let rows = load64 [arr + 72]
    let cols = load64 [arr + 80]
    let ri = r
    if ri < 0 { ri = ri + rows }
    if ri < 0 {
        _np_err(NP_ERR_OUT_OF_BOUNDS)
        return 0
    }
    if ri >= rows {
        _np_err(NP_ERR_OUT_OF_BOUNDS)
        return 0
    }
    let base_off = load64 [arr + 144]
    let st0 = load64 [arr + 104]
    let st1 = load64 [arr + 112]
    let new_off = base_off + ri * st0
    return _np_make_view(arr, 1, cols, 0, 0, 0, st1, 0, 0, 0, new_off, 0)
}

fn np_col_view(arr, c) {
    if np_is_valid(arr) == 0 {
        _np_err(NP_ERR_NULL)
        return 0
    }
    let nd = load64 [arr + 24]
    if nd != 2 {
        _np_err(NP_ERR_INVALID_DIM)
        return 0
    }
    let rows = load64 [arr + 72]
    let cols = load64 [arr + 80]
    let ci = c
    if ci < 0 { ci = ci + cols }
    if ci < 0 {
        _np_err(NP_ERR_OUT_OF_BOUNDS)
        return 0
    }
    if ci >= cols {
        _np_err(NP_ERR_OUT_OF_BOUNDS)
        return 0
    }
    let base_off = load64 [arr + 144]
    let st0 = load64 [arr + 104]
    let st1 = load64 [arr + 112]
    let new_off = base_off + ci * st1
    return _np_make_view(arr, 1, rows, 0, 0, 0, st0, 0, 0, 0, new_off, 0)
}

fn np_transpose_view(arr) {
    if np_is_valid(arr) == 0 {
        _np_err(NP_ERR_NULL)
        return 0
    }
    let nd = load64 [arr + 24]
    if nd == 1 {
        return _np_make_view(arr, 1, load64 [arr + 72], 0, 0, 0, load64 [arr + 104], 0, 0, 0, load64 [arr + 144], 0)
    }
    if nd == 2 {
        let s0 = load64 [arr + 72]
        let s1 = load64 [arr + 80]
        let st0 = load64 [arr + 104]
        let st1 = load64 [arr + 112]
        let off = load64 [arr + 144]
        return _np_make_view(arr, 2, s1, s0, 0, 0, st1, st0, 0, 0, off, 0)
    }
    if nd == 3 {
        let s0 = load64 [arr + 72]
        let s1 = load64 [arr + 80]
        let s2 = load64 [arr + 88]
        let st0 = load64 [arr + 104]
        let st1 = load64 [arr + 112]
        let st2 = load64 [arr + 120]
        let off = load64 [arr + 144]
        return _np_make_view(arr, 3, s2, s1, s0, 0, st2, st1, st0, 0, off, 0)
    }
    _np_err(NP_ERR_INVALID_DIM)
    return 0
}

fn np_ravel_view(arr) {
    if np_is_valid(arr) == 0 {
        _np_err(NP_ERR_NULL)
        return 0
    }
    let sz = load64 [arr + 32]
    let off = load64 [arr + 144]
    if np_is_contiguous(arr) == 1 {
        return _np_make_view(arr, 1, sz, 0, 0, 0, 1, 0, 0, 0, off, 1)
    }
    # Fall back to contiguous copy if non-contiguous strided view cannot be represented with a single 1D stride
    let copy_arr = np_copy(arr)
    store64 [copy_arr + 24] 1
    store64 [copy_arr + 72] sz
    store64 [copy_arr + 80] 0
    store64 [copy_arr + 88] 0
    store64 [copy_arr + 96] 0
    store64 [copy_arr + 104] 1
    store64 [copy_arr + 112] 0
    store64 [copy_arr + 120] 0
    store64 [copy_arr + 128] 0
    _np_update_shape_str(copy_arr)
    return copy_arr
}

# --- Shape Transformations (Reshape, Flatten, Transpose, Squeeze, Expand) ---

fn np_flatten(arr) {
    if np_is_valid(arr) == 0 {
        _np_err(NP_ERR_NULL)
        return 0
    }
    let sz = load64 [arr + 32]
    let dt = load64 [arr + 16]
    let out = _np_alloc_ndarray_header(1, sz, 0, 0, 0, dt, 0)
    if out == 0 { return 0 }
    let dst = load64 [out + 8]
    let i = 0
    while i < sz {
        let v = np_flat_get(arr, i)
        store64 [dst + i * 8] v
        i = i + 1
    }
    return out
}

fn np_ravel(arr) {
    return np_ravel_view(arr)
}

fn np_reshape_1d(arr, new_n) {
    if np_is_valid(arr) == 0 {
        _np_err(NP_ERR_NULL)
        return 0
    }
    let sz = load64 [arr + 32]
    let d0 = new_n
    if d0 == -1 { d0 = sz }
    if d0 != sz {
        _np_err(NP_ERR_INVALID_SHAPE)
        return 0
    }
    return np_flatten(arr)
}

fn np_reshape(arr, rows, cols) {
    if np_is_valid(arr) == 0 {
        _np_err(NP_ERR_NULL)
        return 0
    }
    let sz = load64 [arr + 32]
    let r = rows
    let c = cols
    if r == -1 {
        if c <= 0 {
        _np_err(NP_ERR_INVALID_SHAPE)
        return 0
    }
        if sz % c != 0 {
        _np_err(NP_ERR_INVALID_SHAPE)
        return 0
    }
        r = sz / c
    } else {
        if c == -1 {
            if r <= 0 {
        _np_err(NP_ERR_INVALID_SHAPE)
        return 0
    }
            if sz % r != 0 {
        _np_err(NP_ERR_INVALID_SHAPE)
        return 0
    }
            c = sz / r
        }
    }
    if r < 0 {
        _np_err(NP_ERR_INVALID_SHAPE)
        return 0
    }
    if c < 0 {
        _np_err(NP_ERR_INVALID_SHAPE)
        return 0
    }
    if r * c != sz {
        _np_err(NP_ERR_INVALID_SHAPE)
        return 0
    }
    let dt = load64 [arr + 16]
    let out = _np_alloc_ndarray_header(2, r, c, 0, 0, dt, 0)
    if out == 0 { return 0 }
    let dst = load64 [out + 8]
    let i = 0
    while i < sz {
        let v = np_flat_get(arr, i)
        store64 [dst + i * 8] v
        i = i + 1
    }
    return out
}

fn np_reshape_3d(arr, d0, d1, d2) {
    if np_is_valid(arr) == 0 {
        _np_err(NP_ERR_NULL)
        return 0
    }
    if d0 < 0 {
        _np_err(NP_ERR_INVALID_SHAPE)
        return 0
    }
    if d1 < 0 {
        _np_err(NP_ERR_INVALID_SHAPE)
        return 0
    }
    if d2 < 0 {
        _np_err(NP_ERR_INVALID_SHAPE)
        return 0
    }
    let sz = load64 [arr + 32]
    if d0 * d1 * d2 != sz {
        _np_err(NP_ERR_INVALID_SHAPE)
        return 0
    }
    let dt = load64 [arr + 16]
    let out = _np_alloc_ndarray_header(3, d0, d1, d2, 0, dt, 0)
    if out == 0 { return 0 }
    let dst = load64 [out + 8]
    let i = 0
    while i < sz {
        let v = np_flat_get(arr, i)
        store64 [dst + i * 8] v
        i = i + 1
    }
    return out
}

fn np_transpose(arr) {
    if np_is_valid(arr) == 0 {
        _np_err(NP_ERR_NULL)
        return 0
    }
    let nd = load64 [arr + 24]
    if nd == 1 {
        return np_copy(arr)
    }
    if nd == 2 {
        let rows = load64 [arr + 72]
        let cols = load64 [arr + 80]
        let dt = load64 [arr + 16]
        let out = _np_alloc_ndarray_header(2, cols, rows, 0, 0, dt, 0)
        if out == 0 { return 0 }
        let dst = load64 [out + 8]
        let r = 0
        while r < rows {
            let c = 0
            while c < cols {
                let v = np_get2(arr, r, c)
                let dst_idx = c * rows + r
                store64 [dst + dst_idx * 8] v
                c = c + 1
            }
            r = r + 1
        }
        return out
    }
    if nd == 3 {
        let tv = np_transpose_view(arr)
        return np_copy(tv)
    }
    _np_err(NP_ERR_INVALID_DIM)
    return 0
}

fn np_expand_dims(arr, axis) {
    if np_is_valid(arr) == 0 {
        _np_err(NP_ERR_NULL)
        return 0
    }
    let nd = load64 [arr + 24]
    if nd >= 4 {
        _np_err(NP_ERR_INVALID_DIM)
        return 0
    }
    let new_nd = nd + 1
    let ax = axis
    if ax < 0 { ax = ax + new_nd }
    if ax < 0 {
        _np_err(NP_ERR_INVALID_DIM)
        return 0
    }
    if ax >= new_nd {
        _np_err(NP_ERR_INVALID_DIM)
        return 0
    }
    let old_dims = alloc 32
    store64 [old_dims + 0] (load64 [arr + 72])
    store64 [old_dims + 8] (load64 [arr + 80])
    store64 [old_dims + 16] (load64 [arr + 88])
    store64 [old_dims + 24] (load64 [arr + 96])

    let new_dims = alloc 32
    store64 [new_dims + 0] 0
    store64 [new_dims + 8] 0
    store64 [new_dims + 16] 0
    store64 [new_dims + 24] 0

    let src_i = 0
    let dst_i = 0
    while dst_i < new_nd {
        if dst_i == ax {
            store64 [new_dims + dst_i * 8] 1
        } else {
            store64 [new_dims + dst_i * 8] (load64 [old_dims + src_i * 8])
            src_i = src_i + 1
        }
        dst_i = dst_i + 1
    }

    let copy_arr = np_copy(arr)
    let ns0 = load64 [new_dims + 0]
    let ns1 = load64 [new_dims + 8]
    let ns2 = load64 [new_dims + 16]
    let ns3 = load64 [new_dims + 24]
    let out = _np_alloc_ndarray_header(new_nd, ns0, ns1, ns2, ns3, load64 [arr + 16], load64 [copy_arr + 8])
    return out
}

fn np_squeeze(arr) {
    if np_is_valid(arr) == 0 {
        _np_err(NP_ERR_NULL)
        return 0
    }
    let nd = load64 [arr + 24]
    let kept = alloc 32
    store64 [kept + 0] 0
    store64 [kept + 8] 0
    store64 [kept + 16] 0
    store64 [kept + 24] 0
    let nkept = 0
    let i = 0
    while i < nd {
        let d = load64 [arr + 72 + i * 8]
        if d != 1 {
            store64 [kept + nkept * 8] d
            nkept = nkept + 1
        }
        i = i + 1
    }
    if nkept == 0 {
        nkept = 1
        let sz = load64 [arr + 32]
        store64 [kept + 0] sz
    }
    let copy_arr = np_copy(arr)
    let out = _np_alloc_ndarray_header(nkept, load64 [kept + 0], load64 [kept + 8], load64 [kept + 16], load64 [kept + 24], load64 [arr + 16], load64 [copy_arr + 8])
    return out
}

# --- NdArray Struct Method Implementations (obj.method(...)) ---

impl NdArray {
    fn get(self, idx) -> float {
        return np_get(self, idx)
    }
    fn get_int(self, idx) {
        return np_get_int(self, idx)
    }
    fn set(self, idx, val: float) {
        return np_set(self, idx, val)
    }
    fn get2(self, r, c) -> float {
        return np_get2(self, r, c)
    }
    fn set2(self, r, c, val: float) {
        return np_set2(self, r, c, val)
    }
    fn get3(self, d0, d1, d2) -> float {
        return np_get3(self, d0, d1, d2)
    }
    fn set3(self, d0, d1, d2, val: float) {
        return np_set3(self, d0, d1, d2, val)
    }
    fn copy(self) {
        return np_copy(self)
    }
    fn astype(self, dt) {
        return np_astype(self, dt)
    }
    fn reshape(self, rows, cols) {
        return np_reshape(self, rows, cols)
    }
    fn reshape_3d(self, d0, d1, d2) {
        return np_reshape_3d(self, d0, d1, d2)
    }
    fn flatten(self) {
        return np_flatten(self)
    }
    fn ravel(self) {
        return np_ravel(self)
    }
    fn transpose(self) {
        return np_transpose(self)
    }
    fn slice(self, start, stop) {
        return np_slice(self, start, stop)
    }
    fn row(self, r) {
        return np_row_view(self, r)
    }
    fn col(self, c) {
        return np_col_view(self, c)
    }
    fn shape_dim(self, axis) {
        return np_shape_dim(self, axis)
    }
    fn stride_dim(self, axis) {
        return np_stride_dim(self, axis)
    }
    fn dtype_name(self) -> string {
        return np_dtype_name(load64 [self + 16])
    }
}


let nx_assert_passes = 0
let nx_assert_fails = 0

fn nx_assert_summary() {
    let buf = alloc 96
    # "ASSERTIONS: "
    store [buf + 0] 65
    store [buf + 1] 83
    store [buf + 2] 83
    store [buf + 3] 69
    store [buf + 4] 82
    store [buf + 5] 84
    store [buf + 6] 73
    store [buf + 7] 79
    store [buf + 8] 78
    store [buf + 9] 83
    store [buf + 10] 58
    store [buf + 11] 32
    let p = _np_write_int_to_buf(buf, 12, nx_assert_passes)
    # " passed, "
    store [buf + p + 0] 32
    store [buf + p + 1] 112
    store [buf + p + 2] 97
    store [buf + p + 3] 115
    store [buf + p + 4] 115
    store [buf + p + 5] 101
    store [buf + p + 6] 100
    store [buf + p + 7] 44
    store [buf + p + 8] 32
    p = _np_write_int_to_buf(buf, p + 9, nx_assert_fails)
    # " failed"
    store [buf + p + 0] 32
    store [buf + p + 1] 102
    store [buf + p + 2] 97
    store [buf + p + 3] 105
    store [buf + p + 4] 108
    store [buf + p + 5] 101
    store [buf + p + 6] 100
    store [buf + p + 7] 0
    print_str buf
    return 0
}

fn np_assert_near(actual: float, expected: float, tol: float) {
    let diff = actual - expected
    if diff < 0.0 {
        diff = fneg diff
    }
    if diff <= tol {
        nx_assert_passes = nx_assert_passes + 1
        return 1
    }
    nx_assert_fails = nx_assert_fails + 1
    print "[FAIL] np_assert_near:"
    print_float actual
    print_float expected
    return 0
}
