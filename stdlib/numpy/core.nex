    let i0 = d0
    let i1 = d1
    let i2 = d2
    if i0 < 0 { i0 = i0 + s0 }
    if i1 < 0 { i1 = i1 + s1 }
    if i2 < 0 { i2 = i2 + s2 }
    if i0 < 0 {
