# ==============================================================================
# NEXUS NUMERICAL COMPUTING LIBRARY (numpy) — SERIALIZATION & DATA INTERCHANGE
# ==============================================================================
# Validated .nxarr binary format (magic header, version, endianness, dtype,
# ndim, shape, payload, and 64-bit checksum), CSV import/export, and string
# formatting.
# ==============================================================================

include "stdlib/numpy/random.nex"

const NP_NXARR_MAGIC   = 192837465
const NP_NXARR_VERSION = 1

fn _np_checksum_bytes(buf, nbytes) {
    let h = 5381
    let i = 0
    while i < nbytes {
        let b = load [buf + i]
        h = (h * 33 + b) % 2000000000
        i = i + 1
    }
    return h
}

fn np_save_binary(path: string, arr) {
    if np_is_valid(arr) == 0 {
        _np_err(NP_ERR_NULL)
        return 0
    }
    if path == 0 {
        _np_err(NP_ERR_IO)
        return 0
    }
    if (len path) == 0 {
        _np_err(NP_ERR_IO)
        return 0
    }
    let contig = np_ascontiguousarray(arr)
    if contig == 0 { return 0 }

    let nd = load64 [contig + 24]
    let dt = load64 [contig + 16]
    let sz = load64 [contig + 32]
    let s0 = load64 [contig + 72]
    let s1 = load64 [contig + 80]
    let s2 = load64 [contig + 88]
    let s3 = load64 [contig + 96]
    let data = load64 [contig + 8]
    let payload_bytes = sz * 8
    let total_bytes = 64 + payload_bytes

    let fbuf = alloc total_bytes
    store64 [fbuf + 0]  NP_NXARR_MAGIC
    store64 [fbuf + 8]  NP_NXARR_VERSION
    store64 [fbuf + 16] dt
    store64 [fbuf + 24] nd
    store64 [fbuf + 32] s0
    store64 [fbuf + 40] s1
    store64 [fbuf + 48] (s2 + s3 * 65536)

    let i = 0
    while i < sz {
        store64 [fbuf + 64 + i * 8] (load64 [data + i * 8])
        i = i + 1
    }
    let csum = _np_checksum_bytes(fbuf + 64, payload_bytes)
    store64 [fbuf + 56] csum

    let fd = file_create path
    if fd < 0 {
        _np_err(NP_ERR_IO)
        return 0
    }
    if fd > 4096 {
        _np_err(NP_ERR_IO)
        return 0
    }
    file_write fd fbuf total_bytes
    file_close fd
    return 1
}

fn np_load_binary(path: string) {
    if path == 0 {
        _np_err(NP_ERR_IO)
        return 0
    }
    if (len path) == 0 {
        _np_err(NP_ERR_IO)
        return 0
    }
    let fd = file_open path
    if fd < 0 {
        _np_err(NP_ERR_IO)
        return 0
    }
    if fd > 4096 {
        _np_err(NP_ERR_IO)
        return 0
    }
    let max_cap = 1048576
    let rbuf = alloc max_cap
    let nread = file_read fd rbuf max_cap
    file_close fd

    if nread < 64 {
        _np_err(NP_ERR_IO)
        return 0
    }
    let magic = load64 [rbuf + 0]
    let ver   = load64 [rbuf + 8]
    if magic != NP_NXARR_MAGIC {
        _np_err(NP_ERR_IO)
        return 0
    }
    if ver != NP_NXARR_VERSION {
        _np_err(NP_ERR_IO)
        return 0
    }
    let dt = load64 [rbuf + 16]
    let nd = load64 [rbuf + 24]
    let s0 = load64 [rbuf + 32]
    let s1 = load64 [rbuf + 40]
    let s23 = load64 [rbuf + 48]
    let s2 = s23 % 65536
    let s3 = s23 / 65536
    let expected_csum = load64 [rbuf + 56]

    if dt < 1 {
        _np_err(NP_ERR_IO)
        return 0
    }
    if dt > 4 {
        _np_err(NP_ERR_IO)
        return 0
    }
    if nd < 1 {
        _np_err(NP_ERR_IO)
        return 0
    }
    if nd > 4 {
        _np_err(NP_ERR_IO)
        return 0
    }
    if s0 < 0 {
        _np_err(NP_ERR_IO)
        return 0
    }

    let total = s0
    if nd >= 2 { total = total * s1 }
    if nd >= 3 { total = total * s2 }
    if nd >= 4 { total = total * s3 }
    if total < 0 {
        _np_err(NP_ERR_IO)
        return 0
    }
    if total > 131072 {
        _np_err(NP_ERR_IO)
        return 0
    }
    let payload_bytes = total * 8
    if nread != (64 + payload_bytes) {
        _np_err(NP_ERR_IO)
        return 0
    }
    let actual_csum = _np_checksum_bytes(rbuf + 64, payload_bytes)
    if actual_csum != expected_csum {
        _np_err(NP_ERR_IO)
        return 0
    }

    let out = _np_alloc_ndarray_header(nd, s0, s1, s2, s3, dt, 0)
    if out == 0 { return 0 }
    let dst = load64 [out + 8]
    let i = 0
    while i < total {
        store64 [dst + i * 8] (load64 [rbuf + 64 + i * 8])
        i = i + 1
    }
    return out
}

# --- Float-to-ASCII & CSV Formatting Helpers ---

fn _np_write_float_to_buf(buf, pos, val: float) {
    if np_isnan_scalar(val) == 1 {
        store [buf + pos] 110
        store [buf + pos + 1] 97
        store [buf + pos + 2] 110
        return pos + 3
    }
    if np_isinf_scalar(val) == 1 {
        if val < 0.0 {
            store [buf + pos] 45
            pos = pos + 1
        }
        store [buf + pos] 105
        store [buf + pos + 1] 110
        store [buf + pos + 2] 102
        return pos + 3
    }
    let v = val
    if v < 0.0 {
        store [buf + pos] 45
        pos = pos + 1
        v = 0.0 - v
    }
    let scaled = ftoi (v * 1000000.0 + 0.5)
    let int_part = scaled / 1000000
    let frac_part = scaled % 1000000
    pos = _np_write_int_to_buf(buf, pos, int_part)
    store [buf + pos] 46
    pos = pos + 1
    # Write 6 fractional digits, trimming trailing zeros down to 1 digit
    let d5 = (frac_part / 100000) % 10
    let d4 = (frac_part / 10000) % 10
    let d3 = (frac_part / 1000) % 10
    let d2 = (frac_part / 100) % 10
    let d1 = (frac_part / 10) % 10
    let d0 = frac_part % 10
    store [buf + pos + 0] (d5 + 48)
    store [buf + pos + 1] (d4 + 48)
    store [buf + pos + 2] (d3 + 48)
    store [buf + pos + 3] (d2 + 48)
    store [buf + pos + 4] (d1 + 48)
    store [buf + pos + 5] (d0 + 48)
    let end_p = pos + 6
    while end_p > (pos + 1) {
        let prev_ch = load [buf + end_p - 1]
        if prev_ch == 48 {
            end_p = end_p - 1
        } else {
            break
        }
    }
    return end_p
}

fn np_to_csv_string(arr) -> string {
    if np_is_valid(arr) == 0 {
        _np_err(NP_ERR_NULL)
        return ""
    }
    let nd = load64 [arr + 24]
    if nd > 2 {
        _np_err(NP_ERR_INVALID_DIM)
        return ""
    }
    let sz = load64 [arr + 32]
    let cap_bytes = sz * 32 + 64
    let buf = alloc cap_bytes
    let pos = 0

    if nd == 1 {
        let n = load64 [arr + 72]
        let i = 0
        while i < n {
            pos = _np_write_float_to_buf(buf, pos, np_get(arr, i))
            store [buf + pos] 10
            pos = pos + 1
            i = i + 1
        }
    } else {
        let rows = load64 [arr + 72]
        let cols = load64 [arr + 80]
        let r = 0
        while r < rows {
            let c = 0
            while c < cols {
                if c > 0 {
                    store [buf + pos] 44
                    pos = pos + 1
                }
                pos = _np_write_float_to_buf(buf, pos, np_get2(arr, r, c))
                c = c + 1
            }
            store [buf + pos] 10
            pos = pos + 1
            r = r + 1
        }
    }
    store [buf + pos] 0
    return buf
}

fn np_save_csv(path: string, arr) {
    if np_is_valid(arr) == 0 {
        _np_err(NP_ERR_NULL)
        return 0
    }
    if path == 0 {
        _np_err(NP_ERR_IO)
        return 0
    }
    if (len path) == 0 {
        _np_err(NP_ERR_IO)
        return 0
    }
    let csv_s = np_to_csv_string(arr)
    let slen = len csv_s
    if slen == 0 {
        if (load64 [arr + 32]) > 0 {
            return 0
        }
    }
    let fd = file_create path
    if fd < 0 {
        _np_err(NP_ERR_IO)
        return 0
    }
    if fd > 4096 {
        _np_err(NP_ERR_IO)
        return 0
    }
    file_write fd csv_s slen
    file_close fd
    return 1
}

fn _np_parse_csv_buf(rbuf, nread) {
    if rbuf == 0 {
        _np_err(NP_ERR_IO)
        return 0
    }
    if nread <= 0 {
        _np_err(NP_ERR_IO)
        return 0
    }
    let vals = alloc 65536
    let nvals = 0
    let nrows = 0
    let expected_cols = -1
    let cur_cols = 0
    let trailing_comma = 0
    let i = 0

    while i < nread {
        let ch = load [rbuf + i]
        while ch == 32 {
            i = i + 1
            if i >= nread { break }
            ch = load [rbuf + i]
        }
        if i >= nread { break }
        if ch == 13 {
            i = i + 1
            continue
        }
        if ch == 10 {
            if trailing_comma == 1 {
                _np_err(NP_ERR_IO)
                return 0
            }
            if cur_cols > 0 {
                if expected_cols < 0 {
                    expected_cols = cur_cols
                } else {
                    if cur_cols != expected_cols {
                        _np_err(NP_ERR_IO)
                        return 0
                    }
                }
                nrows = nrows + 1
                cur_cols = 0
            }
            i = i + 1
            continue
        }

        let sign = 1.0
        if ch == 45 {
            sign = -1.0
            i = i + 1
        } else {
            if ch == 43 { i = i + 1 }
        }
        let has_digits = 0
        let int_acc = 0.0
        while i < nread {
            let c = load [rbuf + i]
            if c >= 48 {
                if c <= 57 {
                    int_acc = int_acc * 10.0 + (itof (c - 48))
                    has_digits = 1
                    i = i + 1
                } else { break }
            } else { break }
        }
        let frac_acc = 0.0
        let frac_scale = 0.1
        if i < nread {
            if (load [rbuf + i]) == 46 {
                i = i + 1
                while i < nread {
                    let c = load [rbuf + i]
                    if c >= 48 {
                        if c <= 57 {
                            frac_acc = frac_acc + (itof (c - 48)) * frac_scale
                            frac_scale = frac_scale * 0.1
                            has_digits = 1
                            i = i + 1
                        } else { break }
                    } else { break }
                }
            }
        }
        if has_digits == 0 {
            _np_err(NP_ERR_IO)
            return 0
        }
        let num = sign * (int_acc + frac_acc)
        store64 [vals + nvals * 8] num
        nvals = nvals + 1
        cur_cols = cur_cols + 1
        trailing_comma = 0

        while i < nread {
            let sp = load [rbuf + i]
            if sp == 32 { i = i + 1 } else { break }
        }
        if i < nread {
            let sep = load [rbuf + i]
            if sep == 44 {
                trailing_comma = 1
                i = i + 1
            } else {
                if sep != 10 {
                    if sep != 13 {
                        _np_err(NP_ERR_IO)
                        return 0
                    }
                }
            }
        }
    }
    if trailing_comma == 1 {
        _np_err(NP_ERR_IO)
        return 0
    }
    if cur_cols > 0 {
        if expected_cols < 0 {
            expected_cols = cur_cols
        } else {
            if cur_cols != expected_cols {
                _np_err(NP_ERR_IO)
                return 0
            }
        }
        nrows = nrows + 1
    }
    if nrows <= 0 {
        _np_err(NP_ERR_IO)
        return 0
    }
    if expected_cols == 1 {
        return np_from_buffer_1d(vals, nrows, NP_FLOAT64)
    }
    return np_from_buffer_2d(vals, nrows, expected_cols, NP_FLOAT64)
}

fn np_from_csv_string(csv_str: string) {
    if csv_str == 0 {
        _np_err(NP_ERR_IO)
        return 0
    }
    let slen = len csv_str
    return _np_parse_csv_buf(csv_str, slen)
}

fn np_load_csv(path: string) {
    if path == 0 {
        _np_err(NP_ERR_IO)
        return 0
    }
    if (len path) == 0 {
        _np_err(NP_ERR_IO)
        return 0
    }
    let fd = file_open path
    if fd < 0 {
        _np_err(NP_ERR_IO)
        return 0
    }
    if fd > 4096 {
        _np_err(NP_ERR_IO)
        return 0
    }
    let max_cap = 262144
    let rbuf = alloc max_cap
    let read_lim = max_cap - 1
    let nread = file_read fd rbuf read_lim
    file_close fd
    if nread <= 0 {
        _np_err(NP_ERR_IO)
        return 0
    }
    store [rbuf + nread] 0
    return _np_parse_csv_buf(rbuf, nread)
}

fn np_format(arr) -> string {
    if np_is_valid(arr) == 0 { return "invalid_array" }
    let nd = load64 [arr + 24]
    let sz = load64 [arr + 32]
    let cap_bytes = sz * 24 + 64
    let buf = alloc cap_bytes
    let pos = 0
    if nd == 1 {
        store [buf + pos] 91
        pos = pos + 1
        let i = 0
        while i < sz {
            if i > 0 {
                store [buf + pos] 44
                store [buf + pos + 1] 32
                pos = pos + 2
            }
            pos = _np_write_float_to_buf(buf, pos, np_get(arr, i))
            i = i + 1
        }
        store [buf + pos] 93
        store [buf + pos + 1] 0
        return buf
    }
    if nd == 2 {
        let rows = load64 [arr + 72]
        let cols = load64 [arr + 80]
        store [buf + pos] 91
        pos = pos + 1
        let r = 0
        while r < rows {
            if r > 0 {
                store [buf + pos] 44
                store [buf + pos + 1] 32
                pos = pos + 2
            }
            store [buf + pos] 91
            pos = pos + 1
            let c = 0
            while c < cols {
                if c > 0 {
                    store [buf + pos] 44
                    store [buf + pos + 1] 32
                    pos = pos + 2
                }
                pos = _np_write_float_to_buf(buf, pos, np_get2(arr, r, c))
                c = c + 1
            }
            store [buf + pos] 93
            pos = pos + 1
            r = r + 1
        }
        store [buf + pos] 93
        store [buf + pos + 1] 0
        return buf
    }
    return np_shape_str(arr)
}

fn np_print(arr) {
    let s = np_format(arr)
    print_str s
    return 0
}
