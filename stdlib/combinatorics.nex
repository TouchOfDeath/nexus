# ==============================================================================
#                 NEXUS STANDARD LIBRARY - MODULE: combinatorics.nex
#           Combinatorics, Permutations, and Combinatorial Generators
# ==============================================================================
#
# CALLING CONVENTION:
#   Inputs : nx_i0, nx_i1, nx_i2
#   Result : nx_r0
#   Scratch: s0..s7 (clobbered)
#   Rule   : Leaf subroutines. Expressions fold strictly left-to-right.
# ==============================================================================

# ------------------------------------------------------------------------------
# fn nx_fact : nx_r0 = n!
#              Returns 1 for n <= 1. Returns -1 on overflow (n > 20).
# ------------------------------------------------------------------------------
fn nx_fact {
    let s0 = nx_i0
    if s0 < 0 {
        let nx_r0 = 0
    } else {
        if s0 > 20 {
            let nx_r0 = -1
        } else {
            let nx_r0 = 1
            let s1 = 2
            while s1 <= s0 {
                let nx_r0 = nx_r0 * s1
                let s1 = s1 + 1
            }
        }
    }
}

# ------------------------------------------------------------------------------
# fn nx_perm_count : nx_r0 = P(n, k) = n! / (n - k)!
#                    Returns 0 if k < 0 or k > n.
# ------------------------------------------------------------------------------
fn nx_perm_count {
    let s0 = nx_i0
    let s1 = nx_i1
    if s1 < 0 {
        let nx_r0 = 0
    } else {
        if s1 > s0 {
            let nx_r0 = 0
        } else {
            let nx_r0 = 1
            let s2 = s0 - s1
            let s3 = s0
            while s3 > s2 {
                let nx_r0 = nx_r0 * s3
                let s3 = s3 - 1
            }
        }
    }
}

# ------------------------------------------------------------------------------
# fn nx_comb_count : nx_r0 = C(n, k) = n! / (k! * (n - k)!)
#                    Computes binomial coefficient using multiplicative formula
#                    without intermediate fractional truncation.
# ------------------------------------------------------------------------------
fn nx_comb_count {
    let s0 = nx_i0
    let s1 = nx_i1
    if s1 < 0 {
        let nx_r0 = 0
    } else {
        if s1 > s0 {
            let nx_r0 = 0
        } else {
            let s2 = s0 - s1
            if s1 > s2 {
                let s1 = s2
            }
            let nx_r0 = 1
            let s3 = 1
            while s3 <= s1 {
                let s4 = s0 - s1
                let s4 = s4 + s3
                let nx_r0 = nx_r0 * s4
                let nx_r0 = nx_r0 / s3
                let s3 = s3 + 1
            }
        }
    }
}

# ------------------------------------------------------------------------------
# fn nx_catalan : nx_r0 = C_n = (1 / (n + 1)) * (2n choose n)
# ------------------------------------------------------------------------------
fn nx_catalan {
    let s0 = nx_i0
    if s0 < 0 {
        let nx_r0 = 0
    } else {
        if s0 == 0 {
            let nx_r0 = 1
        } else {
            let nx_r0 = 1
            let s1 = 1
            while s1 <= s0 {
                let s2 = s1 * 2
                let s3 = s2 - 1
                let s3 = s3 * 2
                let nx_r0 = nx_r0 * s3
                let s4 = s1 + 1
                let nx_r0 = nx_r0 / s4
                let s1 = s1 + 1
            }
        }
    }
}

# ------------------------------------------------------------------------------
# fn nx_derangements : nx_r0 = !n (subfactorial, number of permutations with no fixed points)
#                      !0 = 1, !1 = 0, !2 = 1, !n = (n - 1) * (!(n - 1) + !(n - 2))
# ------------------------------------------------------------------------------
fn nx_derangements {
    let s0 = nx_i0
    if s0 < 0 {
        let nx_r0 = 0
    } else {
        if s0 == 0 {
            let nx_r0 = 1
        } else {
            if s0 == 1 {
                let nx_r0 = 0
            } else {
                let s1 = 1
                let s2 = 0
                let s3 = 2
                while s3 <= s0 {
                    let s4 = s1 + s2
                    let s5 = s3 - 1
                    let s6 = s4 * s5
                    let s1 = s2
                    let s2 = s6
                    let s3 = s3 + 1
                }
                let nx_r0 = s2
            }
        }
    }
}

# ------------------------------------------------------------------------------
# fn nx_perm_next : In-place next lexicographical permutation of 64-bit array
#   Inputs:  nx_i0 = array pointer (elements are 64-bit quadwords)
#            nx_i1 = element count n
#   Outputs: nx_r0 = 1 if a next permutation was generated
#            nx_r0 = 0 if the array was in descending order (cycled to sorted)
# ------------------------------------------------------------------------------
fn nx_perm_next {
    let s0 = nx_i0
    let s1 = nx_i1
    if s1 <= 1 {
        let nx_r0 = 0
    } else {
        # 1. Find largest index i such that arr[i] < arr[i + 1]
        let s2 = s1 - 2
        let s3 = -1
        while s2 >= 0 {
            if s3 == -1 {
                let s4 = load64 [s0 + s2 * 8]
                let s5 = s2 + 1
                let s6 = load64 [s0 + s5 * 8]
                if s4 < s6 {
                    let s3 = s2
                }
            }
            let s2 = s2 - 1
        }

        if s3 == -1 {
            # Array is purely descending. Reverse entire array and return 0.
            let s4 = 0
            let s5 = s1 - 1
            while s4 < s5 {
                let s6 = load64 [s0 + s4 * 8]
                let s7 = load64 [s0 + s5 * 8]
                store64 [s0 + s4 * 8] s7
                store64 [s0 + s5 * 8] s6
                let s4 = s4 + 1
                let s5 = s5 - 1
            }
            let nx_r0 = 0
        } else {
            # 2. Find largest index j > s3 such that arr[s3] < arr[j]
            let s4 = s1 - 1
            let s5 = -1
            let s6 = load64 [s0 + s3 * 8]
            while s4 > s3 {
                if s5 == -1 {
                    let s7 = load64 [s0 + s4 * 8]
                    if s6 < s7 {
                        let s5 = s4
                    }
                }
                let s4 = s4 - 1
            }

            # 3. Swap arr[s3] and arr[s5]
            let s6 = load64 [s0 + s3 * 8]
            let s7 = load64 [s0 + s5 * 8]
            store64 [s0 + s3 * 8] s7
            store64 [s0 + s5 * 8] s6

            # 4. Reverse subarray from s3 + 1 to s1 - 1
            let s4 = s3 + 1
            let s5 = s1 - 1
            while s4 < s5 {
                let s6 = load64 [s0 + s4 * 8]
                let s7 = load64 [s0 + s5 * 8]
                store64 [s0 + s4 * 8] s7
                store64 [s0 + s5 * 8] s6
                let s4 = s4 + 1
                let s5 = s5 - 1
            }
            let nx_r0 = 1
        }
    }
}
