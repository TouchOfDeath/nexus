# ==============================================================================
#                 NEXUS STANDARD LIBRARY - MODULE: bitwise.nex
#        Bitwise operations with HYDRON early-exit & O(1) shift decomposition
# ==============================================================================
#
# Operators (desugared by nexprep.c to these function calls):
#   a & b   -> nx_band(a, b)   Bitwise AND
#   a | b   -> nx_bor(a, b)    Bitwise OR
#   a ^ b   -> nx_bxor(a, b)   Bitwise XOR
#   ~a      -> nx_bnot(a)      Bitwise NOT (complement)
#   a << n  -> nx_shl(a, n)    Left shift
#   a >> n  -> nx_shr(a, n)    Arithmetic right shift
#
# CALLING CONVENTION: see math.nex header.
#   nx_i0, nx_i1 = operands
#   nx_r0 = result
#   s0..s7 = scratch (clobbered)

# ------------------------------------------------------------------------------
# fn nx_band : nx_r0 = nx_i0 & nx_i1 (bitwise AND with zero-operand early exit)
# ------------------------------------------------------------------------------
fn nx_band {
    let s0 = nx_i0
    let s1 = nx_i1
    let nx_r0 = 0
    let s2 = 1
    let s3 = 0
    while s3 < 64 {
        if s0 == 0 {
            break
        }
        if s1 == 0 {
            break
        }
        let s4 = s0 % 2
        let s5 = s1 % 2
        if s4 == 1 {
            if s5 == 1 {
                let nx_r0 = nx_r0 + s2
            }
        }
        let s0 = s0 / 2
        let s1 = s1 / 2
        let s2 = s2 * 2
        let s3 = s3 + 1
    }
}

# ------------------------------------------------------------------------------
# fn nx_bor : nx_r0 = nx_i0 | nx_i1 (bitwise OR with dual-zero early exit)
# ------------------------------------------------------------------------------
fn nx_bor {
    let s0 = nx_i0
    let s1 = nx_i1
    let nx_r0 = 0
    let s2 = 1
    let s3 = 0
    while s3 < 64 {
        if s0 == 0 {
            if s1 == 0 {
                break
            }
        }
        let s4 = s0 % 2
        let s5 = s1 % 2
        if s4 == 1 {
            let nx_r0 = nx_r0 + s2
        }
        if s5 == 1 {
            if s4 == 0 {
                let nx_r0 = nx_r0 + s2
            }
        }
        let s0 = s0 / 2
        let s1 = s1 / 2
        let s2 = s2 * 2
        let s3 = s3 + 1
    }
}

# ------------------------------------------------------------------------------
# fn nx_bxor : nx_r0 = nx_i0 ^ nx_i1 (bitwise XOR with identity & zero early exit)
# ------------------------------------------------------------------------------
fn nx_bxor {
    let s0 = nx_i0
    let s1 = nx_i1
    let nx_r0 = 0
    if s0 != s1 {
        let s2 = 1
        let s3 = 0
        while s3 < 64 {
            if s0 == 0 {
                if s1 == 0 {
                    break
                }
            }
            let s4 = s0 % 2
            let s5 = s1 % 2
            if s4 != s5 {
                let nx_r0 = nx_r0 + s2
            }
            let s0 = s0 / 2
            let s1 = s1 / 2
            let s2 = s2 * 2
            let s3 = s3 + 1
        }
    }
}

# ------------------------------------------------------------------------------
# fn nx_bnot : nx_r0 = ~nx_i0 (bitwise NOT = complement)
#   ~x = -x - 1 (two's complement identity)
# ------------------------------------------------------------------------------
fn nx_bnot {
    let nx_r0 = 0 - nx_i0
    let nx_r0 = nx_r0 - 1
}

# ------------------------------------------------------------------------------
# fn nx_shl : nx_r0 = nx_i0 << nx_i1 (O(1) hardware shift decomposition)
# ------------------------------------------------------------------------------
fn nx_shl {
    let nx_r0 = nx_i0
    let s1 = nx_i1
    if s1 >= 32 {
        let nx_r0 = nx_r0 * 1073741824
        let nx_r0 = nx_r0 * 4
        let s1 = s1 - 32
    }
    if s1 >= 16 {
        let nx_r0 = nx_r0 * 65536
        let s1 = s1 - 16
    }
    if s1 >= 8 {
        let nx_r0 = nx_r0 * 256
        let s1 = s1 - 8
    }
    if s1 >= 4 {
        let nx_r0 = nx_r0 * 16
        let s1 = s1 - 4
    }
    if s1 >= 2 {
        let nx_r0 = nx_r0 * 4
        let s1 = s1 - 2
    }
    if s1 >= 1 {
        let nx_r0 = nx_r0 * 2
        let s1 = s1 - 1
    }
    while s1 > 0 {
        let nx_r0 = nx_r0 * 2
        let s1 = s1 - 1
    }
}

# ------------------------------------------------------------------------------
# fn nx_shr : nx_r0 = nx_i0 >> nx_i1 (O(1) sign-preserving right shift)
# ------------------------------------------------------------------------------
fn nx_shr {
    let s0 = nx_i0
    let s1 = nx_i1
    let s4 = s0
    if s0 < 0 {
        let s4 = 0 - s0
    }
    if s1 >= 32 {
        let s4 = s4 / 1073741824
        let s4 = s4 / 4
        let s1 = s1 - 32
    }
    if s1 >= 16 {
        let s4 = s4 / 65536
        let s1 = s1 - 16
    }
    if s1 >= 8 {
        let s4 = s4 / 256
        let s1 = s1 - 8
    }
    if s1 >= 4 {
        let s4 = s4 / 16
        let s1 = s1 - 4
    }
    if s1 >= 2 {
        let s4 = s4 / 4
        let s1 = s1 - 2
    }
    if s1 >= 1 {
        let s4 = s4 / 2
        let s1 = s1 - 1
    }
    while s1 > 0 {
        let s4 = s4 / 2
        let s1 = s1 - 1
    }
    let nx_r0 = s4
    if s0 < 0 {
        let nx_r0 = 0 - s4
    }
}

# ------------------------------------------------------------------------------
# fn nx_bit_set : nx_r0 = 1 if bit nx_i1 of nx_i0 is set, 0 otherwise (O(1))
# ------------------------------------------------------------------------------
fn nx_bit_set {
    let s0 = nx_i0
    let s1 = nx_i1
    if s1 >= 32 {
        let s0 = s0 / 1073741824
        let s0 = s0 / 4
        let s1 = s1 - 32
    }
    if s1 >= 16 {
        let s0 = s0 / 65536
        let s1 = s1 - 16
    }
    if s1 >= 8 {
        let s0 = s0 / 256
        let s1 = s1 - 8
    }
    if s1 >= 4 {
        let s0 = s0 / 16
        let s1 = s1 - 4
    }
    if s1 >= 2 {
        let s0 = s0 / 4
        let s1 = s1 - 2
    }
    if s1 >= 1 {
        let s0 = s0 / 2
        let s1 = s1 - 1
    }
    while s1 > 0 {
        let s0 = s0 / 2
        let s1 = s1 - 1
    }
    let nx_r0 = s0 % 2
}
