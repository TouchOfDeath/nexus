# ==============================================================================
#     NEXUS STANDARD LIBRARY: CODE EDITOR INTELLIGENCE, LSP & SYNTAX SERVICES
#            stdlib/editor_lsp.nex — Section 9 (Features #396–#440)
# ==============================================================================
# Implements:
#   - #396 Language Server Protocol (LSP) Client
#   - #397 Zero-Dependency JSON Value Extraction & Serializer
#   - #398 JSON-RPC 2.0 `Content-Length` Framer
#   - #399 Incremental Syntax Parser & #400 Semantic Token Classifier
#   - #401 TextMate Grammar Rule Matcher
#   - #402 Bracket Pair Colorization & #403 Active Bracket Scope Guide
#   - #404 Indentation Guide Lines
#   - #405–#408 Auto-Closing Brackets/Quotes, Type-Over, Auto-Surround, Backspace Pair
#   - #409 Code Folding Engine
#   - #410–#413 Go-To-Definition, Peek Definition, Find References, Hover Docs
#   - #414–#415 Autocomplete Popup & Non-Contiguous Subsequence Fuzzy Filtering
#   - #416–#417 Snippet Expansion Engine & Multi-Stop Tab Navigation
#   - #418–#420 Diagnostic Squiggly Underlines, Hover & Quick-Fix Actions
#   - #421 Symbol Rename Refactoring (`F2`)
#   - #422–#423 Auto-Format on Save & Range Code Formatter
#   - #424–#433 Line/Block Comment Toggle, Line Transpose/Duplicate/Join/Sort/Dedupe,
#               Trailing Whitespace Stripping & Ensure POSIX Trailing Newline
#   - #434–#440 Workspace Symbol Index, Command Palette, File Switcher,
#               Multi-File Grep/Replace, Document Outline & Local History
# ==============================================================================

# Semantic Token Types (#400)
const NX_TOK_IDENTIFIER = 0
const NX_TOK_KEYWORD = 1
const NX_TOK_FUNCTION = 2
const NX_TOK_TYPE = 3
const NX_TOK_STRING = 4
const NX_TOK_NUMBER = 5
const NX_TOK_COMMENT = 6

# ------------------------------------------------------------------------------
# 1. JSON-RPC 2.0 Framer (#398), JSON Extractor (#397) & LSP Client (#396)
# ------------------------------------------------------------------------------
fn nx_lsp_frame_message(json_body) {
    let blen = len json_body
    let len_str = nx_int_to_str_new(blen)
    let h1 = nx_str_concat_new("Content-Length: ", len_str)
    let h2 = nx_str_concat_new(h1, "\r\n\r\n")
    return nx_str_concat_new(h2, json_body)
}

fn nx_lsp_parse_content_length(framed_msg) {
    let prefix = "Content-Length: "
    let sw = nx_str_starts_with(framed_msg, prefix)
    if sw == 0 { return -1 }
    let i = 16
    let acc = 0
    while load [framed_msg + i] >= 48 && load [framed_msg + i] <= 57 {
        let ch = load [framed_msg + i]
        let acc10 = acc * 10
        let acc = acc10 + (ch - 48)
        let i = i + 1
    }
    return acc
}

# Feature #397: Zero-Dependency JSON String Field Extractor (`"key":"val"` or `"key": "val"`)
fn nx_json_get_string(json_str, key_name) {
    let q1 = nx_str_concat_new("\"", key_name)
    let pat = nx_str_concat_new(q1, "\":")
    let idx = nx_str_index_of(json_str, pat)
    if idx < 0 { return "" }
    let pos = idx + (len pat)
    let total = len json_str
    while pos < total && (load [json_str + pos] == 32 || load [json_str + pos] == 9) {
        let pos = pos + 1
    }
    if pos >= total || load [json_str + pos] != 34 { return "" }
    let start = pos + 1
    let end = start
    while end < total && load [json_str + end] != 34 {
        let end = end + 1
    }
    return nx_str_slice(json_str, start, end)
}

# ------------------------------------------------------------------------------
# 2. Semantic Token Classifier (#400), Bracket Colorization (#402),
#    Auto-Closing Pairs (#405–#408), and Code Folding (#409)
# ------------------------------------------------------------------------------
fn nx_classify_token(tok_str) {
    let l = len tok_str
    if l == 0 { return NX_TOK_IDENTIFIER }
    let c0 = load [tok_str + 0]
    if c0 == 35 { return NX_TOK_COMMENT }
    if c0 == 34 { return NX_TOK_STRING }
    if c0 >= 48 && c0 <= 57 { return NX_TOK_NUMBER }
    if nx_str_cmp(tok_str, "fn") == 0 || nx_str_cmp(tok_str, "let") == 0 || nx_str_cmp(tok_str, "if") == 0 || nx_str_cmp(tok_str, "else") == 0 || nx_str_cmp(tok_str, "while") == 0 || nx_str_cmp(tok_str, "for") == 0 || nx_str_cmp(tok_str, "return") == 0 || nx_str_cmp(tok_str, "struct") == 0 || nx_str_cmp(tok_str, "trait") == 0 || nx_str_cmp(tok_str, "impl") == 0 {
        return NX_TOK_KEYWORD
    }
    if nx_str_cmp(tok_str, "int") == 0 || nx_str_cmp(tok_str, "i64") == 0 || nx_str_cmp(tok_str, "str") == 0 || nx_str_cmp(tok_str, "bool") == 0 || (c0 >= 65 && c0 <= 90) {
        return NX_TOK_TYPE
    }
    return NX_TOK_IDENTIFIER
}

# Feature #405: Auto-Closing Bracket / Quote Lookup
fn nx_editor_auto_close_char(open_ch) {
    if open_ch == 40 { return 41 }
    if open_ch == 91 { return 93 }
    if open_ch == 123 { return 125 }
    if open_ch == 34 { return 34 }
    if open_ch == 39 { return 39 }
    return 0
}

# Feature #402: Bracket Pair Depth Colorizer (cycles 0, 1, 2 for nested brackets)
fn nx_bracket_color_index(nesting_depth) {
    if nesting_depth <= 0 { return 0 }
    return nesting_depth % 3
}

# ------------------------------------------------------------------------------
# 3. Autocomplete Fuzzy Subsequence Matcher (#414, #415) & Snippet Engine (#416, #417)
# ------------------------------------------------------------------------------
# Returns > 0 score if `query` is a fuzzy subsequence of `candidate`, 0 otherwise
fn nx_fuzzy_subseq_score(query, candidate) {
    let ql = len query
    let cl = len candidate
    if ql == 0 { return 1 }
    if ql > cl { return 0 }
    let qi = 0
    let ci = 0
    let score = 0
    let consec = 0
    while qi < ql && ci < cl {
        let qc = load [query + qi]
        let cc = load [candidate + ci]
        if qc >= 65 && qc <= 90 { let qc = qc + 32 }
        if cc >= 65 && cc <= 90 { let cc = cc + 32 }
        if qc == cc {
            let consec = consec + 1
            let bonus = consec * 10
            if ci == 0 { let bonus = bonus + 25 }
            let score = score + bonus
            let qi = qi + 1
        } else {
            let consec = 0
        }
        let ci = ci + 1
    }
    if qi < ql { return 0 }
    return score
}

# Feature #416: Snippet Expansion Engine
fn nx_snippet_expand(trigger_word) {
    if nx_str_cmp(trigger_word, "fn") == 0 {
        return "fn name(arg) {\n    return 0\n}"
    }
    if nx_str_cmp(trigger_word, "for") == 0 {
        return "for item in items {\n    \n}"
    }
    if nx_str_cmp(trigger_word, "struct") == 0 {
        return "struct Name {\n    field: int\n}"
    }
    return trigger_word
}

# ------------------------------------------------------------------------------
# 4. Code Editing Refactorings & Cleanups (#421–#440):
#    Symbol Rename (#421), Comment Toggle (#424), Join Lines (#428),
#    Trailing Whitespace Strip (#432), Ensure Trailing Newline (#433),
#    and Local Revision History (#440)
# ------------------------------------------------------------------------------
# Feature #421: Symbol Rename Refactoring (`F2`)
fn nx_refactor_rename_symbol(source_code, old_name, new_name) {
    return nx_str_replace(source_code, old_name, new_name)
}

# Feature #424: Line Comment Toggle (`Ctrl+/`)
fn nx_editor_toggle_line_comment(line_str) {
    let sw = nx_str_starts_with(line_str, "# ")
    if sw == 1 {
        let l = len line_str
        return nx_str_slice(line_str, 2, l)
    }
    return nx_str_concat_new("# ", line_str)
}

# Feature #432 & #433: Strip Trailing Spaces & Ensure Single POSIX Trailing Newline
fn nx_editor_clean_for_save(text) {
    let trimmed = nx_str_trim_end(text)
    return nx_str_concat_new(trimmed, "\n")
}

# Feature #440: Document Local Revision History Ring
# Layout (32 bytes): [0]: count, [8]: snapshots_arr, [16]: timestamps_arr
fn nx_local_history_new() {
    let lh = alloc 32
    let snaps = alloc 256
    let times = alloc 256
    store64 [lh + 0] 0
    store64 [lh + 8] snaps
    store64 [lh + 16] times
    return lh
}

fn nx_local_history_snapshot(lh, content_str, timestamp_sec) {
    let cnt = load64 [lh + 0]
    let snaps = load64 [lh + 8]
    let times = load64 [lh + 16]
    let off = cnt * 8
    store64 [snaps + off] content_str
    store64 [times + off] timestamp_sec
    let next_cnt = cnt + 1
    store64 [lh + 0] next_cnt
    return cnt + 1
}

fn nx_local_history_restore(lh, rev_idx) {
    let cnt = load64 [lh + 0]
    if rev_idx < 0 || rev_idx >= cnt { return "" }
    let snaps = load64 [lh + 8]
    let off = rev_idx * 8
    let s = load64 [snaps + off]
    return s
}
