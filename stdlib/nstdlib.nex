# ==============================================================================
#                     NEXUS STANDARD LIBRARY - MASTER INCLUDE
# ==============================================================================
# Include this single file to load the entire standard library:
#
#   include "stdlib/nstdlib.nex"
#
# Modules provided:
#   stdlib/math.nex    nx_max nx_min nx_clamp nx_sign nx_pow nx_isqrt
#                      nx_gcd nx_lcm nx_fib nx_is_prime nx_digits
#   stdlib/arrays.nex  nx_arr_fill nx_arr_iota nx_arr_sum nx_arr_max
#                      nx_arr_min nx_arr_index_of nx_arr_reverse nx_arr_count
#                      nx_arr_sort nx_arr_avg
#   stdlib/strings.nex nx_str_len nx_str_copy nx_str_cmp nx_str_concat
#                      nx_str_chr nx_str_starts_with nx_str_ends_with
#                      nx_str_trim nx_str_normalize_newlines
#                      nx_str_escape_literal nx_str_to_int nx_int_to_str
#                      nx_str_to_upper nx_str_to_lower nx_str_pad_left
#                      nx_str_pad_right nx_str_index_of nx_str_contains
#                      nx_str_replace nx_str_levenshtein
#   stdlib/qarrays.nex nx_qarr_fill nx_qarr_iota nx_qarr_sum nx_qarr_max
#                      nx_qarr_min nx_qarr_index_of nx_qarr_reverse
#                      nx_qarr_count nx_qarr_sort nx_qarr_avg
#   stdlib/assert.nex  nx_assert_passes nx_assert_fails nx_assert_summary
#                      (backs the assert_eq / assert_ne macros of nexprep)
#   stdlib/vec.nex     nx_vec_new nx_vec_push nx_vec_pop nx_vec_get nx_vec_set
#                      nx_vec_len nx_vec_cap nx_vec_clear
#   stdlib/hashmap.nex nx_hashmap_new nx_hashmap_put nx_hashmap_get
#                      nx_hashmap_contains nx_hashmap_len nx_hashmap_cap
#                      nx_hashmap_clear
#   stdlib/hashset.nex nx_hashset_new nx_hashset_add nx_hashset_add_str
#                      nx_hashset_contains nx_hashset_contains_str
#                      nx_hashset_remove nx_hashset_remove_str
#                      nx_hashset_len nx_hashset_cap nx_hashset_clear
#
# Additional standalone modules (include directly, not bundled here):
#   stdlib/gap_buffer.nex     Feature #69   (nx_gb_* text gap buffer)
#   stdlib/bloom_filter.nex   Feature #79   (nx_bloom_* probabilistic filter)
#   stdlib/pattern_search.nex Features #89 & #90 (nx_kmp_* / nx_bmh_* substring search)
#   stdlib/fenwick.nex        Feature #105  (nx_fenwick_* binary indexed tree)
#   stdlib/union_find.nex     Feature #107  (nx_uf_* disjoint set union)
#   stdlib/base64.nex         Feature #144  (nx_base64_* RFC 4648 encoder & decoder)
#   stdlib/memory.nex         Features #87 & #88  (nx_memmove nx_memcpy
#                             nx_memset nx_memzero)
#   stdlib/byte_buffer.nex    Feature #99   (nx_buf_* growable byte buffer)
#   stdlib/bit_stream.nex     Feature #100  (nx_bit_writer_* / nx_bit_reader*)
#   stdlib/priority_queue.nex Feature #76   (nx_pq_* binary heap)
#   stdlib/linked_list.nex    Feature #77   (nx_list_* doubly-linked list)
#   stdlib/trie.nex           Feature #80   (nx_trie_* prefix tree)
#   stdlib/lru_cache.nex      Feature #94   (nx_lru_* LRU cache)
#   stdlib/arena.nex          Feature #96   (nx_arena_* bump allocator)
#   stdlib/unicode.nex        Features #113-115 (nx_utf8_*)
#   stdlib/search.nex         Feature #93   (nx_bsearch_*)
#
# CALLING CONVENTION (all functions):
#   1. Set inputs in nx_i0, nx_i1, nx_i2 (per-function signature)
#   2. call <fn>
#   3. Read the result from nx_r0
#
# nx_i0..nx_i2, nx_r0 and nx_s0..nx_s7 are clobbered by every stdlib call.
# Do not name your own variables with the "nx_" prefix, and do not assume
# any nx_* variable keeps its value across a stdlib call.
# ==============================================================================

include "stdlib/math.nex"
include "stdlib/arrays.nex"
include "stdlib/strings.nex"
include "stdlib/qarrays.nex"
include "stdlib/bitwise.nex"
include "stdlib/vec.nex"
include "stdlib/hashmap.nex"
include "stdlib/hashset.nex"
include "stdlib/assert.nex"
