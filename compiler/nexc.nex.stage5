# ------------------------------------------------------------------------------
# 1. HELPER SUBROUTINES
# ------------------------------------------------------------------------------

# emit_b: writes byte 'b' into [t + p] and increments p
fn emit_b {
    store [t + p] b
    let p = p + 1
}

# emit_d: writes 32-bit integer 'v' into [t + p] as 4 little-endian bytes
fn emit_d {
    if v < 0 {
        let v = v + 2000000000
        let v = v + 2000000000
        let v = v + 294967296
    }
    let b = v % 256
    call emit_b
    let v = v / 256
    let b = v % 256
    call emit_b
    let v = v / 256
    let b = v % 256
    call emit_b
    let v = v / 256
    let b = v % 256
    call emit_b
}

# patch_t: patches 32-bit integer 'v' into [t + k] as 4 bytes
fn patch_t {
    if v < 0 {
        let v = v + 2000000000
        let v = v + 2000000000
        let v = v + 294967296
    }
    let b = v % 256
    store [t + k] b
    let v = v / 256
    let b = v % 256
    let k = k + 1
    store [t + k] b
    let v = v / 256
    let b = v % 256
    let k = k + 1
    store [t + k] b
    let v = v / 256
    let b = v % 256
    let k = k + 1
    store [t + k] b
}

# save_m: saves 32-bit integer 'v' into [m + k] as 4 bytes
fn save_m {
    let b = v % 256
    store [m + k] b
    let v = v / 256
    let b = v % 256
    let k = k + 1
    store [m + k] b
    let v = v / 256
    let b = v % 256
    let k = k + 1
    store [m + k] b
    let v = v / 256
    let b = v % 256
    let k = k + 1
    store [m + k] b
}

# load_m: loads 32-bit integer from [m + k] into 'v'
fn load_m {
    let b = load [m + k]
    let v = b
    let k = k + 1
    let b = load [m + k]
    let v = b * 256 + v
    let k = k + 1
    let b = load [m + k]
    let v = b * 65536 + v
    let k = k + 1
    let b = load [m + k]
    let v = b * 16777216 + v
}

# skip_ws: skips whitespace, newlines, and comments at [s + i]
fn skip_ws {
    let y = 1
    while y == 1 {
        if i >= l {
            let y = 0
        } else {
            let c = load [s + i]
            let w = 0
            if c == 32 {
                let w = 1
            }
            if c == 9 {
                let w = 1
            }
            if c == 13 {
                let w = 1
            }
            if c == 10 {
                let w = 1
            }
            if c == 35 {
                let w = 1
                let k = 1
                while k == 1 {
                    let i = i + 1
                    if i >= l {
                        let k = 0
                    } else {
                        let c = load [s + i]
                        if c == 10 {
                            let k = 0
                        }
                    }
                }
            }
            if w == 1 {
                let i = i + 1
            } else {
                let y = 0
            }
        }
    }
}

# skip_sp: skips only horizontal spaces and tabs at [s + i] (never newlines)
fn skip_sp {
    let y = 1
    while y == 1 {
        if i >= l {
            let y = 0
        } else {
            let c = load [s + i]
            if c == 32 {
                let i = i + 1
            } else {
                if c == 9 {
                    let i = i + 1
                } else {
                    let y = 0
                }
            }
        }
    }
}

# parse_uint: parses unsigned integer at [s + i] into 'u'
fn parse_uint {
    let u = 0
    let y = 1
    while y == 1 {
        if i >= l {
            let y = 0
        } else {
            let c = load [s + i]
            if c >= 48 {
                if c <= 57 {
                    let u = u * 10 + c - 48
                    let i = i + 1
                } else {
                    let y = 0
                }
            } else {
                let y = 0
            }
        }
    }
}

# parse_ident: parses alphanumeric identifier at [s + i] into hash 'h'
fn parse_ident {
    let h = 0
    let y = 1
    while y == 1 {
        if i >= l {
            let y = 0
        } else {
            let c = load [s + i]
            let w = 0
            if c >= 97 {
                if c <= 122 {
                    let w = 1
                }
            }
            if c >= 48 {
                if c <= 57 {
                    let w = 1
                }
            }
            if c == 95 {
                let w = 1
            }
            if w == 1 {
                let h = h * 33 + c
                let h = h % 2000000000
                let i = i + 1
            } else {
                let y = 0
            }
        }
    }
}

# parse_cond: parses condition <var> <relop> <op2> and emits inverted branch
fn parse_cond {
    call skip_ws
    let c = load [s + i]
    let a = c - 97 * 8 + 48
    let i = i + 1
    call skip_ws

    # mov rax, [rbp + a] (48 8B 85 <a32>)
    let b = 72
    call emit_b
    let b = 139
    call emit_b
    let b = 133
    call emit_b
    let v = a
    call emit_d

    # Relational operator: ==, !=, <, <=, >, >=
    let c = load [s + i]
    let o = 133
    if c == 61 {
        let o = 133
        let i = i + 2
    }
    if c == 33 {
        let o = 132
        let i = i + 2
    }
    if c == 60 {
        let k = i + 1
        let n = load [s + k]
        if n == 61 {
            let o = 143
            let i = i + 2
        } else {
            let o = 141
            let i = i + 1
        }
    }
    if c == 62 {
        let k = i + 1
        let n = load [s + k]
        if n == 61 {
            let o = 140
            let i = i + 2
        } else {
            let o = 142
            let i = i + 1
        }
    }

    call skip_ws
    let c = load [s + i]
    if c <= 57 {
        call parse_uint
        # cmp rax, imm32 (48 3D <u32>)
        let b = 72
        call emit_b
        let b = 61
        call emit_b
        let v = u
        call emit_d
    } else {
        let w = c - 97 * 8 + 48
        let i = i + 1
        # cmp rax, [rbp + w] (48 3B 85 <w32>)
        let b = 72
        call emit_b
        let b = 59
        call emit_b
        let b = 133
        call emit_b
        let v = w
        call emit_d
    }

    call skip_ws
    let c = load [s + i]
    if c == 123 {
        let i = i + 1
    }

    # Emit inverted jump: 0x0F, <o>, <00 00 00 00>
    let b = 15
    call emit_b
    let b = o
    call emit_b
    let j = p
    let v = 0
    call emit_d

    # Push to block stack at depth z
    let k = z * 16
    store [m + k] e
    let k = k + 4
    let v = h
    call save_m
    let k = z * 16 + 8
    let v = j
    call save_m
    let z = z + 1
}

