                                            call emit_b
                                            let b = 45
                                            call emit_b
                                            let v = u
                                            call emit_d
                                        }
                                        if o == 42 {
                                            # imul rax, rax, imm32 (48 69 C0 <u32>)
                                            let b = 72
                                            call emit_b
                                            let b = 105
                                            call emit_b
                                            let b = 192
                                            call emit_b
                                            let v = u
                                            call emit_d
                                        }
                                        if o == 47 {
                                            # mov rbx, imm32; cqo; idiv rbx
                                            let b = 72
                                            call emit_b
                                            let b = 199
                                            call emit_b
                                            let b = 195
                                            call emit_b
                                            let v = u
                                            call emit_d
                                            let b = 72
                                            call emit_b
                                            let b = 153
                                            call emit_b
                                            let b = 72
                                            call emit_b
                                            let b = 247
                                            call emit_b
                                            let b = 251
                                            call emit_b
                                        }
                                        if o == 37 {
                                            # mov rbx, imm32; cqo; idiv rbx; mov rax, rdx
                                            let b = 72
                                            call emit_b
                                            let b = 199
                                            call emit_b
                                            let b = 195
                                            call emit_b
                                            let v = u
                                            call emit_d
                                            let b = 72
                                            call emit_b
                                            let b = 153
                                            call emit_b
                                            let b = 72
                                            call emit_b
                                            let b = 247
                                            call emit_b
                                            let b = 251
                                            call emit_b
                                            let b = 72
                                            call emit_b
                                            let b = 137
                                            call emit_b
                                            let b = 208
                                            call emit_b
                                        }
                                    } else {
                                        # Op2 is variable
                                        let w = c - 97 * 8 + 48
                                        let i = i + 1

                                        if o == 43 {
                                            # add rax, [rbp + w] (48 03 85 <w32>)
                                            let b = 72
                                            call emit_b
                                            let b = 3
                                            call emit_b
                                            let b = 133
                                            call emit_b
                                            let v = w
                                            call emit_d
                                        }
                                        if o == 45 {
                                            # sub rax, [rbp + w] (48 2B 85 <w32>)
                                            let b = 72
                                            call emit_b
                                            let b = 43
                                            call emit_b
                                            let b = 133
                                            call emit_b
                                            let v = w
                                            call emit_d
                                        }
                                        if o == 42 {
                                            # imul rax, [rbp + w] (48 0F AF 85 <w32>)
                                            let b = 72
                                            call emit_b
                                            let b = 15
                                            call emit_b
                                            let b = 175
                                            call emit_b
                                            let b = 133
                                            call emit_b
                                            let v = w
                                            call emit_d
                                        }
                                        if o == 47 {
                                            # cqo; mov rbx, [rbp + w]; idiv rbx
                                            let b = 72
                                            call emit_b
                                            let b = 153
                                            call emit_b
                                            let b = 72
                                            call emit_b
                                            let b = 139
                                            call emit_b
                                            let b = 157
                                            call emit_b
                                            let v = w
                                            call emit_d
                                            let b = 72
                                            call emit_b
                                            let b = 247
                                            call emit_b
                                            let b = 251
                                            call emit_b
                                        }
                                        if o == 37 {
                                            # cqo; mov rbx, [rbp + w]; idiv rbx; mov rax, rdx
                                            let b = 72
                                            call emit_b
                                            let b = 153
                                            call emit_b
                                            let b = 72
                                            call emit_b
                                            let b = 139
                                            call emit_b
                                            let b = 157
                                            call emit_b
                                            let v = w
                                            call emit_d
                                            let b = 72
                                            call emit_b
                                            let b = 247
                                            call emit_b
                                            let b = 251
                                            call emit_b
                                            let b = 72
                                            call emit_b
                                            let b = 137
                                            call emit_b
                                            let b = 208
                                            call emit_b
                                        }
                                    }
                                }
                            }
                        }

                        # 3. Store result from rax into [rbp + d] (48 89 85 <d32>)
                        let b = 72
                        call emit_b
                        let b = 137
                        call emit_b
                        let b = 133
                        call emit_b
                        let v = d
                        call emit_d
                    }
                }
            }
        }

        # ----------------------------------------------------------------------
        # PARSE 'store [<ptr> + <idx>] <val>'
        # ----------------------------------------------------------------------
        if c == 115 {
            let k = i + 1
            let n = load [s + k]
            if n == 116 {
                let k = i + 2
                let n = load [s + k]
                if n == 111 {
                    let k = i + 3
                    let n = load [s + k]
                    if n == 114 {
                        let k = i + 4
                        let n = load [s + k]
                        if n == 101 {
                            let i = i + 5
                            call skip_ws
                            let c = load [s + i]
                            if c == 91 {
                                let i = i + 1
                            }
                            call skip_ws
                            let c = load [s + i]
                            let a = c - 97 * 8 + 48
                            let i = i + 1
                            call skip_ws

                            # mov r8, [rbp + a] (4C 8B 85 <a32>)
                            let b = 76
                            call emit_b
                            let b = 139
                            call emit_b
                            let b = 133
                            call emit_b
                            let v = a
                            call emit_d

                            let c = load [s + i]
                            if c == 43 {
                                let i = i + 1
                                call skip_ws
                                let c = load [s + i]
                                if c <= 57 {
                                    call parse_uint
                                    # add r8, imm32 (49 81 C0 <u32>)
                                    let b = 73
                                    call emit_b
                                    let b = 129
                                    call emit_b
                                    let b = 192
                                    call emit_b
                                    let v = u
                                    call emit_d
                                } else {
                                    let w = c - 97 * 8 + 48
                                    let i = i + 1
                                    # mov r9, [rbp + w] (4C 8B 8D <w32>)
                                    let b = 76
                                    call emit_b
                                    let b = 139
                                    call emit_b
                                    let b = 141
                                    call emit_b
                                    let v = w
                                    call emit_d
                                    # add r8, r9 (4D 01 C8)
                                    let b = 77
                                    call emit_b
                                    let b = 1
                                    call emit_b
                                    let b = 200
                                    call emit_b
                                }
                                call skip_ws
                            }
                            let c = load [s + i]
                            if c == 93 {
                                let i = i + 1
                            }
                            call skip_ws

                            let c = load [s + i]
                            if c <= 57 {
                                call parse_uint
                                # mov al, imm8 (B0 <u8>)
                                let b = 176
                                call emit_b
                                let b = u % 256
                                call emit_b
                            } else {
                                let w = c - 97 * 8 + 48
                                let i = i + 1
                                # mov al, [rbp + w] (8A 85 <w32>)
                                let b = 138
                                call emit_b
                                let b = 133
                                call emit_b
                                let v = w
                                call emit_d
                            }

                            # mov [r8], al (41 88 00)
                            let b = 65
                            call emit_b
                            let b = 136
                            call emit_b
                            let b = 0
                            call emit_b
                        }
                    }
                }
            }
        }

        # ----------------------------------------------------------------------
        # PARSE 'print ...'
        # ----------------------------------------------------------------------
        if c == 112 {
            let k = i + 1
            let n = load [s + k]
            if n == 114 {
                let k = i + 2
                let n = load [s + k]
                if n == 105 {
                    let k = i + 3
                    let n = load [s + k]
                    if n == 110 {
                        let k = i + 4
                        let n = load [s + k]
                        if n == 116 {
                            let i = i + 5
                            call skip_ws
                            let c = load [s + i]

                            # 1. Print String Literal: starts with '"' (34)
                            if c == 34 {
                                let i = i + 1
                                let x = q
                                let y = 1
                                while y == 1 {
                                    let c = load [s + i]
                                    let i = i + 1
                                    if c == 34 {
                                        let y = 0
                                    } else {
                                        store [t + q] c
                                        let q = q + 1
                                    }
                                }
                                # Append CRLF and null terminator: 13, 10, 0
                                store [t + q] 13
                                let q = q + 1
                                store [t + q] 10
                                let q = q + 1
                                store [t + q] 0
                                let q = q + 1
                                let n = q - x - 1

                                # mov rcx, r12 (4C 89 E1)
                                let b = 76
                                call emit_b
                                let b = 137
                                call emit_b
                                let b = 225
                                call emit_b

                                # lea rdx, [rip + disp32] (48 8D 15 <disp32>)
                                # disp32 = x - p + 508
                                let b = 72
                                call emit_b
                                let b = 141
                                call emit_b
                                let b = 21
                                call emit_b
                                let v = x - p + 508
                                call emit_d

                                # mov r8d, len (41 B8 <len32>)
                                let b = 65
                                call emit_b
                                let b = 184
                                call emit_b
                                let v = n
                                call emit_d

                                # lea r9, [rsp + 0x28] (4C 8D 4C 24 28)
                                let b = 76
                                call emit_b
                                let b = 141
                                call emit_b
                                let b = 76
                                call emit_b
                                let b = 36
                                call emit_b
                                let b = 40
                                call emit_b

                                # mov qword ptr [rsp + 0x20], 0
                                let b = 72
                                call emit_b
                                let b = 199
                                call emit_b
                                let b = 68
                                call emit_b
                                let b = 36
                                call emit_b
                                let b = 32
                                call emit_b
                                let v = 0
                                call emit_d

                                # call WriteFile (FF 15 <disp32>) -> disp = 29228 - p
                                let b = 255
                                call emit_b
                                let b = 21
                                call emit_b
                                let v = 29228 - p
                                call emit_d
                            } else {
                                # 2. Print integer (uint or variable)
                                if c <= 57 {
                                    call parse_uint
                                    # mov rcx, imm32 (48 C7 C1 <u32>)
                                    let b = 72
                                    call emit_b
                                    let b = 199
                                    call emit_b
                                    let b = 193
                                    call emit_b
                                    let v = u
                                    call emit_d
                                } else {
                                    let a = c - 97 * 8 + 48
                                    let i = i + 1
                                    # mov rcx, [rbp + slot] (48 8B 8D <slot32>)
                                    let b = 72
                                    call emit_b
                                    let b = 139
                                    call emit_b
                                    let b = 141
                                    call emit_b
                                    let v = a
                                    call emit_d
                                }

                                # call print_int (E8 <disp32>) -> disp = 28284 - p
                                let b = 232
                                call emit_b
                                let v = 28284 - p
                                call emit_d
                            }
                        }
                    }
                }
            }
        }

        # ----------------------------------------------------------------------
        # PARSE 'while <cond> {'
        # ----------------------------------------------------------------------
        if c == 119 {
            let k = i + 1
            let n = load [s + k]
            if n == 104 {
                let k = i + 2
                let n = load [s + k]
                if n == 105 {
                    let k = i + 3
                    let n = load [s + k]
                    if n == 108 {
                        let k = i + 4
                        let n = load [s + k]
                        if n == 101 {
                            let i = i + 5
                            let h = p
                            let e = 3
                            call parse_cond
                        }
                    }
                }
            }
        }

        # ----------------------------------------------------------------------
        # PARSE 'if <cond> {'
        # ----------------------------------------------------------------------
        if c == 105 {
            let k = i + 1
            let n = load [s + k]
            if n == 102 {
                let i = i + 2
                let h = 0
                let e = 1
                call parse_cond
            }
        }

        # ----------------------------------------------------------------------
        # PARSE '}' OR '} else {'
        # ----------------------------------------------------------------------
        if c == 125 {
            let i = i + 1
            let k = 1
            while k == 1 {
                if i >= l {
                    let k = 0
                } else {
                    let c = load [s + i]
                    if c == 32 {
                        let i = i + 1
                    } else {
                        if c == 9 {
                            let i = i + 1
                        } else {
                            let k = 0
                        }
                    }
                }
            }
            let c = load [s + i]
            let y = 0
            if c == 101 {
                let k = i + 1
                let n = load [s + k]
                if n == 108 {
                    let k = i + 2
                    let n = load [s + k]
                    if n == 115 {
                        let k = i + 3
                        let n = load [s + k]
                        if n == 101 {
                            let y = 1
                        }
                    }
                }
            }

            if y == 1 {
                # --- CASE: '} else {' ---
                let i = i + 4
                call skip_ws
                let c = load [s + i]
                if c == 123 {
                    let i = i + 1
                }

                # Pop IF frame
                let z = z - 1
                let k = z * 16 + 8
                call load_m
                let j = v

                # Emit unconditional jump over else block: E9 <disp32>
                let b = 233
                call emit_b
                let g = p
                let v = 0
                call emit_d

                # Back-patch IF exit jump
                let k = j
                let v = p - j - 4
                call patch_t

                # Push ELSE frame (type = 2)
                let k = z * 16
                store [m + k] 2
                let k = k + 8
                let v = g
                call save_m
                let z = z + 1
            } else {
                # --- CASE: '}' (END OF BLOCK) ---
                let z = z - 1
                let k = z * 16
                let e = load [m + k]
                let k = k + 4
                call load_m
                let h = v
                let k = z * 16 + 8
                call load_m
                let j = v

                if e == 1 {
                    # IF done: back-patch exit jump
                    let k = j
                    let v = p - j - 4
                    call patch_t
                }
                if e == 2 {
                    # ELSE done: back-patch else jump
                    let k = j
                    let v = p - j - 4
                    call patch_t
                }
                if e == 3 {
                    # WHILE done: emit backward jump to head (h)
                    let b = 233
                    call emit_b
                    let v = h - p - 4
                    call emit_d
                    # Back-patch while exit jump
                    let k = j
                    let v = p - j - 4
                    call patch_t
                }
                if e == 4 {
                    # FUNCTION done: emit ret (C3)
                    let b = 195
                    call emit_b
                    # Back-patch jump over function
                    let k = j
                    let v = p - j - 4
                    call patch_t
                }
            }
        }

        # ----------------------------------------------------------------------
        # PARSE 'fn <name> {' OR 'file_write ...' OR 'file_close ...'
        # ----------------------------------------------------------------------
        if c == 102 {
            let k = i + 1
            let n = load [s + k]
            if n == 110 {
                # --- CASE: 'fn <name> {' ---
                let i = i + 2
                call skip_ws
                call parse_ident

                # Skip whitespace to '{'
                call skip_ws
                let c = load [s + i]
                if c == 123 {
                    let i = i + 1
                }

                # Emit jmp over function: E9 <disp32>
                let b = 233
                call emit_b
                let g = p
                let v = 0
                call emit_d

                # Function entry point
                let a = p

                # Save into function table at m + 2048 + (fn_count * 16)
                let k = 2040
                call load_m
                let n = v
                let x = n * 16 + 2048
                let k = x
                let v = h
                call save_m
                let k = x + 8
                let v = a
                call save_m
                let n = n + 1
                let k = 2040
                let v = n
                call save_m

                # Push FUNCTION frame to block stack (type = 4)
                let k = z * 16
                store [m + k] 4
                let k = k + 8
                let v = g
                call save_m
                let z = z + 1
            }
            if n == 105 {
                let k = i + 5
                let n = load [s + k]
                if n == 119 {
                    # --- CASE: 'file_write <fd> <buf> <len>' ---
                    let i = i + 10
                    call skip_ws
                    let c = load [s + i]
                    let a = c - 97 * 8 + 48
                    let i = i + 1
                    call skip_ws
                    let c = load [s + i]
                    let o = c - 97 * 8 + 48
                    let i = i + 1
                    call skip_ws
                    let c = load [s + i]

                    # mov rcx, [rbp + a] (48 8B 8D <a32>)
                    let b = 72
                    call emit_b
                    let b = 139
                    call emit_b
                    let b = 141
                    call emit_b
                    let v = a
                    call emit_d

                    # mov rdx, [rbp + o] (48 8B 95 <o32>)
                    let b = 72
                    call emit_b
                    let b = 139
                    call emit_b
                    let b = 149
                    call emit_b
                    let v = o
                    call emit_d

                    # r8d: len
                    if c <= 57 {
                        call parse_uint
                        # mov r8d, u (41 B8 <u32>)
                        let b = 65
                        call emit_b
                        let b = 184
                        call emit_b
                        let v = u
                        call emit_d
                    } else {
                        let n = c - 97 * 8 + 48
                        let i = i + 1
                        # mov r8d, [rbp + n] (44 8B 85 <n32>)
                        let b = 68
                        call emit_b
                        let b = 139
                        call emit_b
                        let b = 133
                        call emit_b
                        let v = n
                        call emit_d
                    }

                    # lea r9, [rsp + 0x28] (4C 8D 4C 24 28)
                    let b = 76
                    call emit_b
                    let b = 141
                    call emit_b
                    let b = 76
                    call emit_b
                    let b = 36
                    call emit_b
                    let b = 40
                    call emit_b

                    # mov qword ptr [rsp + 0x20], 0
                    let b = 72
                    call emit_b
                    let b = 199
                    call emit_b
                    let b = 68
                    call emit_b
                    let b = 36
                    call emit_b
                    let b = 32
                    call emit_b
                    let v = 0
                    call emit_d

                    # call WriteFile (FF 15 <29228 - p>)
                    let b = 255
                    call emit_b
                    let b = 21
                    call emit_b
                    let v = 29228 - p
                    call emit_d
                }
                if n == 99 {
                    # --- CASE: 'file_close <fd>' ---
                    let i = i + 10
                    call skip_ws
                    let c = load [s + i]
                    let a = c - 97 * 8 + 48
                    let i = i + 1

                    # mov rcx, [rbp + a] (48 8B 8D <a32>)
                    let b = 72
                    call emit_b
                    let b = 139
                    call emit_b
                    let b = 141
                    call emit_b
                    let v = a
                    call emit_d

                    # call CloseHandle (FF 15 <29268 - p>)
                    let b = 255
                    call emit_b
                    let b = 21
                    call emit_b
                    let v = 29268 - p
                    call emit_d
                }
            }
        }

        # ----------------------------------------------------------------------
        # PARSE 'call <name>'
        # ----------------------------------------------------------------------
        if c == 99 {
            let k = i + 1
            let n = load [s + k]
            if n == 97 {
                let k = i + 2
                let n = load [s + k]
                if n == 108 {
                    let i = i + 4
                    call skip_ws
                    call parse_ident

                    # Look up hash 'h' in function table
                    let k = 2040
                    call load_m
                    let n = v
                    let u = 0
                    let j = 0
                    while j < n {
                        let x = j * 16 + 2048
                        let k = x
                        call load_m
                        if v == h {
                            let k = x + 8
                            call load_m
                            let u = v
                        }
                        let j = j + 1
                    }

                    # Emit call <disp32>: E8 <disp32>
                    let b = 232
                    call emit_b
                    let v = u - p - 4
                    call emit_d
                }
            }
        }

        # Advance past any leftover characters on line
        let k = 1
        while k == 1 {
            if i >= l {
                let k = 0
            } else {
                let c = load [s + i]
                let i = i + 1
                if c == 10 {
                    let k = 0
                }
            }
        }
    }
}

# ------------------------------------------------------------------------------
# 4. EMIT EPILOGUE & WRITE app.exe
# ------------------------------------------------------------------------------

# xor ecx, ecx (31 C9)
let b = 49
call emit_b
let b = 201
call emit_b

# call ExitProcess (FF 15 <disp32>) -> disp = 29236 - p
let b = 255
call emit_b
let b = 21
call emit_b
let v = 29236 - p
call emit_d

# Write 32,768 bytes from t to "app.exe"
let f = file_create "app.exe"
file_write f t 32768
file_close f

print "[+] Compilation Succeeded! Standalone app.exe generated."
print "=================================================="
