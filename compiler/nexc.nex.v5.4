# parse_cond_core: parses <var> <relop> <op2> and emits the compare.
# Outputs: o = inverted-branch opcode. Does not emit the jump itself.
# Shared by while/if/else-if headers and the for-loop condition segment.
# NOTE: uses the saved slot 'a' (not w) for the load, because skip_ws
#       clobbers w between resolve_var and the mov emission.
fn parse_cond_core {
    call skip_ws
    call parse_ident
    call resolve_var
    let a = w
    call skip_ws

    # mov rax, [rbp + a] (48 8B 85 <a32>)
    let b = 72
    call emit_b
    let b = 139
    call emit_b
    let b = 133
    call emit_b
    let v = a
    call emit_d

    # Relational operator: ==, !=, <, <=, >, >=
    let c = load [s + i]
    let o = 0
    if c == 61 {
        let k = i + 1
        let n = load [s + k]
        if n == 61 {
            let o = 133
            let i = i + 2
        }
    }
    if c == 33 {
        let k = i + 1
        let n = load [s + k]
        if n == 61 {
            let o = 132
            let i = i + 2
        }
    }
    if c == 60 {
        let k = i + 1
        let n = load [s + k]
        if n == 61 {
            let o = 143
            let i = i + 2
        } else {
            let o = 141
            let i = i + 1
        }
    }
    if c == 62 {
        let k = i + 1
        let n = load [s + k]
        if n == 61 {
            let o = 140
            let i = i + 2
        } else {
            let o = 142
            let i = i + 1
        }
    }
    if o == 0 {
        let w = 6
        call report_err
        call fail_compile
        return
    }

    call skip_ws
    let c = load [s + i]
    let n = 0
    if c == 45 {
        let n = 1
        let i = i + 1
        let c = load [s + i]
    }
    if c <= 57 {
        call parse_uint
        if n == 1 {
            let u = 0 - u
        }
        # cmp rax, imm32 (48 3D <u32>)
        let b = 72
        call emit_b
        let b = 61
        call emit_b
        let v = u
        call emit_d
    } else {
        call parse_ident
        call resolve_var
        # cmp rax, [rbp + w] (48 3B 85 <w32>)
        let b = 72
        call emit_b
        let b = 59
        call emit_b
        let b = 133
        call emit_b
        let v = w
        call emit_d
    }
}

# parse_cond: full condition for while/if/else-if: core + '{' + frame push
fn parse_cond {
    # Save loop head h in m + 1036 before parse_ident clobbers h
    let k = 1036
    let v = h
    call save_m

    call parse_cond_core

    call skip_ws
    let c = load [s + i]
    if c != 123 {
        let w = 7
        call report_err
        call fail_compile
        return
    }
    let i = i + 1

    # Emit inverted jump: 0x0F, <o>, <00 00 00 00>
    let b = 15
    call emit_b
    let b = o
    call emit_b
    let j = p
    let v = 0
    call emit_d

    # Push to block stack at depth z
    let k = z * 16
    store [m + k] e
    let k = 1036
    call load_m
    let k = z * 16 + 4
    call save_m
    let k = z * 16 + 8
    let v = j
    call save_m
    let z = z + 1
}

# find_loop: scans the block stack from top for the innermost enclosing
#            loop frame (WHILE = 3 or FOR = 5). Function frames (4) are
#            barriers: break/continue never cross a function boundary.
# Outputs: loop_z = frame depth (or -1 when no loop encloses this point),
#          loop_t = frame type (3 or 5, or 0 when none found)
fn find_loop {
    let loop_z = 0 - 1
    let loop_t = 0
    let wz = z - 1
    while wz >= 0 {
        if loop_z >= 0 {
            let wz = 0 - 1
        } else {
            let k = wz * 16
            let bt = load [m + k]
            if bt == 3 {
                let loop_z = wz
                let loop_t = 3
            }
            if bt == 5 {
                let loop_z = wz
                let loop_t = 5
            }
            if bt == 4 {
                let wz = 0 - 1
            } else {
                if loop_z < 0 {
                    let wz = wz - 1
                }
            }
        }
    }
}

# chain_jump: emits 'E9 <disp32>' and links the disp32 position onto the
#             jump chain for frame loop_z. Inputs: chain_base = 50000 (break)
#             or 52000 (continue). Chain head lives at [m + loop_z * 4 + chain_base].
fn chain_jump {
    let b = 233
    call emit_b
    let gpos = p
    let v = 0
    call emit_d
    let head_a = loop_z * 4 + chain_base
    let k = head_a
    call load_m
    let old_v = v
    let k = gpos
    let v = old_v
    call patch_t
    let k = head_a
    let v = gpos
    call save_m
}

