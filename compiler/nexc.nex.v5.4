# calc_pos: calculates line number 'u' and column number 'a' for index 'i' in 's'
fn calc_pos {
    let u = 1
    let a = 1
    let j = 0
    while j < i {
        let c = load [s + j]
        if c == 10 {
            let u = u + 1
            let a = 1
        } else {
            let a = a + 1
        }
        let j = j + 1
    }
}

# report_err: formats and prints diagnostics with exact line and column
fn report_err {
    call calc_pos
    print "[!] NEXUS Compilation Error in code.nex:"
    print "[!] Line:"
    print u
    print "[!] Column:"
    print a
    if w == 1 {
        print "[!] Error: Unrecognized statement keyword or syntax"
    }
    if w == 2 {
        print "[!] Error: Expected '=' in let assignment"
    }
    if w == 3 {
        print "[!] Error: Undefined function name in call statement"
    }
    if w == 4 {
        print "[!] Error: Unclosed block (missing '}') at end of file"
    }
    if w == 5 {
        print "[!] Error: Unmatched '}' (no block was open)"
    }
    if w == 6 {
        print "[!] Error: Invalid relational operator in condition"
    }
    if w == 7 {
        print "[!] Error: Expected '{' after condition"
    }
    if w == 8 {
        print "[!] Error: 'break' outside of a loop"
    }
    if w == 9 {
        print "[!] Error: 'continue' outside of a loop"
    }
    if w == 10 {
        print "[!] Error: Expected ',' in for header"
    }
    if w == 11 {
        print "[!] Error: Expected variable name in read statement"
    }
}

