{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "NEXUS",
  "scopeName": "source.nexus",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#stdlib-fns"
    },
    {
      "include": "#struct-member"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.nexus",
          "match": "(#|;).*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.nexus",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.nexus",
              "match": "\\\\[nr\"\\\\]"
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow.nexus",
          "match": "\\b(if|else|while|return|call|break|continue|for)\\b"
        },
        {
          "name": "keyword.declaration.nexus",
          "match": "\\b(let|fn|struct)\\b"
        },
        {
          "name": "keyword.control.import.nexus",
          "match": "\\b(include|import)\\b"
        },
        {
          "name": "keyword.other.io.nexus",
          "match": "\\b(print|print_str|read)\\b"
        },
        {
          "name": "support.function.builtin.nexus",
          "match": "\\b(alloc|load|store|len|abs|file_open|file_create|file_read|file_write|file_close)\\b"
        }
      ]
    },
    "stdlib-fns": {
      "name": "support.function.stdlib.nexus",
      "match": "\\b(nx_max|nx_min|nx_clamp|nx_sign|nx_pow|nx_isqrt|nx_gcd|nx_lcm|nx_fib|nx_is_prime|nx_digits|nx_arr_fill|nx_arr_iota|nx_arr_sum|nx_arr_max|nx_arr_min|nx_arr_index_of|nx_arr_reverse|nx_arr_count|nx_str_len|nx_str_copy|nx_str_cmp|nx_str_concat|nx_str_chr|nx_str_to_int|nx_int_to_str)\\b"
    },
    "struct-member": {
      "name": "variable.other.member.nexus",
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\.(size|[A-Za-z_][A-Za-z0-9_]*)\\b",
      "captures": {
        "2": {
          "patterns": [
            {
              "name": "constant.other.size.nexus",
              "match": "size"
            }
          ]
        }
      }
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.numeric.integer.nexus",
          "match": "\\b(0|[1-9][0-9]*)\\b"
        }
      ]
    },
    "operators": {
      "name": "keyword.operator.nexus",
      "match": "(==|!=|<=|>=|\\+|-|\\*|/|%|=)"
    },
    "identifiers": {
      "name": "variable.other.nexus",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
    }
  }
}
