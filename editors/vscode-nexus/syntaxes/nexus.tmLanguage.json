{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "NEXUS",
  "scopeName": "source.nexus",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#keywords" },
    { "include": "#stdlib-fns" },
    { "include": "#struct-member" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.nexus",
          "match": "(#|;).*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.nexus",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.nexus",
              "match": "\\\\([nrt0e\"'\\\\]|x[0-9A-Fa-f]{2})"
            }
          ]
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "constant.character.literal.nexus",
          "match": "'(\\\\([nrt0e\"'\\\\]|x[0-9A-Fa-f]{2})|[^'\\\\])'"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow.nexus",
          "match": "\\b(if|if_f|else|while|while_f|for|in|step|match|return|call|break|continue|exit)\\b"
        },
        {
          "name": "keyword.declaration.nexus",
          "match": "\\b(let|local|var|int|float|const|fn|struct|enum|impl)\\b"
        },
        {
          "name": "keyword.control.import.nexus",
          "match": "\\b(include|import)\\b"
        },
        {
          "name": "keyword.other.io.nexus",
          "match": "\\b(print|print_str|print_float|print_raw|read)\\b"
        },
        {
          "name": "support.function.builtin.nexus",
          "match": "\\b(alloc|load|load8|load16|load32|load64|store|store8|store16|store32|store64|fload|fstore|len|abs|str|itof|ftoi|fadd|fsub|fmul|fdiv|fsqrt|fneg|file_open|file_create|file_read|file_write|file_close|os_argc|os_argv|syscall|syscall0|syscall1|syscall2|syscall3|syscall4|syscall5|syscall6|assert_eq|assert_ne|frame_pointer|stack_pointer|frame_parent)\\b"
        }
      ]
    },
    "stdlib-fns": {
      "name": "support.function.stdlib.nexus",
      "match": "\\b(nx_[A-Za-z0-9_]+|x11_[A-Za-z0-9_]+)\\b"
    },
    "struct-member": {
      "name": "variable.other.member.nexus",
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\.(size|[A-Za-z_][A-Za-z0-9_]*)\\b",
      "captures": {
        "2": {
          "patterns": [
            {
              "name": "constant.other.size.nexus",
              "match": "size"
            }
          ]
        }
      }
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.nexus",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.numeric.hex.nexus",
          "match": "\\b0[xX][0-9A-Fa-f_]+\\b"
        },
        {
          "name": "constant.numeric.octal.nexus",
          "match": "\\b0[oO][0-7_]+\\b"
        },
        {
          "name": "constant.numeric.binary.nexus",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.float.nexus",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.nexus",
          "match": "\\b(0|[1-9][0-9_]*)\\b"
        }
      ]
    },
    "operators": {
      "name": "keyword.operator.nexus",
      "match": "(\\*\\*=|<<=|>>=|\\+=\\.|\\-=\\.|\\*=\\.|/=\\.|==\\.|!=\\.|<=\\.|>=\\.|<\\.|>\\.|\\+\\.|\\-\\.|\\*\\.|/\\.|\\.\\.=|\\.\\.|\\?\\?|=>|\\+\\+|\\-\\-|&&|\\|\\||\\+=|\\-=|\\*=|/=|%=|&=|\\|=|\\^=|<<|>>|==|!=|<=|>=|\\*\\*|\\+|\\-|\\*|/|%|&|\\||\\^|~|!|\\?|:|=|<|>)"
    },
    "identifiers": {
      "name": "variable.other.nexus",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
    }
  }
}
